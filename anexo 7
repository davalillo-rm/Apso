

Sub CopiarRepricing()

    Dim wbDestino    As Workbook
    Dim wbOrigen     As Workbook
    Dim wsDestino    As Worksheet
    Dim wsOrigen     As Worksheet
    Dim fechaCelda   As Date
    Dim mesCarpeta   As String
    Dim anioCarpeta  As String
    Dim rutaInputsRM As String
    Dim archivoRep   As String

    '--- 1. Tomar Inputs.xlsx abierto
    On Error Resume Next
    Set wbDestino = Workbooks("Inputs.xlsx")
    On Error GoTo 0

    If wbDestino Is Nothing Then
        MsgBox "No se encontró Inputs.xlsx abierto.", vbCritical
        Exit Sub
    End If

    '--- 2. Leer fecha de Recopilado C3
    fechaCelda  = CDate(wbDestino.Sheets("Recopilado").Range("C3").Value)
    mesCarpeta  = Format(Month(fechaCelda), "00")
    anioCarpeta = Year(fechaCelda)

    '--- 3. Construir ruta y buscar archivo
    rutaInputsRM = "C:\Users\s7398771\OneDrive - The Bank of Nova Scotia\" & _
                   "Documentos\anexo 7\" & anioCarpeta & "\" & mesCarpeta & "\Inputs RM\"

    archivoRep = Dir(rutaInputsRM & "repricing*.xls*")

    If archivoRep = "" Then
        MsgBox "No se encontró archivo repricing en:" & vbCrLf & rutaInputsRM, vbCritical
        Exit Sub
    End If

    '--- 4. Abrir origen
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    Set wbOrigen  = Workbooks.Open(rutaInputsRM & archivoRep, ReadOnly:=True)
    Set wsOrigen  = wbOrigen.Sheets("DATA")
    Set wsDestino = wbDestino.Sheets("NMD")

    '--- 5. Mapeo de rangos (solo valores)
    wsDestino.Range("E3:E19").Value   = wsOrigen.Range("E1:E17").Value
    wsDestino.Range("E20:E36").Value  = wsOrigen.Range("H1:H17").Value
    wsDestino.Range("E37:E53").Value  = wsOrigen.Range("E21:E37").Value
    wsDestino.Range("E54:E70").Value  = wsOrigen.Range("H21:H37").Value

    wbOrigen.Close SaveChanges:=False

    Application.ScreenUpdating = True
    Application.DisplayAlerts = True

    MsgBox "Repricing copiado correctamente desde:" & vbCrLf & archivoRep, vbInformation

End Sub













Sub CopiarAnexosC1C2()

    Dim wbDestino  As Workbook
    Dim wbC1       As Workbook
    Dim wbC2       As Workbook
    Dim wsDestino  As Worksheet
    Dim wsC1       As Worksheet
    Dim wsC2       As Worksheet
    Dim fechaCelda As Date
    Dim mesCarpeta As String
    Dim anioCarpeta As String
    Dim rutaInputsRM As String
    Dim archivoC1  As String
    Dim archivoC2  As String
    Dim i          As Long
    Dim filaDest   As Long
    Dim ultimaFila As Long

    '--- 1. Tomar Inputs.xlsx abierto
    On Error Resume Next
    Set wbDestino = Workbooks("Inputs.xlsx")
    On Error GoTo 0

    If wbDestino Is Nothing Then
        MsgBox "No se encontró Inputs.xlsx abierto.", vbCritical
        Exit Sub
    End If

    '--- 2. Leer fecha de Recopilado C3
    fechaCelda   = CDate(wbDestino.Sheets("Recopilado").Range("C3").Value)
    mesCarpeta   = Format(Month(fechaCelda), "00")
    anioCarpeta  = Year(fechaCelda)

    '--- 3. Construir ruta
    rutaInputsRM = "C:\Users\s7398771\OneDrive - The Bank of Nova Scotia\" & _
                   "Documentos\anexo 7\" & anioCarpeta & "\" & mesCarpeta & "\Inputs RM\"

    '--- 4. Buscar archivos
    archivoC1 = Dir(rutaInputsRM & "Anexo 1 C1*.xls*")
    archivoC2 = Dir(rutaInputsRM & "Anexo 1 C2*.xls*")

    If archivoC1 = "" Then
        MsgBox "No se encontró Anexo 1 C1 en:" & vbCrLf & rutaInputsRM, vbCritical
        Exit Sub
    End If
    If archivoC2 = "" Then
        MsgBox "No se encontró Anexo 1 C2 en:" & vbCrLf & rutaInputsRM, vbCritical
        Exit Sub
    End If

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    Set wsDestino = wbDestino.Sheets("Repos")

    '========================================
    '--- 5. COPIAR C1 → B4 (cols B,D,G,I,J)
    '========================================
    Set wbC1  = Workbooks.Open(rutaInputsRM & archivoC1, ReadOnly:=True)
    Set wsC1  = wbC1.Sheets("Anexo 1C1_Sucave")

    ultimaFila = wsC1.Cells(wsC1.Rows.Count, "B").End(xlUp).Row
    filaDest   = 4

    For i = 1 To ultimaFila
        If Trim(wsC1.Cells(i, "B").Value) <> "" And _
           Not IsEmpty(wsC1.Cells(i, "B").Value) And _
           IsNumeric(wsC1.Cells(i, "B").Value) Then  ' solo filas de datos, no headers

            wsDestino.Cells(filaDest, "B").Value = wsC1.Cells(i, "B").Value
            wsDestino.Cells(filaDest, "C").Value = wsC1.Cells(i, "D").Value
            wsDestino.Cells(filaDest, "D").Value = wsC1.Cells(i, "G").Value
            wsDestino.Cells(filaDest, "E").Value = wsC1.Cells(i, "I").Value
            wsDestino.Cells(filaDest, "F").Value = wsC1.Cells(i, "J").Value
            filaDest = filaDest + 1
        End If
    Next i

    wbC1.Close SaveChanges:=False

    '========================================
    '--- 6. COPIAR C2 → J4 (cols F,H,E)
    '========================================
    Set wbC2  = Workbooks.Open(rutaInputsRM & archivoC2, ReadOnly:=True)
    Set wsC2  = wbC2.Sheets("Anexo 1-C2_MN")

    ultimaFila = wsC2.Cells(wsC2.Rows.Count, "B").End(xlUp).Row
    filaDest   = 4

    For i = 1 To ultimaFila
        If Trim(wsC2.Cells(i, "B").Value) <> "" And _
           Not IsEmpty(wsC2.Cells(i, "B").Value) And _
           IsNumeric(wsC2.Cells(i, "B").Value) Then  ' solo filas de datos, no headers

            wsDestino.Cells(filaDest, "J").Value = wsC2.Cells(i, "F").Value
            wsDestino.Cells(filaDest, "K").Value = wsC2.Cells(i, "H").Value
            wsDestino.Cells(filaDest, "L").Value = wsC2.Cells(i, "E").Value
            filaDest = filaDest + 1
        End If
    Next i

    wbC2.Close SaveChanges:=False

    Application.ScreenUpdating = True
    Application.DisplayAlerts = True

    MsgBox "Anexos C1 y C2 copiados correctamente.", vbInformation

End Sub







Sub CopiarCarteraViva()

    Dim wbDestino    As Workbook
    Dim wbOrigen     As Workbook
    Dim wsDestino    As Worksheet
    Dim wsOrigen     As Worksheet
    Dim fechaCelda   As Date
    Dim mesCarpeta   As String
    Dim anioCarpeta  As String
    Dim rutaInputsRM As String
    Dim archivoCV    As String
    Dim ultimaFila   As Long
    Dim i            As Long
    Dim filaDest     As Long
    Dim tipoInstr    As String
    
    '--- 1. Tomar Inputs.xlsx abierto
    On Error Resume Next
    Set wbDestino = Workbooks("Inputs.xlsx")
    On Error GoTo 0
    
    If wbDestino Is Nothing Then
        MsgBox "No se encontró Inputs.xlsx abierto.", vbCritical
        Exit Sub
    End If
    
    '--- 2. Leer fecha de Recopilado C3
    fechaCelda  = CDate(wbDestino.Sheets("Recopilado").Range("C3").Value)
    mesCarpeta  = Format(Month(fechaCelda), "00")
    anioCarpeta = Year(fechaCelda)
    
    '--- 3. Construir ruta y buscar archivo Cartera_viva*
    rutaInputsRM = "C:\Users\s7398771\OneDrive - The Bank of Nova Scotia\" & _
                   "Documentos\anexo 7\" & anioCarpeta & "\" & mesCarpeta & "\Inputs RM\"
    
    archivoCV = Dir(rutaInputsRM & "Cartera_viva*.xls*")
    
    If archivoCV = "" Then
        MsgBox "No se encontró archivo Cartera_viva en:" & vbCrLf & rutaInputsRM, vbCritical
        Exit Sub
    End If
    
    '--- 4. Abrir origen
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    
    Set wbOrigen  = Workbooks.Open(rutaInputsRM & archivoCV, ReadOnly:=True)
    Set wsOrigen  = wbOrigen.Sheets(1)
    Set wsDestino = wbDestino.Sheets("Adeudos")
    
    ultimaFila = wsOrigen.Cells(wsOrigen.Rows.Count, "A").End(xlUp).Row
    filaDest   = 4  ' empieza en B4
    
    '--- 5. Recorrer ADWK_LOCAL y ADWK_OS_BA
    Dim tipos(1) As String
    tipos(0) = "ADWK_LOCAL"
    tipos(1) = "ADWK_OS_BA"
    
    Dim t As Integer
    For t = 0 To 1
        tipoInstr = tipos(t)
        
        For i = 1 To ultimaFila
            If Trim(wsOrigen.Cells(i, "A").Value) = tipoInstr Then
                
                ' Col B = AD (Cliente)
                wsDestino.Cells(filaDest, "B").Value = wsOrigen.Cells(i, "AD").Value
                ' Col C = Z (Fecha Vencimiento)
                wsDestino.Cells(filaDest, "C").Value = wsOrigen.Cells(i, "Z").Value
                ' Col D = D (Moneda)
                wsDestino.Cells(filaDest, "D").Value = wsOrigen.Cells(i, "D").Value
                ' Col E = E (Monto)
                wsDestino.Cells(filaDest, "E").Value = wsOrigen.Cells(i, "E").Value
                ' Col F = Fixed Rate K = 0 -> SI, sino NO
                If wsOrigen.Cells(i, "K").Value = 0 Then
                    wsDestino.Cells(filaDest, "F").Value = "SI"
                Else
                    wsDestino.Cells(filaDest, "F").Value = "NO"
                End If
                
                filaDest = filaDest + 1
            End If
        Next i
    Next t
    
    wbOrigen.Close SaveChanges:=False
    
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    
    MsgBox "Cartera Viva copiada correctamente desde:" & vbCrLf & archivoCV, vbInformation

End Sub














Sub CopiarDatos1B()

    Dim wbDestino   As Workbook
    Dim wbOrigen    As Workbook
    Dim wsRecopilado As Worksheet
    Dim wsDestino   As Worksheet
    Dim fechaCelda  As Date
    Dim mesCarpeta  As String
    Dim anioCarpeta As String
    Dim rutaBase    As String
    Dim rutaInputsRM As String
    Dim archivoOrigen As String
    Dim archivo1B   As String
    
    '--- 1. Tomar Inputs.xlsx (ya abierto)
    On Error Resume Next
    Set wbDestino = Workbooks("Inputs.xlsx")
    On Error GoTo 0
    
    If wbDestino Is Nothing Then
        MsgBox "No se encontró Inputs.xlsx abierto.", vbCritical
        Exit Sub
    End If
    
    '--- 2. Leer fecha de hoja Recopilado celda C3
    Set wsRecopilado = wbDestino.Sheets("Recopilado")
    fechaCelda = CDate(wsRecopilado.Range("C3").Value)
    
    mesCarpeta  = Format(Month(fechaCelda), "00")   ' "04"
    anioCarpeta = Year(fechaCelda)                   ' "2026"
    
    '--- 3. Construir rutas
    rutaBase     = "C:\Users\s7398771\OneDrive - The Bank of Nova Scotia\" & _
                   "Documentos\anexo 7\" & anioCarpeta & "\" & mesCarpeta & "\"
    rutaInputsRM = rutaBase & "Inputs RM\"
    
    '--- 4. Buscar archivo que empiece con "1-B"
    archivo1B = Dir(rutaInputsRM & "1-B*.xls*")
    
    If archivo1B = "" Then
        MsgBox "No se encontró archivo 1-B en:" & vbCrLf & rutaInputsRM, vbCritical
        Exit Sub
    End If
    
    archivoOrigen = rutaInputsRM & archivo1B
    
    '--- 5. Abrir origen, copiar, pegar valores, cerrar
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    
    Set wbOrigen = Workbooks.Open(archivoOrigen, ReadOnly:=True)
    
    Dim rngOrigen As Range
    Set rngOrigen = wbOrigen.Sheets(1).Range("A2:AK26")  ' ajusta nombre hoja si es necesario
    
    Set wsDestino = wbDestino.Sheets("Port_Inversiones")
    
    wsDestino.Range("A2").Resize(rngOrigen.Rows.Count, rngOrigen.Columns.Count).Value = _
        rngOrigen.Value
    
    wbOrigen.Close SaveChanges:=False
    
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    
    MsgBox "Datos copiados correctamente desde:" & vbCrLf & archivo1B, vbInformation

End Sub