Matriz_Unificada =
VAR _Factor    = SELECTEDVALUE(Estructura_Unificada[Factor])
VAR _Escenario = SELECTEDVALUE(Estructura_Unificada[Escenario])
VAR _Moneda    = SELECTEDVALUE(Estructura_Unificada[Moneda])

RETURN
SWITCH(
    _Factor,
    "Impacto RCL",
        CALCULATE(
            [Impacto_RCL_Consolidado],
            TREATAS({_Escenario}, EscenarioMoneda[Escenario]),
            TREATAS({_Moneda},    EscenarioMoneda[Moneda])
        ),
    "Deri. Compra",
        CALCULATE(
            [Impacto_RCL_Derivados_C],
            TREATAS({_Escenario}, EscenarioMoneda[Escenario]),
            TREATAS({_Moneda},    EscenarioMoneda[Moneda])
        ),
    "Deri. Venta",
        CALCULATE(
            [Impacto_RCL_Derivados_V],
            TREATAS({_Escenario}, EscenarioMoneda[Escenario]),
            TREATAS({_Moneda},    EscenarioMoneda[Moneda])
        )
)
