def mostrar_dropdown(contactos):
    nonlocal sugerencias_ventana
    
    if sugerencias_ventana:
        try:
            sugerencias_ventana.destroy()
        except:
            pass
        sugerencias_ventana = None
    
    # Coordenadas absolutas del entry en la pantalla
    x = entry_widget.winfo_rootx()
    y = entry_widget.winfo_rooty() + entry_widget.winfo_height() + 2
    w = entry_widget.winfo_width()
    h = len(contactos) * 32
    
    sugerencias_ventana = ctk.CTkToplevel()
    sugerencias_ventana.wm_overrideredirect(True)
    sugerencias_ventana.geometry(f"{w}x{h}+{x}+{y}")
    sugerencias_ventana.configure(fg_color=SCOTIA_CARD)
    sugerencias_ventana.attributes("-topmost", True)
    
    # Importante: sin parent para que las coords sean absolutas
    for c in contactos:
        if not c["email"]:
            ctk.CTkLabel(
                sugerencias_ventana,
                text=c["nombre"],
                text_color=SCOTIA_SUBTEXT,
                font=("Trebuchet MS", 11)
            ).pack(fill="x", padx=8, pady=4)
            continue
        
        texto = f"{c['nombre']}  <{c['email']}>"
        
        def seleccionar(email=c["email"]):
            entry_widget.delete(0, 'end')
            entry_widget.insert(0, email)
            try:
                sugerencias_ventana.destroy()
            except:
                pass
        
        ctk.CTkButton(
            sugerencias_ventana,
            text=texto,
            fg_color="transparent",
            hover_color=SCOTIA_SURFACE,
            text_color=SCOTIA_TEXT,
            anchor="w",
            height=30,
            font=("Trebuchet MS", 11),
            command=seleccionar
        ).pack(fill="x", padx=2, pady=0)