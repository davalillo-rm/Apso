def leer_items_de_proceso(nombre_proceso):
    if not os.path.exists(EXCEL_FILE): return []
    wb = openpyxl.load_workbook(EXCEL_FILE)
    ws = wb["Items_Esperados"] # Asegúrate de usar el nombre correcto de tu hoja
    items = []
    
    for row in ws.iter_rows(min_row=2, values_only=True):
        if row[0] == nombre_proceso:
            items.append({
                "nombre": row[1],
                "remitente": row[2],
                "asunto": row[3],
                # Capturamos la columna 5 (índice 4). Si está vacía, devuelve ""
                "solicitud": row[4] if len(row) > 4 and row[4] else "" 
            })
    return items





def guardar_item(nombre_proceso, nombre_item, remitente, asunto, solicitud_key):
    wb = openpyxl.load_workbook(EXCEL_FILE)
    ws = wb["Items_Esperados"]
    ws.append([nombre_proceso, nombre_item, remitente, asunto, solicitud_key])
    wb.save(EXCEL_FILE)





