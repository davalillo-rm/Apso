# ======================================================================
# Validaciones
# Devuelven (ok, mensajes) o None si no están implementadas.
# Prefijos: "✓" correcto, "✗" error, "⚠" advertencia (no hace fallar).
# ======================================================================
def leer_txt(ruta):
    for encoding in ("utf-8-sig", "latin-1"):
        try:
            with open(ruta, "r", encoding=encoding) as f:
                return f.read()
        except UnicodeDecodeError:
            continue
    raise ValueError("No se pudo leer el archivo con utf-8 ni latin-1")


def buscar_archivo(carpeta, archivos, nombre_esperado, token_fecha, mensajes, etiqueta):
    """Devuelve el nombre real del archivo o None. Agrega mensajes de resultado."""
    if nombre_esperado in archivos:
        mensajes.append(f"✓ {etiqueta}Archivo encontrado: {nombre_esperado}")
        return nombre_esperado

    coincidencia = [a for a in archivos if a.lower() == nombre_esperado.lower()]
    if coincidencia:
        mensajes.append(
            f"✗ {etiqueta}Mayúsculas/minúsculas incorrectas: {coincidencia[0]} "
            f"(esperado {nombre_esperado})"
        )
        return coincidencia[0]

    extension = os.path.splitext(nombre_esperado)[1].lower()
    parecidos = [
        a for a in archivos
        if token_fecha and token_fecha in a and a.lower().endswith(extension)
    ]
    mensajes.append(f"✗ {etiqueta}No existe el archivo {nombre_esperado}")
    if parecidos:
        mensajes.append("   Archivos parecidos: " + ", ".join(parecidos[:5]))
    return None


def validar_header(ruta_archivo, esperado, mensajes, etiqueta):
    """Compara la primera línea con el header esperado. Devuelve el contenido o None."""
    try:
        contenido = leer_txt(ruta_archivo)
    except Exception as error:
        mensajes.append(f"✗ {etiqueta}No se pudo leer el archivo: {error}")
        return None

    lineas = contenido.splitlines()
    if not lineas:
        mensajes.append(f"✗ {etiqueta}El archivo está vacío")
        return contenido

    header = lineas[0]
    if header.strip() == esperado:
        mensajes.append(f"✓ {etiqueta}Header correcto: {esperado}")
        if header != header.strip():
            mensajes.append(f"⚠ {etiqueta}El header tiene espacios al inicio o al final")
    else:
        mensajes.append(
            f"✗ {etiqueta}Header incorrecto: '{header.strip()}' (esperado '{esperado}')"
        )
    return contenido


def validar_txt_con_header(carpeta, esperado, fecha, etiqueta_fecha):
    """Valida que exista <esperado>.txt en la carpeta y que su primera línea sea <esperado>."""
    mensajes = [f"Fecha {etiqueta_fecha} evaluada: {fecha:%d/%m/%Y}"]

    if not os.path.isdir(carpeta):
        mensajes.append(f"✗ No se encuentra la carpeta: {carpeta}")
        return False, mensajes

    archivos = os.listdir(carpeta)
    nombre_real = buscar_archivo(
        carpeta, archivos, esperado + ".txt", f"{fecha:%Y%m%d}", mensajes, ""
    )
    if nombre_real:
        validar_header(os.path.join(carpeta, nombre_real), esperado, mensajes, "")

    ok = not any(m.startswith("✗") for m in mensajes)
    return ok, mensajes


