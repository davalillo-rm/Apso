"""
generar_reporte_bonds.py

Toma el reporte plano RTK (PE_B_H_AODT0MDT0MR) desde una ruta A,
lo transforma al formato de reporte agrupado "Bonds" (agrupado por
Folders_ShortName) y lo guarda como un Excel nuevo en la ruta B.

Uso:
    python generar_reporte_bonds.py

    o importando la función:
    from generar_reporte_bonds import generar_reporte
    generar_reporte(ruta_origen, ruta_destino)
"""

import os
import tempfile

import pandas as pd
from openpyxl import Workbook
from openpyxl.styles import Font, Alignment
from openpyxl.utils import get_column_letter

# ---------------------------------------------------------------------------
# 1) PARÁMETROS DE ENTRADA — MODIFICAR AQUÍ
# ---------------------------------------------------------------------------
RUTA_ORIGEN = r"C:\ruta\a\PE_AODT0MR_20260910.xlsx"      # Ruta A (archivo fuente)
RUTA_DESTINO = r"C:\ruta\a\Bonds_Reporte_20260910.xlsx"  # Ruta B (archivo de salida)
HOJA_ORIGEN = "RTK PE_B_H_AODT0MDT0MR"                   # Nombre de la hoja fuente
COLUMNA_AGRUPACION = "Folders_ShortName"                 # Campo por el que se agrupa
ORDEN_GRUPOS = ["ALM_INV", "ALM_LIQ", "TRAD_FIXIN"]      # Orden fijo deseado; cualquier otro
                                                          # grupo que aparezca se agrega al final,
