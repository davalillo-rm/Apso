
SELECT
    VND10NAT AS moneda,
    LEFT(VND10RUB,4) AS cuenta_cont,
    SUM(CASE WHEN VND10FVTO <> '00000000' AND DATEDIFF(day, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) BETWEEN 0 AND 7  THEN VND10SDOO ELSE 0 END) AS [7D],
    SUM(CASE WHEN VND10FVTO <> '00000000' AND DATEDIFF(day, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) BETWEEN 8 AND 15 THEN VND10SDOO ELSE 0 END) AS [15D],
    SUM(CASE WHEN VND10FVTO <> '00000000' AND DATEDIFF(day, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) BETWEEN 16 AND 30 THEN VND10SDOO ELSE 0 END) AS [30D],
    SUM(CASE WHEN VND10FVTO <> '00000000' AND DATEDIFF(day, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) > 30 AND DATEDIFF(month, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) = 2  THEN VND10SDOO ELSE 0 END) AS [2M],
    SUM(CASE WHEN VND10FVTO <> '00000000' AND DATEDIFF(month, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) = 3  THEN VND10SDOO ELSE 0 END) AS [3M],
    SUM(CASE WHEN VND10FVTO <> '00000000' AND DATEDIFF(month, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) BETWEEN 4 AND 6   THEN VND10SDOO ELSE 0 END) AS [6M],
    SUM(CASE WHEN VND10FVTO <> '00000000' AND DATEDIFF(month, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) BETWEEN 7 AND 12  THEN VND10SDOO ELSE 0 END) AS [12M],
    SUM(CASE WHEN VND10FVTO <> '00000000' AND DATEDIFF(month, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) BETWEEN 13 AND 24 THEN VND10SDOO ELSE 0 END) AS [2Y],
    SUM(CASE WHEN VND10FVTO <> '00000000' AND DATEDIFF(month, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) BETWEEN 25 AND 36 THEN VND10SDOO ELSE 0 END) AS [3Y],
    SUM(CASE WHEN VND10FVTO <> '00000000' AND DATEDIFF(month, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) BETWEEN 37 AND 48 THEN VND10SDOO ELSE 0 END) AS [4Y],
    SUM(CASE WHEN VND10FVTO <> '00000000' AND DATEDIFF(month, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) BETWEEN 49 AND 60 THEN VND10SDOO ELSE 0 END) AS [5Y],
    SUM(CASE WHEN VND10FVTO <> '00000000' AND DATEDIFF(month, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) BETWEEN 61 AND 120 THEN VND10SDOO ELSE 0 END) AS [10Y],
    SUM(CASE WHEN VND10FVTO <> '00000000' AND DATEDIFF(month, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) BETWEEN 121 AND 240 THEN VND10SDOO ELSE 0 END) AS [20Y],
    SUM(CASE WHEN VND10FVTO <> '00000000' AND DATEDIFF(month, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) > 240 THEN VND10SDOO ELSE 0 END) AS [50Y],
    SUM(CASE WHEN VND10FVTO = '00000000' THEN VND10SDOO ELSE 0 END) AS [INCIERTO],
    SUM(VND10SDOO) AS TOTAL_CONTROL
FROM [SBP_RGHISTORICA].[dbo].[BLPRNJBT_LVND10_20260731_PROCESADO]
WHERE VND10ENT = 1
AND LEFT(VND10RUB,4) IN ('2113','2313','2123','2323','2817','2827','2117','2127')
GROUP BY VND10NAT, LEFT(VND10RUB,4)
ORDER BY VND10NAT, cuenta_cont





