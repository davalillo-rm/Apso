def consolidar_indicadores():
    """Agrega los eventos de los historicos al Excel maestro sin duplicar."""
    tipos_correo = ("CORREO RECIBIDO", "CORREO OBSERVADO")
    tipos_persona = ("APP ABIERTA", "RECORDATORIO ENVIADO", "ESCALAMIENTO ENVIADO")
    encabezado = ["Equipo", "Usuario", "Fecha", "Hora", "Proceso", "Item", "Tipo", "Remitente"]

    def a_min(h):
        try:
            p = str(h).split(":")
            return int(p[0]) * 60 + int(p[1])
        except Exception:
            return 0

    os.makedirs(os.path.dirname(RUTA_INDICADORES), exist_ok=True)
    if os.path.exists(RUTA_INDICADORES):
        wb = openpyxl.load_workbook(RUTA_INDICADORES)
    else:
        wb = openpyxl.Workbook()
        wb.remove(wb.active)
    if "Eventos" not in wb.sheetnames:
        we = wb.create_sheet("Eventos")
        we.append(encabezado)
    else:
        we = wb["Eventos"]

    existentes_correo = {}
    existentes_persona = set()
    for r in we.iter_rows(min_row=2, values_only=True):
        r = list(r) + [None] * 8
        eq, us, fe, ho, pr, it, ti, re = [str(x).strip() if x is not None else "" for x in r[:8]]
        if ti in tipos_correo:
            existentes_correo.setdefault((eq, fe, pr, it, ti, re), []).append(a_min(ho))
        else:
            existentes_persona.add((eq, us, fe, ho, pr, ti))

    nuevos = 0
    for cod in DIRECTORIO_USUARIOS:
        hist = leer_historico_usuario(cod)
        for e in hist["eventos"]:
            tipo = e["tipo"]
            if tipo in tipos_correo:
                llave = (EQUIPO, e["fecha"], e["proceso"], e["item"], tipo, e["remitente"])
                m = a_min(e["hora"])
                if any(abs(m - x) <= 2 for x in existentes_correo.get(llave, [])):
                    continue
                existentes_correo.setdefault(llave, []).append(m)
            elif tipo in tipos_persona:
                llave = (EQUIPO, cod.lower(), e["fecha"], e["hora"], e["proceso"], tipo)
                if llave in existentes_persona:
                    continue
                existentes_persona.add(llave)
            else:
                continue
            we.append([EQUIPO, cod.lower(), e["fecha"], e["hora"], e["proceso"], e["item"], tipo, e["remitente"]])
            nuevos += 1

    wb.save(RUTA_INDICADORES)
    return nuevos






def proxima_fecha_dias(dias):
    nombres = ["LUN", "MAR", "MIE", "JUE", "VIE", "SAB", "DOM"]
    hoy = datetime.date.today()
    for i in range(0, 8):
        d = hoy + datetime.timedelta(days=i)
        if nombres[d.weekday()] in dias:
            return d
    return None



