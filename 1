IF OBJECT_ID('tempdb..#base_segmento') IS NOT NULL DROP TABLE #base_segmento;

SELECT
    CAST(p.CUENTA_BT AS NUMERIC(9,0)) AS CUENTA_BT,
    p.SEGMENTO,
    CASE 
        WHEN p.SEGMENTO IN ('Personal','Estandar','Premium','Preferente','Beyond') THEN 'PN'
        WHEN p.SEGMENTO IN ('Micro Empresas','NEGOCIOS 1','NEGOCIOS 2','NEGOCIOS 3') THEN 'SME'
        WHEN p.SEGMENTO IN ('Medianas Empresas','Otras Instituciones','Pequeñas Empresas A',
                             'Polo Direccion','Sector Gobierno','Corporativo','Instituciones Financieras') 
            THEN 'Mayorista'
