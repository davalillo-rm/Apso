;WITH base AS (
    SELECT
        VND10NAT,
        LEFT(VND10RUB,4) AS cuenta_cont,
        VND10SDOO,
        DATEDIFF(day, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) AS dias,
        DATEDIFF(month, CONVERT(date,VND10FEC,112), CONVERT(date,VND10FVTO,112)) AS mes,
        VND10FVTO
    FROM [SBP_RGHISTORICA].[dbo].[BLPRNJBT_LVND10_20260731_PROCESADO]
    WHERE VND10ENT = 1
    AND LEFT(VND10RUB,4) IN ('2113','2313','2123','2323','2817','2827','2117','2127')
),
bandas AS (
    SELECT *,
        -- Pasada 1: banda base según Mes (calendario)
        CASE 
            WHEN mes = 1 THEN '30D'
            WHEN mes = 2 THEN '2M'
            WHEN mes = 3 THEN '3M'
            WHEN mes BETWEEN 4 AND 6   THEN '6M'
            WHEN mes BETWEEN 7 AND 12  THEN '12M'
            WHEN mes BETWEEN 13 AND 24 THEN '2Y'
            WHEN mes BETWEEN 25 AND 36 THEN '3Y'
            WHEN mes BETWEEN 37 AND 48 THEN '4Y'
            WHEN mes BETWEEN 49 AND 60 THEN '5Y'
            WHEN mes BETWEEN 61 AND 120 THEN '10Y'
            WHEN mes BETWEEN 121 AND 240 THEN '20Y'
            ELSE '50Y'
        END AS banda_mes
    FROM base
    WHERE VND10FVTO <> '00000000' AND dias > 0
)
SELECT
    VND10NAT AS moneda,
    cuenta_cont,
    -- Pasada 2: override por Dia solo hasta 30, si no, se queda la banda_mes
    SUM(CASE WHEN dias BETWEEN 0 AND 7  THEN VND10SDOO ELSE 0 END) AS [7D],
    SUM(CASE WHEN dias BETWEEN 8 AND 15 THEN VND10SDOO ELSE 0 END) AS [15D],
    SUM(CASE WHEN dias BETWEEN 16 AND 30 THEN VND10SDOO ELSE 0 END
        + CASE WHEN dias > 30 AND banda_mes = '30D' THEN VND10SDOO ELSE 0 END) AS [30D],
    SUM(CASE WHEN dias > 30 AND banda_mes = '2M'  THEN VND10SDOO ELSE 0 END) AS [2M],
    SUM(CASE WHEN dias > 30 AND banda_mes = '3M'  THEN VND10SDOO ELSE 0 END) AS [3M],
    SUM(CASE WHEN dias > 30 AND banda_mes = '6M'  THEN VND10SDOO ELSE 0 END) AS [6M],
    SUM(CASE WHEN dias > 30 AND banda_mes = '12M' THEN VND10SDOO ELSE 0 END) AS [12M],
    SUM(CASE WHEN dias > 30 AND banda_mes = '2Y'  THEN VND10SDOO ELSE 0 END) AS [2Y],
    SUM(CASE WHEN dias > 30 AND banda_mes = '3Y'  THEN VND10SDOO ELSE 0 END) AS [3Y],
    SUM(CASE WHEN dias > 30 AND banda_mes = '4Y'  THEN VND10SDOO ELSE 0 END) AS [4Y],
    SUM(CASE WHEN dias > 30 AND banda_mes = '5Y'  THEN VND10SDOO ELSE 0 END) AS [5Y],
    SUM(CASE WHEN dias > 30 AND banda_mes = '10Y' THEN VND10SDOO ELSE 0 END) AS [10Y],
    SUM(CASE WHEN dias > 30 AND banda_mes = '20Y' THEN VND10SDOO ELSE 0 END) AS [20Y],
    SUM(CASE WHEN dias > 30 AND banda_mes = '50Y' THEN VND10SDOO ELSE 0 END) AS [50Y]
FROM bandas
GROUP BY VND10NAT, cuenta_cont
ORDER BY VND10NAT, cuenta_cont
 