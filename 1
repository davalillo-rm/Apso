def eliminar_temporal_seguro(ruta, intentos=5):
    for _ in range(intentos):
        if not os.path.exists(ruta):
            return
        try:
            os.remove(ruta)
            return
        except Exception:
            time.sleep(2)
    raise RuntimeError(f"No se pudo borrar {ruta}")


def cerrar_excel_maestro():
    """Cierra Excel sin avisos y remata con taskkill para que no queden ventanas."""
    try:
        import win32com.client as win32
        excel = win32.GetActiveObject("Excel.Application")
        excel.DisplayAlerts = False
        for wb in excel.Workbooks:
            wb.Close(SaveChanges=False)
        excel.Quit()
    except Exception:
        pass
    try:
        subprocess.run(
            ["taskkill", "/f", "/im", "excel.exe"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


# --- Teclado enviado como teclado físico (scancodes), para controles que ignoran a pyautogui ---
SC_CTRL, SC_SHIFT, SC_RIGHT, SC_C = 0x1D, 0x2A, 0x4D, 0x2E

if sys.platform == "win32":
    from ctypes import wintypes

    class _KEYBDINPUT(ctypes.Structure):
        _fields_ = [("wVk", wintypes.WORD), ("wScan", wintypes.WORD),
                    ("dwFlags", wintypes.DWORD), ("time", wintypes.DWORD),
                    ("dwExtraInfo", ctypes.c_size_t)]

    class _MOUSEINPUT(ctypes.Structure):
        _fields_ = [("dx", wintypes.LONG), ("dy", wintypes.LONG),
                    ("mouseData", wintypes.DWORD), ("dwFlags", wintypes.DWORD),
                    ("time", wintypes.DWORD), ("dwExtraInfo", ctypes.c_size_t)]

    class _HARDWAREINPUT(ctypes.Structure):
        _fields_ = [("uMsg", wintypes.DWORD), ("wParamL", wintypes.WORD),
                    ("wParamH", wintypes.WORD)]

    class _INPUT_UNION(ctypes.Union):
        _fields_ = [("ki", _KEYBDINPUT), ("mi", _MOUSEINPUT), ("hi", _HARDWAREINPUT)]

    class _INPUT(ctypes.Structure):
        _fields_ = [("type", wintypes.DWORD), ("u", _INPUT_UNION)]

    def _tecla_sc(scan, abajo, extendida=False):
        flags = 0x0008  # KEYEVENTF_SCANCODE
        if extendida:
            flags |= 0x0001  # KEYEVENTF_EXTENDEDKEY
        if not abajo:
            flags |= 0x0002  # KEYEVENTF_KEYUP
        entrada = _INPUT(type=1, u=_INPUT_UNION(ki=_KEYBDINPUT(0, scan, flags, 0, 0)))
        ctypes.windll.user32.SendInput(1, ctypes.byref(entrada), ctypes.sizeof(_INPUT))
else:
    def _tecla_sc(scan, abajo, extendida=False):
        raise RuntimeError("El envío por scancode solo funciona en Windows")


def _seleccion_teclado(n):
    """Mantiene Ctrl+Shift y toca la flecha derecha n veces, como a mano."""
    _tecla_sc(SC_CTRL, True)
    _tecla_sc(SC_SHIFT, True)
    time.sleep(0.15)
    try:
        for _ in range(n):
            _tecla_sc(SC_RIGHT, True, extendida=True)
            time.sleep(0.05)
            _tecla_sc(SC_RIGHT, False, extendida=True)
            time.sleep(PAUSA_ENTRE_SELECCIONES)
    finally:
        _tecla_sc(SC_SHIFT, False)
        _tecla_sc(SC_CTRL, False)


def _seleccion_mouse():
    """Arrastra desde el inicio hasta el fin del texto de la fecha."""
    pyautogui.mouseDown(button="left")
    try:
        pyautogui.moveTo(*CLICK_FIN_FECHA, duration=0.4)
    finally:
        pyautogui.mouseUp(button="left")


def _ctrl_c():
    _tecla_sc(SC_CTRL, True)
    time.sleep(0.05)
    _tecla_sc(SC_C, True)
    time.sleep(0.05)
    _tecla_sc(SC_C, False)
    time.sleep(0.05)
    _tecla_sc(SC_CTRL, False)


def _copiar_seleccion(n, pausa_visual=0.0):
    """Click al inicio de la fecha, la selecciona (teclado o mouse) y copia. Devuelve el texto copiado."""
    pyperclip.copy("")
    pyautogui.click(*CLICK_INICIO_FECHA)
    time.sleep(0.4)
    if METODO_SELECCION == "mouse":
        _seleccion_mouse()
    else:
        _seleccion_teclado(n)
    time.sleep(0.2 + pausa_visual)
    _ctrl_c()
    time.sleep(0.6)
    return pyperclip.paste().strip()


def leer_fecha_ventana(verbose=False):
    """Lee la fecha del cuadrito seleccionándola con el teclado y copiándola."""
    patron = r"(\d{1,2})\D*([A-Za-zÁÉÍÓÚáéíóúñÑ]{3})\D*(\d{4})"
    txt = ""
    m = None
    for intento in range(1, INTENTOS_LECTURA + 1):
        txt = _copiar_seleccion(SELECCIONES_FECHA)
        if verbose:
            print(f"   Portapapeles (intento {intento}): {txt!r}")
        m = re.search(patron, txt)
        if m:
            break
    if not m:
        raise ValueError(f"No pude leer la fecha del cuadrito. Copié: {txt!r}")
    dia, mes, anio = m.groups()
    mes = mes.capitalize()
    if mes not in MESES:
        raise ValueError(f"Mes no reconocido: {mes!r} (agrégalo a MESES)")
    return date(int(anio), MESES[mes], int(dia))


