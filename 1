    Sql = Sql & "FLOATING_RATE, FECHA_CONTRATACION, HORA, FECHA_VALOR, FECHA_VENCIMIENTO, " & vbCrLf
    Sql = Sql & "PLAZO, DIAS_TRANSCURRIDOS, CODIGO_BT, CLIENTE, CARTERA, PORTAFOLIO, " & vbCrLf
    Sql = Sql & "TRADER, BROKER, COMMENTS, INTEPROC, TASA_TRANSFERENCIA" & vbCrLf
    Sql = Sql & ") " & vbCrLf
    Sql = Sql & "SELECT " & vbCrLf
    Sql = Sql & "CONVERT(INT, CONVERT(VARCHAR(8), [Fecha], 112)) AS FECHA, " & vbCrLf
    Sql = Sql & "[Tipo Instrumento], [Numero K+], [Numero TL], [Moneda], [Monto], " & vbCrLf
    Sql = Sql & "[Intereses Devengados], [Intereses Totales], [Capital + Intereses], [Intereses Diarios], " & vbCrLf
    Sql = Sql & "[Spread], [Fixed Rate], [Client Margin], [Client Rate], [Indexation], [Deal Type], " & vbCrLf
    Sql = Sql & "[Calc Method], [Frecuencia de pago], [Amortizacion], [Basis], [Roll Convention], [Purpose], " & vbCrLf
    Sql = Sql & "[Floating Rate], [Fecha Contratacion], [Hora], [Fecha Valor], [Fecha de Vencimiento], " & vbCrLf
    Sql = Sql & "[Plazo], [Dias Transcurridos], [Codigo BT], [Cliente], [Cartera], [Portafolio], " & vbCrLf
    Sql = Sql & "[Trader], [Broker], [Comments], [INTEPROC], [Tasa Transferencia] " & vbCrLf
    Sql = Sql & "FROM SBP_RGTRABAJO.DBO.RM_CARTERA_VIVA " & vbCrLf
    Sql = Sql & "WHERE [Fecha] = '" & FechaDate & "'"

    cn.Execute Sql, FilasInsertadas

    cn.CommitTrans
    EnTransaccion = False
    cn.Close
    Set cn = Nothing

    MsgBox "Cartera Viva " & FechaInt & " cargada" & vbCrLf & _
           "Filas borradas: " & FilasBorradas & vbCrLf & _
           "Filas insertadas: " & FilasInsertadas, vbInformation
    Exit Sub

ErrHandler:
    If EnTransaccion Then cn.RollbackTrans
    If Not cn Is Nothing Then
        If cn.State = 1 Then cn.Close
    End If
    MsgBox "Error: " & Err.Description, vbCritical

End Sub















