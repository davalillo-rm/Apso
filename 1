def enviar_outlook(para, asunto, cuerpo_html):
    import win32com.client as win32  # pip install pywin32
    outlook = win32.Dispatch("Outlook.Application")
    mail = outlook.CreateItem(0)
    mail.To = para
    if CORREO_CC:
        mail.CC = CORREO_CC
    mail.Subject = asunto
    mail.HTMLBody = cuerpo_html
    mail.Send()


def leer_control():
