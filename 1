# Lectura de la fecha en el Excel del Reporte 6
# ----------------------------------------------------------------------
def a_fecha(valor):
    """Convierte lo que venga de la celda (fecha, número de Excel o texto) a date."""
    if valor is None or valor == "":
        return None
    if isinstance(valor, datetime):
        return valor.date()
    if isinstance(valor, date):
        return valor
    if hasattr(valor, "year") and hasattr(valor, "month") and hasattr(valor, "day"):
        return date(valor.year, valor.month, valor.day)  # pywintypes.datetime
    if isinstance(valor, (int, float)):
        return date(1899, 12, 30) + timedelta(days=int(valor))
    texto = str(valor).strip()
    for formato in ("%d/%m/%Y", "%Y-%m-%d", "%d-%m-%Y", "%d/%m/%y", "%Y-%m-%d %H:%M:%S"):
        try:
            return datetime.strptime(texto, formato).date()
        except ValueError:
            continue
    return None


def celda_a_indices(celda):
    letras = "".join(c for c in celda if c.isalpha()).upper()
    numero = int("".join(c for c in celda if c.isdigit()))
    columna = 0
    for letra in letras:
        columna = columna * 26 + (ord(letra) - 64)
    return numero - 1, columna - 1  # base 0


def leer_celda_excel(ruta, celda):
    """Lee una celda de la primera hoja. Intenta xlrd, luego openpyxl y al final Excel (COM)."""
    fila, columna = celda_a_indices(celda)
    errores = []

    try:
        import xlrd  # pip install xlrd
        libro = xlrd.open_workbook(ruta)
        hoja = libro.sheet_by_index(0)
        c = hoja.cell(fila, columna)
        if c.ctype == xlrd.XL_CELL_DATE:
            return xlrd.xldate_as_datetime(c.value, libro.datemode)
        return c.value
    except Exception as error:
        errores.append(f"xlrd: {error}")

    try:
        import openpyxl
        libro = openpyxl.load_workbook(ruta, read_only=True, data_only=True)
        valor = libro.worksheets[0][celda].value
        libro.close()
        return valor
    except Exception as error:
        errores.append(f"openpyxl: {error}")

    try:
        import win32com.client as win32
        excel = win32.DispatchEx("Excel.Application")  # instancia aparte, no toca tu Excel
        excel.Visible = False
        excel.DisplayAlerts = False
        try:
            libro = excel.Workbooks.Open(os.path.abspath(ruta), ReadOnly=True)
            valor = libro.Worksheets(1).Range(celda).Value
            libro.Close(False)
            return valor
        finally:
            excel.Quit()
    except Exception as error:
        errores.append(f"Excel: {error}")

    raise ValueError("No se pudo leer el Excel (" + " | ".join(errores) + ")")


