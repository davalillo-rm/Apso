        with open(ARCHIVO_CONTROL, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def guardar_control(datos):
    try:
        with open(ARCHIVO_CONTROL, "w", encoding="utf-8") as f:
            json.dump(datos, f, indent=2)
    except Exception:
        pass


