IF OBJECT_ID('tempdb..#cuentas_4productos') IS NOT NULL DROP TABLE #cuentas_4productos

SELECT DISTINCT 
    CAST(CUENTA_BT AS NUMERIC(9,0)) AS CUENTA_BT,
    ID_SUBPRODUCTO
INTO #cuentas_4productos
FROM SBP_RGHISTORICA.dbo.PORTAFOLIO_SBP_PASIVOS
WHERE PERIODO = <periodo>
  AND ID_SUBPRODUCTO IN (416, 405, 470, 418)

CREATE INDEX IX_4productos_bt ON #cuentas_4productos(CUENTA_BT)

SELECT
    cp.ID_SUBPRODUCTO,
    CASE WHEN l.Moneda = 0 THEN 'PEN' WHEN l.Moneda = 1 THEN 'USD' END AS Moneda,
    l.TransaccionalPorTasa,
    COUNT(DISTINCT l.CUENTA_BT) AS Cuentas,
    SUM(l.Saldo) AS Saldo
FROM #lvnd10_saldo l
INNER JOIN #cuentas_4productos cp ON l.CUENTA_BT = cp.CUENTA_BT
GROUP BY cp.ID_SUBPRODUCTO, l.Moneda, l.TransaccionalPorTasa
ORDER BY cp.ID_SUBPRODUCTO, Moneda, l.TransaccionalPorTasa







SELECT
    p.ID_SUBPRODUCTO,
    CASE WHEN f.VND10MDA = 0 THEN 'PEN' WHEN f.VND10MDA = 1 THEN 'USD' END AS Moneda,
    pr.VND10TASA AS Tasa,
    COUNT(DISTINCT f.VND10CTA) AS Cuentas,
    SUM(f.VND10SDOO) AS Saldo
FROM Sbp_rghistorica.dbo.blprnjbt_lvnd10_<periodo>_PROCESADO f
INNER JOIN Sbp_rghistorica.dbo.blprnjbt_lvnd10_<periodo>_PRELIMINAR pr
    ON f.VND10COD = pr.VND10COD
    AND f.VND10CTA = pr.VND10CTA
    AND f.VND10MDA = pr.VND10MDA
    AND f.VND10OPER = pr.VND10OPER
    AND f.VND10SBOP = pr.VND10SBOP
INNER JOIN SBP_RGHISTORICA.dbo.PORTAFOLIO_SBP_PASIVOS p
    ON f.VND10CTA = CAST(p.CUENTA_BT AS NUMERIC(9,0))
WHERE f.VND10ENT = 1
  AND f.VND10MDA IN (0,1)
  AND LEFT(CAST(f.VND10RUB AS VARCHAR(20)), 4) IN ('2111','2112','2121','2122')
  AND p.PERIODO = <periodo>
GROUP BY p.ID_SUBPRODUCTO, f.VND10MDA, pr.VND10TASA
ORDER BY p.ID_SUBPRODUCTO, Moneda, Tasa












USE SBP_RGTRABAJO

-- PASO 1: Segmento por cuenta BT
IF OBJECT_ID('tempdb..#base_segmento') IS NOT NULL DROP TABLE #base_segmento

SELECT
    CAST(p.CUENTA_BT AS NUMERIC(9,0)) AS CUENTA_BT,
    p.SEGMENTO,
    CASE 
        WHEN p.SEGMENTO IN ('Personal','Estandar','Premium','Preferente','Beyond') THEN 'PN'
        WHEN p.SEGMENTO IN ('Micro Empresas','NEGOCIOS 1','NEGOCIOS 2','NEGOCIOS 3') THEN 'SME'
        WHEN p.SEGMENTO IN ('Medianas Empresas','Otras Instituciones','Pequeñas Empresas A',
                             'Polo Direccion','Sector Gobierno','Corporativo','Instituciones Financieras') 
            THEN 'Mayorista'
    END AS tipo_persona
INTO #base_segmento
FROM SBP_RGHISTORICA.dbo.PORTAFOLIO_SBP_PASIVOS p
WHERE p.PERIODO = <periodo>

-- PASO 2: Segmento único por cuenta
IF OBJECT_ID('tempdb..#segmento_unico') IS NOT NULL DROP TABLE #segmento_unico

SELECT DISTINCT CUENTA_BT, tipo_persona
INTO #segmento_unico
FROM #base_segmento

CREATE INDEX IX_segmento_unico_bt ON #segmento_unico(CUENTA_BT)

-- PASO 2.5: Catálogo de producto transaccional por cuenta BT
IF OBJECT_ID('tempdb..#producto_unico') IS NOT NULL DROP TABLE #producto_unico

SELECT 
    CAST(CUENTA_BT AS NUMERIC(9,0)) AS CUENTA_BT,
    MAX(CASE WHEN ID_SUBPRODUCTO IN (416, 405, 470) THEN 1 ELSE 0 END) AS EsProductoTransaccional
INTO #producto_unico
FROM SBP_RGHISTORICA.dbo.PORTAFOLIO_SBP_PASIVOS
WHERE PERIODO = <periodo>
GROUP BY CAST(CUENTA_BT AS NUMERIC(9,0))

CREATE INDEX IX_producto_unico_bt ON #producto_unico(CUENTA_BT)

-- PASO 3: LVND10 FINAL, saldo + TipoCuenta + flag Transaccional a nivel de OPERACIÓN (tasa desde Preliminar)
IF OBJECT_ID('tempdb..#lvnd10_saldo') IS NOT NULL DROP TABLE #lvnd10_saldo

SELECT
    f.VND10CTA AS CUENTA_BT,
    f.VND10COD AS CUENTA_UNICA,
    f.VND10MDA AS Moneda,
    f.VND10SDOO AS Saldo,
    CASE 
        WHEN LEFT(CAST(f.VND10RUB AS VARCHAR(20)), 4) IN ('2111','2121') THEN 'VISTA'
        WHEN LEFT(CAST(f.VND10RUB AS VARCHAR(20)), 4) IN ('2112','2122') THEN 'AHORRO'
    END AS TipoCuenta,
    CASE 
        WHEN p.VND10TASA = 0 THEN 'Transaccional'
        ELSE 'No transaccional'
    END AS TransaccionalPorTasa
INTO #lvnd10_saldo
FROM Sbp_rghistorica.dbo.blprnjbt_lvnd10_<periodo>_PROCESADO f
INNER JOIN Sbp_rghistorica.dbo.blprnjbt_lvnd10_<periodo>_PRELIMINAR p
    ON f.VND10COD = p.VND10COD
    AND f.VND10CTA = p.VND10CTA
    AND f.VND10MDA = p.VND10MDA
    AND f.VND10OPER = p.VND10OPER
    AND f.VND10SBOP = p.VND10SBOP
WHERE f.VND10ENT = 1
  AND f.VND10MDA IN (0,1)
  AND LEFT(CAST(f.VND10RUB AS VARCHAR(20)), 4) IN ('2111','2112','2121','2122')
  AND f.VND10RUB NOT BETWEEN 21110400000 AND 21110499999
  AND f.VND10RUB NOT BETWEEN 21110300000 AND 21110399999
  AND f.VND10RUB NOT BETWEEN 21110800000 AND 21110899999
  AND f.VND10RUB NOT BETWEEN 21111900000 AND 21111999999
  AND f.VND10RUB NOT BETWEEN 21210400000 AND 21210499999
  AND f.VND10RUB NOT BETWEEN 21210300000 AND 21210399999
  AND f.VND10RUB NOT BETWEEN 21210800000 AND 21210899999
  AND f.VND10RUB NOT BETWEEN 21211900000 AND 21211999999

-- PASO 4: Resumir por cuenta + moneda + TipoCuenta + TransaccionalPorTasa
IF OBJECT_ID('tempdb..#lvnd10_saldo_bt') IS NOT NULL DROP TABLE #lvnd10_saldo_bt

SELECT
    CUENTA_BT, CUENTA_UNICA, Moneda, TipoCuenta, TransaccionalPorTasa,
    SUM(Saldo) AS Saldo
INTO #lvnd10_saldo_bt
FROM #lvnd10_saldo
GROUP BY CUENTA_BT, CUENTA_UNICA, Moneda, TipoCuenta, TransaccionalPorTasa

CREATE INDEX IX_lvnd10bt_bt ON #lvnd10_saldo_bt(CUENTA_BT)

-- PASO 5: Combinar con criterio de producto (por cuenta, arrastra toda la cuenta a Transaccional)
IF OBJECT_ID('tempdb..#lvnd10_final') IS NOT NULL DROP TABLE #lvnd10_final

SELECT
    l.CUENTA_BT, l.CUENTA_UNICA, l.Moneda, l.TipoCuenta, l.Saldo,
    CASE 
        WHEN l.TransaccionalPorTasa = 'Transaccional' THEN 'Transaccional'
        WHEN pu.EsProductoTransaccional = 1 THEN 'Transaccional'
        ELSE 'No transaccional'
    END AS Transaccional
INTO #lvnd10_final
FROM #lvnd10_saldo_bt l
LEFT JOIN #producto_unico pu ON l.CUENTA_BT = pu.CUENTA_BT

-- PASO 6: + segmento pegado
IF OBJECT_ID('tempdb..#segmento_lvnd10') IS NOT NULL DROP TABLE #segmento_lvnd10

SELECT
    l.CUENTA_BT, l.CUENTA_UNICA, l.Moneda, l.TipoCuenta, l.Saldo, l.Transaccional, s.tipo_persona
INTO #segmento_lvnd10
FROM #lvnd10_final l
INNER JOIN #segmento_unico s ON l.CUENTA_BT = s.CUENTA_BT

-- PASO 7: Resultado final (PN y SME)
SELECT
    sl.tipo_persona AS [Tipo de Persona],
    sl.Transaccional,
    CASE WHEN sl.Moneda = 0 THEN 'PEN' WHEN sl.Moneda = 1 THEN 'USD' END AS Moneda,
    sl.TipoCuenta,
    SUM(sl.Saldo) AS Saldo
FROM #segmento_lvnd10 sl
WHERE sl.tipo_persona IN ('PN','SME')
GROUP BY 
    sl.tipo_persona,
    sl.Transaccional,
    CASE WHEN sl.Moneda = 0 THEN 'PEN' WHEN sl.Moneda = 1 THEN 'USD' END,
    sl.TipoCuenta
ORDER BY [Tipo de Persona], Transaccional, Moneda, TipoCuenta