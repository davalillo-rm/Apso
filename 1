def es_habil(f):
    return f.weekday() < 5 and f.strftime("%d/%m/%Y") not in FERIADOS

def ventanas_fechas(hoy, cortes, plazo, en_habiles, aviso, meses):
    import calendar
    ventanas = []
    for delta in (-1, 0, 1):
        m = hoy.month + delta
        a = hoy.year
        if m < 1:
            m += 12
            a -= 1
        elif m > 12:
            m -= 12
            a += 1
        if meses and m not in meses:
            continue
        ultimo = calendar.monthrange(a, m)[1]
        for c in cortes:
            dia = ultimo if c == "FIN" else int(c)
            if dia > ultimo:
                continue
            corte = datetime.date(a, m, dia)
            fin = corte
            if en_habiles:
                n = 0
                while n < plazo:
                    fin += datetime.timedelta(days=1)
                    if es_habil(fin):
                        n += 1
            else:
                fin = corte + datetime.timedelta(days=plazo)
            ini = corte
            if aviso is not None:
                ini = max(corte, fin - datetime.timedelta(days=aviso))
            while not es_habil(ini):
                ini += datetime.timedelta(days=1)
            fin_h = fin
            while not es_habil(fin_h):
                fin_h -= datetime.timedelta(days=1)
            if fin_h < ini:
                fin_h = ini
            ventanas.append((corte, ini, fin_h))
    ventanas.sort(key=lambda w: w[1])
    return ventanas



