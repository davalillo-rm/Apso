Option Explicit

Const HOJA_CORREO As String = "Correo"
Const HOJA_BIDASK As String = "BidAsk"
Const HOJA_FECHA As String = "RF2"
Const CELDA_FECHA As String = "W22"
Const RANGO_CORREO As String = "A1:I55"
Const MAX_POR_PAGINA As Long = 3
Const SEPARACION As Double = 12
Const ANCHO_IMP As Double = 523
Const ALTO_IMP As Double = 770

Sub GenerarReporteTasas()
    Dim wsC As Worksheet, wsB As Worksheet
    Set wsC = ThisWorkbook.Worksheets(HOJA_CORREO)
    Set wsB = ThisWorkbook.Worksheets(HOJA_BIDASK)

    Dim fecha As Date
    fecha = CDate(ThisWorkbook.Worksheets(HOJA_FECHA).Range(CELDA_FECHA).Value)

    Dim carpeta As String
    carpeta = ThisWorkbook.Path
    If carpeta = "" Or LCase(Left(carpeta, 4)) = "http" Then
        carpeta = Environ("USERPROFILE") & "\Documents\Tasas FI"
        If Dir(carpeta, vbDirectory) = "" Then MkDir carpeta
    End If

    Dim nombre As String: nombre = Format(fecha, "yyyymmdd") & " Tasas FI"
    Dim rutaXlsx As String, rutaPdf As String
    rutaXlsx = carpeta & "\" & nombre & ".xlsx"
    rutaPdf = carpeta & "\" & nombre & ".pdf"

    Application.DisplayAlerts = False
    CrearArchivo wsC, wsB, rutaXlsx, rutaPdf
    Application.DisplayAlerts = True

    CrearCorreo wsC, fecha, rutaXlsx, rutaPdf
End Sub

Private Sub CrearArchivo(wsC As Worksheet, wsB As Worksheet, rutaXlsx As String, rutaPdf As String)
    Dim wbN As Workbook, ws As Worksheet, shp As Shape
    wsC.Copy
    Set wbN = ActiveWorkbook
    Set ws = wbN.Worksheets(1)
    ws.Name = "Tasas"

    ChartsAImagen ws
    With ws.UsedRange
        .Value = .Value
    End With

    Dim rngC As Range: Set rngC = ws.Range(RANGO_CORREO)
    Dim anchoArea As Double: anchoArea = rngC.Width

    ' Escala que aplicara Excel al imprimir 1 pagina de ancho
    Dim escala As Double: escala = 1
    If anchoArea > ANCHO_IMP Then escala = ANCHO_IMP / anchoArea
    Dim altoPag As Double: altoPag = (ALTO_IMP / escala) * 0.96

    ' Donde termina el contenido de Correo
    Dim limite As Double: limite = rngC.Top + rngC.Height
    For Each shp In ws.Shapes
        If shp.Top + shp.Height > limite Then limite = shp.Top + shp.Height
    Next shp
    Dim filaIni As Long: filaIni = FilaDesde(ws, limite, rngC.Row + rngC.Rows.Count)

    ' Ordenar graficos de BidAsk de arriba hacia abajo
    Dim n As Long: n = wsB.ChartObjects.Count
    Dim idx() As Long: ReDim idx(1 To n)
    Dim i As Long, j As Long, tmp As Long
    For i = 1 To n: idx(i) = i: Next i
    For i = 1 To n - 1
        For j = i + 1 To n
            If wsB.ChartObjects(idx(j)).Top < wsB.ChartObjects(idx(i)).Top Then
                tmp = idx(i): idx(i) = idx(j): idx(j) = tmp
            End If
        Next j
    Next i

    ws.ResetAllPageBreaks

    Dim fila As Long: fila = filaIni
    Dim yPag As Double: yPag = ws.Rows(fila).Top
    Dim y As Double: y = yPag
    Dim enPagina As Long: enPagina = 0
    Dim w0 As Double, h0 As Double, h As Double
    ws.HPageBreaks.Add Before:=ws.Rows(fila)

    For i = 1 To n
        w0 = wsB.ChartObjects(idx(i)).Width
        h0 = wsB.ChartObjects(idx(i)).Height
        h = anchoArea * h0 / w0   ' mantiene la proporcion original

        If enPagina > 0 And (enPagina >= MAX_POR_PAGINA Or (y + h) > (yPag + altoPag)) Then
            fila = FilaDesde(ws, y, fila)
            ws.HPageBreaks.Add Before:=ws.Rows(fila)
            yPag = ws.Rows(fila).Top
            y = yPag
            enPagina = 0
        End If

        wsB.ChartObjects(idx(i)).Chart.CopyPicture xlScreen, xlPicture
        ws.Paste Destination:=ws.Range("A1")
        With ws.Shapes(ws.Shapes.Count)
            .LockAspectRatio = msoFalse
            .Left = rngC.Left
            .Width = anchoArea
            .Height = h
            .Top = y
        End With
        y = y + h + SEPARACION
        enPagina = enPagina + 1
    Next i

    Dim ultimaFila As Long: ultimaFila = FilaDesde(ws, y, fila) + 1

    With ws.PageSetup
        .PaperSize = xlPaperA4
        .LeftMargin = Application.InchesToPoints(0.5)
        .RightMargin = Application.InchesToPoints(0.5)
        .TopMargin = Application.InchesToPoints(0.5)
        .BottomMargin = Application.InchesToPoints(0.5)
        .HeaderMargin = 0
        .FooterMargin = 0
        .PrintArea = ws.Range(ws.Cells(1, rngC.Column), _
            ws.Cells(ultimaFila, rngC.Column + rngC.Columns.Count - 1)).Address
        .Orientation = xlPortrait
        .Zoom = False
        .FitToPagesWide = 1
        .FitToPagesTall = False
        .CenterHorizontally = True
    End With

    wbN.SaveAs Filename:=rutaXlsx, FileFormat:=xlOpenXMLWorkbook
    ws.ExportAsFixedFormat Type:=xlTypePDF, Filename:=rutaPdf, _
        Quality:=xlQualityStandard, IgnorePrintAreas:=False, OpenAfterPublish:=False
    wbN.Close SaveChanges:=False
End Sub

Private Function FilaDesde(ws As Worksheet, y As Double, desde As Long) As Long
    Dim r As Long: r = desde
    Do While ws.Rows(r).Top < y
        r = r + 1
    Loop
    FilaDesde = r
End Function

Private Sub ChartsAImagen(ws As Worksheet)
    Dim i As Long, co As ChartObject
    Dim l As Double, t As Double, w As Double, h As Double
    For i = ws.ChartObjects.Count To 1 Step -1
        Set co = ws.ChartObjects(i)
        l = co.Left: t = co.Top: w = co.Width: h = co.Height
        co.Chart.CopyPicture xlScreen, xlPicture
        co.Delete
        ws.Paste Destination:=ws.Range("A1")
        With ws.Shapes(ws.Shapes.Count)
            .LockAspectRatio = msoFalse
            .Left = l: .Top = t: .Width = w: .Height = h
        End With
    Next i
End Sub

Private Sub CrearCorreo(wsC As Worksheet, fecha As Date, rutaXlsx As String, rutaPdf As String)
    Dim olApp As Object, mail As Object, doc As Object, rg As Object
    On Error Resume Next
    Set olApp = GetObject(, "Outlook.Application")
    If olApp Is Nothing Then Set olApp = CreateObject("Outlook.Application")
    On Error GoTo 0

    Set mail = olApp.CreateItem(0)
    mail.Subject = "Tasas de Renta Fija - Per" & ChrW(250) & " al " & Format(fecha, "dd.mm.yyyy")
    mail.Attachments.Add rutaPdf
    mail.Attachments.Add rutaXlsx
    mail.Display

    Set doc = mail.GetInspector.WordEditor
    wsC.Range(RANGO_CORREO).CopyPicture xlScreen, xlPicture

    Set rg = doc.Range(0, 0)
    rg.InsertBefore "Hola, adjuntamos las tasas y el reporte de Renta Fija Per" & ChrW(250) & _
        " al " & Format(fecha, "dd.mm.yyyy") & vbCr
    rg.Collapse 0
    rg.Paste
End Sub