            "Database=SBP_RGTRABAJO;" & _
            "Trusted_Connection=yes"

    cn.BeginTrans
    EnTransaccion = True

    ' 1. Borra la fecha para evitar duplicados
    cn.Execute "DELETE FROM RMERCADO.MA_CARTERA_VIVA " & _
               "WHERE FECHA = " & FechaInt, FilasBorradas

    ' 2. Inserta la cartera viva de la fecha
    Sql = "INSERT INTO SBP_RGTRABAJO.RMERCADO.MA_CARTERA_VIVA (" & vbCrLf
    Sql = Sql & "FECHA, TIPO_INSTRUMENTO, NUMERO_K, NUMERO_TL, MONEDA, MONTO, " & vbCrLf
    Sql = Sql & "INTERESES_DEVENGADOS, INTERESES_TOTALES, CAPITAL_INTERESES, INTERESES_DIARIOS, " & vbCrLf
