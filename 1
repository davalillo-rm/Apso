        ).pack(fill="x", padx=25, pady=(0, 6))

        caja = tk.Frame(self, bg=BLANCO, highlightbackground="#9A9A9A", highlightthickness=1)
        caja.pack(fill="both", padx=25, pady=(0, 15))

        for i, rep in enumerate(REPORTES):
            fila = tk.Frame(caja, bg=BLANCO)
            fila.pack(fill="x", padx=18, pady=10)

            textos = tk.Frame(fila, bg=BLANCO)
            textos.pack(side="left", fill="x", expand=True)
            tk.Label(textos, text=rep["nombre"], font=F_NOMBRE, fg=ROJO, bg=BLANCO,
                     anchor="w").pack(fill="x")
            tk.Label(textos, text=rep["desc"], font=F_DESC, fg="#222222", bg=BLANCO,
                     anchor="w", wraplength=330, justify="left").pack(fill="x")

            indicador = tk.Label(fila, text="", font=("Segoe UI", 14, "bold"), bg=BLANCO, width=2)
            indicador.pack(side="right", padx=(6, 0))
            self.indicadores[rep["nombre"]] = indicador

            self._boton(fila, "Validar", AZUL_BOTON, AZUL_HOVER,
                        lambda r=rep: self._validar(r)).pack(side="right")
            self._boton(fila, "Abrir", GRIS_BOTON, GRIS_HOVER,
                        lambda r=rep: self._abrir(r)).pack(side="right", padx=(0, 6))

            if i < len(REPORTES) - 1:
                tk.Frame(caja, bg="#E2E2E2", height=1).pack(fill="x", padx=18)

    # ---------------- Panel de correo ----------------
    def _crear_panel_correo(self):
        panel = tk.Frame(self, bg=FONDO)
        panel.pack(fill="x", padx=25, pady=(0, 20))

        fila = tk.Frame(panel, bg=FONDO)
        fila.pack(fill="x")
        tk.Label(fila, text="Validado por:", font=F_DESC, bg=FONDO).pack(side="left")
        self.entry_validador = tk.Entry(fila, font=F_DESC, width=28)
        self.entry_validador.insert(0, NOMBRE_VALIDADOR)
        self.entry_validador.pack(side="left", padx=8)
        self._boton(fila, "Enviar correo firmado", ROJO, ROJO_OSCURO,
                    self._enviar_manual, ancho=0).pack(side="right")

        self.label_auto = tk.Label(panel, text="", font=F_DESC, fg="#555555", bg=FONDO, anchor="w")
        self.label_auto.pack(fill="x", pady=(8, 0))

        if MODO_PRUEBA:
            tk.Label(panel, text=f"MODO PRUEBA: los correos van a {CORREO_PRUEBA}",
                     font=("Segoe UI", 9, "bold"), fg=AMBAR, bg=FONDO, anchor="w").pack(fill="x")

    # ---------------- Acciones ----------------
    def _pintar(self, nombre, estado):
        simbolo = {OK: "✓", OK_ADV: "✓", OBSERVADO: "✗", ERROR: "✗"}.get(estado, "")
        self.indicadores[nombre].config(text=simbolo, fg=COLOR_ESTADO.get(estado, "#000000"))

    def _abrir(self, rep):
        try:
            rep["abrir"]()
        except Exception as error:
            messagebox.showerror("Error", f"No se pudo abrir {rep['nombre']}:\n{error}")

    def _validar(self, rep):
        estado, mensajes = ejecutar_validacion(rep["validar"])
        if estado == NO_IMPL:
            messagebox.showinfo("Pendiente", f"Las validaciones de {rep['nombre']} aún no están codificadas.")
            return
        self._pintar(rep["nombre"], estado)
        detalle = "\n".join(mensajes)
        if estado in (OK, OK_ADV):
            messagebox.showinfo(f"{rep['nombre']} - {estado}", detalle)
        else:
            messagebox.showwarning(f"{rep['nombre']} - {estado}", detalle)

    def _status_y_pintar(self):
        status = obtener_status()
        for nombre, estado, _ in status:
            self._pintar(nombre, estado)
        return status

    def _enviar(self, manual):
        status = self._status_y_pintar()
        constancia = None
        if manual:
            validador = self.entry_validador.get().strip()
            constancia = f"Validado por {validador} el {datetime.now():%d/%m/%Y} a las {datetime.now():%H:%M}"
        enviar_outlook(destinatario(), construir_asunto(manual), construir_html(status, constancia))

    def _enviar_manual(self):
        if not self.entry_validador.get().strip():
            messagebox.showwarning("Falta nombre", "Ingresa el nombre de quien valida.")
            return
        if not messagebox.askyesno("Enviar correo", f"¿Enviar el status firmado a {destinatario()}?"):
            return
        try:
            self._enviar(manual=True)
            messagebox.showinfo("Correo enviado", f"Status enviado a {destinatario()}")
        except Exception as error:
            messagebox.showerror("Error al enviar", f"No se pudo enviar el correo:\n{error}")

    # ---------------- Envío automático ----------------
    def _actualizar_label_auto(self):
        hoy = date.today().isoformat()
        hora = f"{HORA_ENVIO_AUTO[0]:02d}:{HORA_ENVIO_AUTO[1]:02d}"
        control = leer_control()
        if not es_dia_habil(date.today()):
            texto = "Correo automático: hoy no es día hábil"
        elif control.get("ultimo_envio_auto") == hoy:
            texto = f"Correo automático: enviado hoy a las {control.get('hora_envio_auto', '')}"
        elif control.get("error_auto_fecha") == hoy:
            texto = f"Correo automático: error al enviar ({control.get('error_auto', '')})"
        elif ya_paso(HORA_LIMITE_AUTO):
            texto = "Correo automático: no enviado hoy (app abierta fuera de horario)"
        else:
            texto = f"Correo automático: programado para las {hora}"
        self.label_auto.config(text=texto)

    def _revisar_envio_auto(self):
        hoy = date.today()
        control = leer_control()
        if (
            es_dia_habil(hoy)
            and ya_paso(HORA_ENVIO_AUTO)
            and not ya_paso(HORA_LIMITE_AUTO)
            and control.get("ultimo_envio_auto") != hoy.isoformat()
            and control.get("error_auto_fecha") != hoy.isoformat()
        ):
            try:
                self._enviar(manual=False)
                control["ultimo_envio_auto"] = hoy.isoformat()
                control["hora_envio_auto"] = f"{datetime.now():%H:%M}"
            except Exception as error:
                control["error_auto_fecha"] = hoy.isoformat()
                control["error_auto"] = str(error)[:80]
            guardar_control(control)

        self._actualizar_label_auto()
        self.after(30000, self._revisar_envio_auto)  # revisa cada 30 segundos

    def _centrar(self):
        self.update_idletasks()
        w, h = self.winfo_width(), self.winfo_height()
        x = (self.winfo_screenwidth() - w) // 2
        y = (self.winfo_screenheight() - h) // 2
        self.geometry(f"+{x}+{y}")


