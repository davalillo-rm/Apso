def ejecutar_validacion(funcion):
    """Devuelve (estado, mensajes) a partir de una función de validación."""
    try:
        resultado = funcion()
    except Exception as error:
        return ERROR, [f"✗ Error inesperado: {error}"]
    if resultado is None:
        return NO_IMPL, ["Validación aún no codificada"]
    ok, mensajes = resultado
    if not ok:
        return OBSERVADO, mensajes
    if any(m.startswith("⚠") for m in mensajes):
        return OK_ADV, mensajes
    return OK, mensajes


def obtener_status():
    """Ejecuta todas las validaciones. Reporte 5 queda pendiente antes de las 6pm."""
    status = []
    for rep in REPORTES:
        if rep["tarde"] and not ya_paso(HORA_CHECK_REPORTE_5):
            hora = f"{HORA_CHECK_REPORTE_5[0]:02d}:{HORA_CHECK_REPORTE_5[1]:02d}"
            status.append((rep["nombre"], PENDIENTE, [f"Se revisa a partir de las {hora}"]))
        else:
            estado, mensajes = ejecutar_validacion(rep["validar"])
            status.append((rep["nombre"], estado, mensajes))
    return status


