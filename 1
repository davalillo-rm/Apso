def validar_reporte_6():
    fecha = fecha_t_0()
    carpeta = RUTA_REPORTE_6
    mensajes = [f"Fecha T+0 evaluada: {fecha:%d/%m/%Y}"]

    if not os.path.isdir(carpeta):
        mensajes.append(f"✗ No se encuentra la carpeta: {carpeta}")
        return False, mensajes

    archivos = os.listdir(carpeta)
    header_esperado = f"{PREFIJO_R6}{fecha:%Y%m%d}012"

    # 1) Excel: REPORTE N 6-C.xls con B14 = T+0
    nombre_xls = buscar_archivo(carpeta, archivos, NOMBRE_XLS_R6, None, mensajes, "[XLS] ")
    if nombre_xls:
        try:
            valor = leer_celda_excel(os.path.join(carpeta, nombre_xls), CELDA_FECHA_R6)
            fecha_celda = a_fecha(valor)
            if fecha_celda is None:
                mensajes.append(f"✗ [XLS] {CELDA_FECHA_R6} no tiene una fecha válida: '{valor}'")
            elif fecha_celda == fecha:
                mensajes.append(f"✓ [XLS] {CELDA_FECHA_R6} = {fecha_celda:%d/%m/%Y}")
            else:
                mensajes.append(
                    f"✗ [XLS] {CELDA_FECHA_R6} = {fecha_celda:%d/%m/%Y} (esperado {fecha:%d/%m/%Y})"
                )
        except Exception as error:
            mensajes.append(f"✗ [XLS] {error}")

    # 2) TXT: 02060300004yyyymmdd.txt con header 02060300004yyyymmdd012
    contenido_txt = None
    nombre_txt = buscar_archivo(
        carpeta, archivos, f"{PREFIJO_R6}{fecha:%Y%m%d}.txt", f"{fecha:%Y%m%d}", mensajes, "[TXT] "
    )
    if nombre_txt:
        contenido_txt = validar_header(
            os.path.join(carpeta, nombre_txt), header_esperado, mensajes, "[TXT] "
        )

    # 3) 206: 03yymmdd.206 con el mismo header
    contenido_206 = None
    nombre_206 = buscar_archivo(
        carpeta, archivos, f"03{fecha:%y%m%d}.206", f"{fecha:%y%m%d}", mensajes, "[206] "
    )
    if nombre_206:
        contenido_206 = validar_header(
            os.path.join(carpeta, nombre_206), header_esperado, mensajes, "[206] "
        )

    # 4) TXT y 206 deberían tener el mismo contenido
    if contenido_txt is not None and contenido_206 is not None:
        if contenido_txt.strip() == contenido_206.strip():
            mensajes.append("✓ TXT y 206 tienen el mismo contenido")
        else:
            mensajes.append("⚠ TXT y 206 tienen contenido distinto")

    ok = not any(m.startswith("✗") for m in mensajes)
    return ok, mensajes


