            WHEN Orden <= 140 THEN CAST(Orden - 110 AS varchar(5)) + 'Y'
            ELSE '50Y+' END AS Gap,
       SUM(CAPITAL) AS CAPITAL
FROM Gaps
GROUP BY cuenta_cont, Orden
ORDER BY cuenta_cont, Orden












