Private Function ValorSQL(celda As Range, nombre As String) As String
    Dim v As Variant, s As String
    Dim esFecha As Boolean
    esFecha = (Right(nombre, 5) = "_DATE")
    v = celda.Value

    If IsError(v) Or IsEmpty(v) Then ValorSQL = "NULL": Exit Function

    Select Case VarType(v)
        Case vbDate
            ValorSQL = "'" & Format(v, "yyyymmdd") & "'"
        Case vbDouble, vbSingle, vbCurrency, vbInteger, vbLong, vbDecimal
            If esFecha Then
                ValorSQL = "'" & Format(CDate(v), "yyyymmdd") & "'"
            Else
                ValorSQL = Trim(Str(v))          ' siempre con punto decimal
            End If
        Case Else
            s = Trim(CStr(v))
            If s = "" Then
                ValorSQL = "NULL"
            ElseIf esFecha And IsDate(s) Then
                ValorSQL = "'" & Format(CDate(s), "yyyymmdd") & "'"
            Else
                ValorSQL = "'" & Replace(s, "'", "''") & "'"
            End If
    End Select
End Function








