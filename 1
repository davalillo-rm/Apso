def abrir_ruta(archivo, carpetas):
    """Abre el archivo si existe, si no la primera carpeta que exista."""
    if archivo and os.path.isfile(archivo):
        os.startfile(archivo)
        return
    for carpeta in carpetas:
        if carpeta and os.path.isdir(carpeta):
            if archivo:
                messagebox.showinfo(
                    "Archivo no encontrado",
                    f"No existe:\n{os.path.basename(archivo)}\n\nSe abrirá la carpeta.",
                )
            os.startfile(carpeta)
            return
    messagebox.showerror("Ruta no encontrada", "No se encontró:\n" + "\n".join(carpetas))


