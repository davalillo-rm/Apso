Private Function FechaTxt(v As Variant) As String
    If IsEmpty(v) Then Exit Function
    If VarType(v) = vbDate Then
        FechaTxt = Format(v, "yyyymmdd")
    ElseIf IsNumeric(v) Then
        If CDbl(v) > 10000000 Then
            FechaTxt = CStr(CLng(v))
        Else
            FechaTxt = Format(CDate(v), "yyyymmdd")
        End If
    ElseIf IsDate(v) Then
        FechaTxt = Format(CDate(v), "yyyymmdd")
    Else
        FechaTxt = CStr(v)
    End If
End Function

Private Function CeldaTxt(v As Variant, esFecha As Boolean) As String
    If IsError(v) Or IsEmpty(v) Then Exit Function
    Select Case VarType(v)
        Case vbDate
            CeldaTxt = Format(v, "yyyymmdd")
        Case vbDouble, vbSingle, vbCurrency, vbInteger, vbLong, vbDecimal
            If esFecha Then
                CeldaTxt = FechaTxt(v)
            Else
                CeldaTxt = Trim(Str(v))      ' punto decimal, sin separador de miles
            End If
        Case Else
            If esFecha Then
                CeldaTxt = FechaTxt(v)
            Else
                CeldaTxt = CStr(v)
            End If
    End Select
End Function














