def leer_fecha_ventana(verbose=False):
    """Lee la fecha del cuadrito seleccionándola con el teclado y copiándola."""
    patron = r"(\d{1,2})\D*([A-Za-zÁÉÍÓÚáéíóúñÑ]{3})\D*(\d{4})"
    txt = ""
    m = None
    for intento in range(1, INTENTOS_LECTURA + 1):
        txt = _copiar_seleccion(SELECCIONES_FECHA)
        if verbose:
            print(f"   Portapapeles (intento {intento}): {txt!r}")
        m = re.search(patron, txt)
        if m:
            break
    if not m:
        raise ValueError(f"No pude leer la fecha del cuadrito. Copié: {txt!r}")
    dia, mes, anio = m.groups()
    mes = mes.capitalize()
    if mes not in MESES:
        raise ValueError(f"Mes no reconocido: {mes!r} (agrégalo a MESES)")
    return date(int(anio), MESES[mes], int(dia))


