Option Explicit

Const HOJA_CORREO As String = "Correo"
Const HOJA_BIDASK As String = "BidAsk"
Const HOJA_FECHA As String = "RF2"
Const CELDA_FECHA As String = "W22"
Const RANGO_CORREO As String = "A1:I55"
Const MAX_ESTIRAR As Double = 1.2
Const SEPARACION As Double = 6
Const ANCHO_IMP As Double = 523
Const ALTO_IMP As Double = 770

Sub GenerarReporteTasas()
    Dim wsC As Worksheet, wsB As Worksheet
    Set wsC = ThisWorkbook.Worksheets(HOJA_CORREO)
    Set wsB = ThisWorkbook.Worksheets(HOJA_BIDASK)

    Dim fecha As Date
    fecha = CDate(ThisWorkbook.Worksheets(HOJA_FECHA).Range(CELDA_FECHA).Value)

    Dim carpeta As String
    carpeta = ThisWorkbook.Path
    If carpeta = "" Or LCase(Left(carpeta, 4)) = "http" Then
        carpeta = Environ("USERPROFILE") & "\Documents\Tasas FI"
        If Dir(carpeta, vbDirectory) = "" Then MkDir carpeta
    End If

    Dim nombre As String: nombre = Format(fecha, "yyyymmdd") & " Tasas FI"
    Dim rutaXlsx As String, rutaPdf As String
    rutaXlsx = carpeta & "\" & nombre & ".xlsx"
    rutaPdf = carpeta & "\" & nombre & ".pdf"

    CrearPdf wsC, wsB, rutaPdf

    Application.DisplayAlerts = False
    CrearArchivo wsC, wsB, rutaXlsx
    Application.DisplayAlerts = True

    CrearCorreo wsC, fecha, rutaXlsx, rutaPdf
End Sub

' ============ PDF: se imprime desde el libro con graficos reales (vectoriales) ============
Private Sub CrearPdf(wsC As Worksheet, wsB As Worksheet, rutaPdf As String)
    Const FILAS_PAG As Long = 54
    Const ALTO_FILA As Double = 14
    Const ANCHO_PDF As Double = 518
    Const SEP_PDF As Double = 6

    Dim tmp As Worksheet
    Dim wsAct As Object: Set wsAct = ActiveSheet
    Dim oldPA As String, oldZoom As Variant, oldW As Variant, oldT As Variant
    Dim errMsg As String

    Application.ScreenUpdating = False
    On Error GoTo Fallo

    ' Guardar la configuracion de impresion de Correo
    With wsC.PageSetup
        oldPA = .PrintArea
        oldZoom = .Zoom
        oldW = .FitToPagesWide
        oldT = .FitToPagesTall
    End With

    ' Correo: 1 sola pagina
    With wsC.PageSetup
        .PaperSize = xlPaperA4
        .Orientation = xlPortrait
        .LeftMargin = Application.InchesToPoints(0.5)
        .RightMargin = Application.InchesToPoints(0.5)
        .TopMargin = Application.InchesToPoints(0.5)
        .BottomMargin = Application.InchesToPoints(0.5)
        .HeaderMargin = 0
        .FooterMargin = 0
        .PrintArea = RANGO_CORREO
        .Zoom = False
        .FitToPagesWide = 1
        .FitToPagesTall = 1
        .CenterHorizontally = True
    End With

    ' Hoja temporal con los graficos de BidAsk
    Set tmp = ThisWorkbook.Worksheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
    tmp.Name = "TMP_PDF"
    tmp.Cells.RowHeight = ALTO_FILA
    Dim k As Long
    For k = 1 To 3
        tmp.Columns(1).ColumnWidth = tmp.Columns(1).ColumnWidth * ANCHO_PDF / tmp.Columns(1).Width
    Next k

    ' Ordenar graficos de BidAsk de arriba hacia abajo
    Dim n As Long: n = wsB.ChartObjects.Count
    If n = 0 Then Err.Raise vbObjectError + 1, , "No hay graficos en " & HOJA_BIDASK
    Dim idx() As Long: ReDim idx(1 To n)
    Dim i As Long, j As Long, t As Long
    For i = 1 To n: idx(i) = i: Next i
    For i = 1 To n - 1
        For j = i + 1 To n
            If wsB.ChartObjects(idx(j)).Top < wsB.ChartObjects(idx(i)).Top Then
                t = idx(i): idx(i) = idx(j): idx(j) = t
            End If
        Next j
    Next i

    ' Todos los graficos en una sola pagina
    Dim altoPag As Double: altoPag = FILAS_PAG * ALTO_FILA
    Dim hGraf As Double
    hGraf = (altoPag - (n - 1) * SEP_PDF - 6) / n

    wsB.Activate
    Dim co As Object, dup As Object
    For i = 1 To n
        Set dup = wsB.ChartObjects(idx(i)).Duplicate
        dup.Chart.Location xlLocationAsObject, tmp.Name
        Set co = tmp.ChartObjects(tmp.ChartObjects.Count)
        co.Placement = xlFreeFloating
        co.Left = 0
        co.Width = ANCHO_PDF
        co.Height = hGraf
        co.Top = tmp.Rows(1).Top + (i - 1) * (hGraf + SEP_PDF)
    Next i

    tmp.ResetAllPageBreaks
    With tmp.PageSetup
        .PaperSize = xlPaperA4
        .Orientation = xlPortrait
        .LeftMargin = Application.InchesToPoints(0.5)
        .RightMargin = Application.InchesToPoints(0.5)
        .TopMargin = Application.InchesToPoints(0.5)
        .BottomMargin = Application.InchesToPoints(0.5)
        .HeaderMargin = 0
        .FooterMargin = 0
        .Zoom = 100
        .CenterHorizontally = True
        .PrintArea = tmp.Range(tmp.Cells(1, 1), tmp.Cells(FILAS_PAG, 1)).Address
    End With

    ' Exportar Correo + hoja temporal en un solo PDF
    ThisWorkbook.Activate
    ThisWorkbook.Sheets(Array(wsC.Name, tmp.Name)).Select
    ActiveWindow.SelectedSheets.ExportAsFixedFormat Type:=xlTypePDF, Filename:=rutaPdf, _
        Quality:=xlQualityStandard, IgnorePrintAreas:=False, OpenAfterPublish:=False
    GoTo Limpiar

Fallo:
    errMsg = Err.Description

Limpiar:
    On Error Resume Next
    Application.DisplayAlerts = False
    If Not tmp Is Nothing Then tmp.Delete
    Application.DisplayAlerts = True
    With wsC.PageSetup
        .PrintArea = oldPA
        If VarType(oldZoom) = vbBoolean Then
            .Zoom = False
            .FitToPagesWide = oldW
            .FitToPagesTall = oldT
        Else
            .Zoom = oldZoom
        End If
    End With
    wsAct.Select
    Application.ScreenUpdating = True
    On Error GoTo 0
    If errMsg <> "" Then MsgBox "No se pudo crear el PDF." & vbCrLf & errMsg, vbCritical
End Sub

' ============ EXCEL .xlsx (todos los graficos en una hoja) ============
Private Sub CrearArchivo(wsC As Worksheet, wsB As Worksheet, rutaXlsx As String)
    Dim wbN As Workbook, ws As Worksheet, shp As Shape
    wsC.Copy
    Set wbN = ActiveWorkbook
    Set ws = wbN.Worksheets(1)
    ws.Name = "Tasas"

    ChartsAImagen ws
    With ws.UsedRange
        .Value = .Value
    End With

    Dim rngC As Range: Set rngC = ws.Range(RANGO_CORREO)
    Dim anchoArea As Double: anchoArea = rngC.Width

    Dim limite As Double: limite = rngC.Top + rngC.Height
    For Each shp In ws.Shapes
        If shp.Top + shp.Height > limite Then limite = shp.Top + shp.Height
    Next shp
    Dim altoCorreo As Double: altoCorreo = limite - rngC.Top

    Dim escala As Double: escala = 1
    If anchoArea > ANCHO_IMP Then escala = ANCHO_IMP / anchoArea
    If altoCorreo * escala > ALTO_IMP * 0.92 Then escala = (ALTO_IMP * 0.92) / altoCorreo
    Dim zoomPct As Long: zoomPct = Int(escala * 100)
    escala = zoomPct / 100

    Dim altoPag As Double: altoPag = (ALTO_IMP / escala) * 0.94

    Dim limDer As Double: limDer = rngC.Left + (ANCHO_IMP / escala) * 0.99
    Dim colFin As Long: colFin = rngC.Column + rngC.Columns.Count - 1
    Do While colFin < 60 And ws.Cells(1, colFin + 1).Left + ws.Cells(1, colFin + 1).Width <= limDer
        colFin = colFin + 1
    Loop
    Dim anchoGraf As Double
    anchoGraf = ws.Cells(1, colFin).Left + ws.Cells(1, colFin).Width - rngC.Left

    Dim n As Long: n = wsB.ChartObjects.Count
    Dim hMax As Double
    hMax = (altoPag - (n - 1) * SEPARACION) / n

    Dim filaIni As Long: filaIni = FilaDesde(ws, limite, rngC.Row + rngC.Rows.Count) + 1

    Dim idx() As Long: ReDim idx(1 To n)
    Dim i As Long, j As Long, tmp As Long
    For i = 1 To n: idx(i) = i: Next i
    For i = 1 To n - 1
        For j = i + 1 To n
            If wsB.ChartObjects(idx(j)).Top < wsB.ChartObjects(idx(i)).Top Then
                tmp = idx(i): idx(i) = idx(j): idx(j) = tmp
            End If
        Next j
    Next i

    ws.ResetAllPageBreaks
    ws.HPageBreaks.Add Before:=ws.Rows(filaIni)

    Dim y As Double: y = ws.Rows(filaIni).Top
    Dim w0 As Double, h0 As Double, h As Double, wImg As Double, hNat As Double
    Dim ruta As String

    For i = 1 To n
        w0 = wsB.ChartObjects(idx(i)).Width
        h0 = wsB.ChartObjects(idx(i)).Height
        hNat = anchoGraf * h0 / w0

        If hNat > hMax Then
            h = hMax
            wImg = anchoGraf * (hMax / hNat)
        Else
            wImg = anchoGraf
            h = hNat * MAX_ESTIRAR
            If h > hMax Then h = hMax
        End If

        ruta = Environ("TEMP") & "\grafico_" & i & ".png"
        wsB.ChartObjects(idx(i)).Chart.Export ruta, "PNG"
        Set shp = ws.Shapes.AddPicture(ruta, msoFalse, msoTrue, _
            rngC.Left + (anchoGraf - wImg) / 2, y, wImg, h)
        Kill ruta

        y = y + h + SEPARACION
    Next i

    Dim ultimaFila As Long: ultimaFila = FilaDesde(ws, y, filaIni) + 1

    With ws.PageSetup
        .PaperSize = xlPaperA4
        .LeftMargin = Application.InchesToPoints(0.5)
        .RightMargin = Application.InchesToPoints(0.5)
        .TopMargin = Application.InchesToPoints(0.5)
        .BottomMargin = Application.InchesToPoints(0.5)
        .HeaderMargin = 0
        .FooterMargin = 0
        .PrintArea = ws.Range(ws.Cells(1, rngC.Column), ws.Cells(ultimaFila, colFin)).Address
        .Orientation = xlPortrait
        .Zoom = zoomPct
        .CenterHorizontally = True
    End With

    wbN.SaveAs Filename:=rutaXlsx, FileFormat:=xlOpenXMLWorkbook
    wbN.Close SaveChanges:=False
End Sub

Private Function FilaDesde(ws As Worksheet, y As Double, desde As Long) As Long
    Dim r As Long: r = desde
    Do While ws.Rows(r).Top < y
        r = r + 1
    Loop
    FilaDesde = r
End Function

Private Sub ChartsAImagen(ws As Worksheet)
    Dim i As Long, co As ChartObject, ruta As String
    Dim l As Double, t As Double, w As Double, h As Double
    For i = ws.ChartObjects.Count To 1 Step -1
        Set co = ws.ChartObjects(i)
        l = co.Left: t = co.Top: w = co.Width: h = co.Height
        ruta = Environ("TEMP") & "\corr_" & i & ".png"
        co.Chart.Export ruta, "PNG"
        co.Delete
        ws.Shapes.AddPicture ruta, msoFalse, msoTrue, l, t, w, h
        Kill ruta
    Next i
End Sub

Private Sub CrearCorreo(wsC As Worksheet, fecha As Date, rutaXlsx As String, rutaPdf As String)
    Const FACTOR_IMG As Double = 1.3
    Const ANCHO_MAX As Double = 560

    Dim olApp As Object, mail As Object, doc As Object, rg As Object, img As Object
    On Error Resume Next
    Set olApp = GetObject(, "Outlook.Application")
    If olApp Is Nothing Then Set olApp = CreateObject("Outlook.Application")
    On Error GoTo 0

    Set mail = olApp.CreateItem(0)
    mail.Subject = "Tasas de Renta Fija - Per" & ChrW(250) & " al " & Format(fecha, "dd.mm.yyyy")
    mail.Attachments.Add rutaPdf
    mail.Attachments.Add rutaXlsx
    mail.Display

    Set doc = mail.GetInspector.WordEditor
    wsC.Range(RANGO_CORREO).CopyPicture xlPrinter, xlPicture

    Set rg = doc.Range(0, 0)
    rg.InsertBefore "Hola, adjuntamos las tasas y el reporte de Renta Fija Per" & ChrW(250) & _
        " al " & Format(fecha, "dd.mm.yyyy") & vbCr
    rg.Collapse 0
    rg.Paste

    Set img = doc.InlineShapes(1)
    img.LockAspectRatio = True
    img.Width = img.Width * FACTOR_IMG
    If img.Width > ANCHO_MAX Then img.Width = ANCHO_MAX
End Sub

















Sub TraerBidT1()
    Const CELDA_FECHA_T1 As String = "Q22"
    Const FILA_INI_T1 As Long = 24
    Const COL_SOB As String = "Q"
    Const COL_BID_T1 As String = "R"

    Dim ws As Worksheet: Set ws = ThisWorkbook.Worksheets("RF2")
    Dim fecha As Date
    fecha = CDate(ws.Range(CELDA_FECHA_T1).Value)
    Dim fTxt As String: fTxt = Format(fecha, "yyyymmdd")

    Dim sep As String: sep = Chr(59)
    Dim cs As String
    cs = "Provider=SQLOLEDB" & sep & "Data Source=" & SERVIDOR & sep & _
         "Initial Catalog=" & BASE_DATOS & sep & "Integrated Security=SSPI"

    Dim cn As Object: Set cn = CreateObject("ADODB.Connection")
    Dim rs As Object
    Dim dic As Object: Set dic = CreateObject("Scripting.Dictionary")
    Dim colNem As String: colNem = "[Nem" & ChrW(243) & "nico]"

    On Error GoTo Fallo
    cn.Open cs
    Set rs = cn.Execute("SELECT " & colNem & ", BID FROM " & TABLA & _
                        " WHERE Fecha = '" & fTxt & "'")
    Do While Not rs.EOF
        If Not IsNull(rs.Fields(1).Value) Then
            dic(UCase(Trim(rs.Fields(0).Value))) = CDbl(rs.Fields(1).Value)
        End If
        rs.MoveNext
    Loop
    rs.Close
    cn.Close

    If dic.Count = 0 Then
        MsgBox "No hay datos en SQL para el " & Format(fecha, "dd/mm/yyyy"), vbExclamation
        Exit Sub
    End If

    Dim r As Long, nem As String, faltan As String
    r = FILA_INI_T1
    Do While Trim(ws.Range(COL_SOB & r).Value & "") <> ""
        nem = Nemonico(ws.Range(COL_SOB & r).Value)
        If dic.Exists(nem) Then
            ws.Range(COL_BID_T1 & r).Value = dic(nem)
        Else
            ws.Range(COL_BID_T1 & r).ClearContents
            faltan = faltan & nem & " "
        End If
        r = r + 1
    Loop

    If faltan <> "" Then
        MsgBox "Sin BID en SQL para: " & faltan, vbExclamation
    End If
    Exit Sub

Fallo:
    Dim msg As String: msg = Err.Description
    On Error Resume Next
    cn.Close
    MsgBox "No se pudo traer el BID de T-1." & vbCrLf & msg, vbCritical
End Sub













Option Explicit

' ====== AJUSTAR ESTOS DATOS ======
Const SERVIDOR As String = "NOMBRE_DEL_SERVIDOR"
Const BASE_DATOS As String = "SBP_RGTRABAJO"
Const TABLA As String = "dbo.NOMBRE_DE_LA_TABLA"
Const HOJA As String = "RF2"
Const CELDA_FECHA As String = "W22"
Const FILA_INI As Long = 7
Const COL_SOBERANO As String = "AF"
Const COL_BID As String = "AG"
Const COL_ASK As String = "AH"
Const COL_LAST As String = "AI"
Const INCLUIR_FILA_VACIA As Boolean = True
' =================================

Sub SubirTasasSQL()
    Dim ws As Worksheet: Set ws = ThisWorkbook.Worksheets(HOJA)
    Dim fecha As Date
    fecha = CDate(ws.Range(CELDA_FECHA).Value)
    Dim fTxt As String: fTxt = Format(fecha, "yyyymmdd")

    ' Leer la tabla de la hoja
    Dim nem(1 To 60) As String, bid(1 To 60) As Variant
    Dim ask(1 To 60) As Variant, lst(1 To 60) As Variant
    Dim n As Long, r As Long
    If INCLUIR_FILA_VACIA Then
        n = 1
        nem(1) = "SB00ENE1900": bid(1) = Null: ask(1) = Null: lst(1) = Null
    End If
    For r = FILA_INI To FILA_INI + 50
        If Trim(ws.Range(COL_SOBERANO & r).Value & "") = "" Then Exit For
        n = n + 1
        nem(n) = Nemonico(ws.Range(COL_SOBERANO & r).Value)
        bid(n) = ValorONulo(ws.Range(COL_BID & r).Value)
        ask(n) = ValorONulo(ws.Range(COL_ASK & r).Value)
        lst(n) = ValorONulo(ws.Range(COL_LAST & r).Value)
    Next r
    If n = 0 Then MsgBox "No se encontraron datos en " & HOJA, vbExclamation: Exit Sub

    ' Conexion (el separador de la cadena se arma con Chr(59))
    Dim sep As String: sep = Chr(59)
    Dim cs As String
    cs = "Provider=SQLOLEDB" & sep & "Data Source=" & SERVIDOR & sep & _
         "Initial Catalog=" & BASE_DATOS & sep & "Integrated Security=SSPI"

    Dim cn As Object: Set cn = CreateObject("ADODB.Connection")
    Dim cmd As Object, rs As Object
    Dim colNem As String: colNem = "[Nem" & ChrW(243) & "nico]"
    Dim enTrans As Boolean

    On Error GoTo Fallo
    cn.Open cs

    ' Revisar si ya hay datos de esa fecha
    Set rs = cn.Execute("SELECT COUNT(*) FROM " & TABLA & " WHERE Fecha = '" & fTxt & "'")
    If rs.Fields(0).Value > 0 Then
        If MsgBox("Ya existen " & rs.Fields(0).Value & " filas del " & Format(fecha, "dd/mm/yyyy") & _
                  ". Quieres reemplazarlas?", vbYesNo + vbQuestion) = vbNo Then
            cn.Close: Exit Sub
        End If
    End If
    rs.Close

    cn.BeginTrans: enTrans = True
    cn.Execute "DELETE FROM " & TABLA & " WHERE Fecha = '" & fTxt & "'"

    Set cmd = CreateObject("ADODB.Command")
    Set cmd.ActiveConnection = cn
    cmd.CommandText = "INSERT INTO " & TABLA & " (Fecha, " & colNem & ", BID, ASK, [LAST]) VALUES (?,?,?,?,?)"
    cmd.Parameters.Append cmd.CreateParameter("f", 200, 1, 8)
    cmd.Parameters.Append cmd.CreateParameter("n", 200, 1, 20)
    cmd.Parameters.Append cmd.CreateParameter("b", 5, 1)
    cmd.Parameters.Append cmd.CreateParameter("a", 5, 1)
    cmd.Parameters.Append cmd.CreateParameter("l", 5, 1)

    Dim i As Long
    For i = 1 To n
        cmd.Parameters(0).Value = fTxt
        cmd.Parameters(1).Value = nem(i)
        cmd.Parameters(2).Value = bid(i)
        cmd.Parameters(3).Value = ask(i)
        cmd.Parameters(4).Value = lst(i)
        cmd.Execute
    Next i

    cn.CommitTrans: enTrans = False
    cn.Close
    MsgBox "Se subieron " & n & " filas del " & Format(fecha, "dd/mm/yyyy") & " a " & TABLA, vbInformation
    Exit Sub

Fallo:
    Dim msg As String: msg = Err.Description
    On Error Resume Next
    If enTrans Then cn.RollbackTrans
    cn.Close
    MsgBox "No se pudo subir. No se guardo nada." & vbCrLf & msg, vbCritical
End Sub

Private Function ValorONulo(v As Variant) As Variant
    If IsError(v) Then
        ValorONulo = Null
    ElseIf IsEmpty(v) Or Trim(v & "") = "" Then
        ValorONulo = Null
    ElseIf IsNumeric(v) Then
        ValorONulo = CDbl(v)
    Else
        ValorONulo = Null
    End If
End Function

Private Function Nemonico(v As Variant) As String
    Dim meses As Variant
    meses = Array("ENE", "FEB", "MAR", "ABR", "MAY", "JUN", "JUL", "AGO", "SET", "OCT", "NOV", "DIC")
    Dim d As Long, m As String, a As Long, p() As String
    If IsDate(v) And VarType(v) = vbDate Then
        d = Day(v): m = meses(Month(v) - 1): a = Year(v)
    ElseIf IsNumeric(v) Then
        d = Day(CDate(v)): m = meses(Month(CDate(v)) - 1): a = Year(CDate(v))
    Else
        p = Split(Trim(v), "-")
        d = Val(p(0)): m = UCase(Left(p(1), 3)): a = Val(p(2))
        If a < 100 Then a = 2000 + a
    End If
    Nemonico = "SB" & Format(d, "00") & m & a
End Function












