    # ----- ventana en curso: solo informativa -----
    if en_curso:
        if problemas:
            print(f"{AMARILLO}[{hora}] {rango} (EN CURSO) -> incompleta aun ({total} filas, {len(problemas)} pendientes){FIN}")
            registrar(rango, tipo_ventana, "INCOMPLETA", total, n_vences, problemas)
        else:
            print(f"{VERDE}[{hora}] {rango} (EN CURSO) -> completa ({n_vences} vences, {total} filas){FIN}")
            registrar(rango, tipo_ventana, "OK", total, n_vences, [])
        return

    # ----- ventana cerrada: alerta con beep solo si el problema es nuevo o cambia -----
    previo = estados.get(rango)
    actual = frozenset(problemas)
    estados[rango] = actual

    if problemas:
        sigue = " (sigue)" if previo == actual else ""
        print(f"{ROJO}[{hora}] {rango} (CERRADA) -> ALERTA{sigue}: {len(problemas)} problemas, {total} filas{FIN}")
        for p in problemas:
            print(f"{ROJO}    - {p}{FIN}")
        registrar(rango, tipo_ventana, "ALERTA", total, n_vences, problemas)
        if previo != actual:
            alarma()
    else:
        if previo:
            print(f"{VERDE}[{hora}] {rango} (CERRADA) -> REGULARIZADO ({n_vences} vences, {total} filas){FIN}")
            registrar(rango, tipo_ventana, "REGULARIZADO", total, n_vences, [])
        else:
            print(f"{VERDE}[{hora}] {rango} (CERRADA) -> OK ({n_vences} vences, {total} filas){FIN}")
            registrar(rango, tipo_ventana, "OK", total, n_vences, [])


def main():
    una_vez = "--una-vez" in sys.argv
    modo = "solo posturas validas (Yield y Notional no NULL)" if SOLO_VALIDAS else "solo existencia de fila"
    print(f"Monitor iniciado: revision cada {REVISION_MIN} min, ventanas de {VENTANA_MIN} min. Criterio: {modo}")

    estados = {}
    proxima = datetime.now()
    while True:
        ahora = datetime.now()
        if ahora >= proxima:
            ini = inicio_ventana(ahora)
            transcurrido = (ahora - ini).total_seconds()
            # ultima ventana ya cerrada (con el margen de gracia)
            cerrada = ini - timedelta(minutes=VENTANA_MIN if transcurrido >= GRACIA_SEG else 2 * VENTANA_MIN)

            if en_horario(cerrada):
                revisar(cerrada, estados)
            if EVALUAR_EN_CURSO and en_horario(ini):
                revisar(ini, estados, en_curso=True)

            proxima = ahora + timedelta(minutes=REVISION_MIN)
            if una_vez:
                return
        time.sleep(REFRESCO_SEG)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("Monitor detenido")
