        we = wb.create_sheet("Eventos")
        we.append(encabezado)
    else:
        we = wb["Eventos"]

    existentes_correo = {}
    existentes_persona = set()
    for r in we.iter_rows(min_row=2, values_only=True):
        r = list(r) + [None] * 8
        eq, us, fe, ho, pr, it, ti, re = [str(x).strip() if x is not None else "" for x in r[:8]]
        if ti in tipos_correo:
