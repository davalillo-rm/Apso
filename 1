def nombre_corto(codigo):
    return NOMBRES_CORREO.get(codigo.lower(), nombre_display(codigo))


def _parse_hora(hora_str):
    for fmt in ("%H:%M:%S", "%H:%M"):
        try:
            return datetime.datetime.strptime(str(hora_str).strip(), fmt).time()
        except ValueError:
            continue
    return None


def _hora_am_pm(hora_str):
    t = _parse_hora(hora_str)
    if not t:
        return str(hora_str)
    return datetime.datetime.combine(datetime.date.today(), t).strftime("%I:%M %p").lstrip("0").lower()


def dia_habil_anterior(fecha):
    d = fecha - datetime.timedelta(days=1)
    while d.weekday() >= 5 or d.strftime("%d/%m/%Y") in FERIADOS:
        d -= datetime.timedelta(days=1)
    return d


def frecuencia_es(txt):
    t = (txt or "").lower()
    if t.startswith(("monthly", "mensual")):
        return "Mensual"
    if t.startswith(("weekly", "semanal")):
        return "Semanal"
    return "Diario"


def leer_procesos_status(codigo):
    ruta = os.path.join(RUTA_BASE, f"{codigo}_status.xlsx")
    procesos = {}
    if not os.path.exists(ruta):
        return procesos
    try:
        wb = openpyxl.load_workbook(ruta, data_only=True, read_only=True)
        ws = wb["Status Actual"] if "Status Actual" in wb.sheetnames else wb.active
        actual = None
        for row in ws.iter_rows(min_row=2, values_only=True):
            fila = list(row) + [None] * 8
            if fila[0]:
                actual = str(fila[0]).strip()
            if not actual:
                continue
            p = procesos.setdefault(actual, {"avance": "", "items": [], "frecuencia": "", "desde": ""})
            if fila[2]:
                p["avance"] = str(fila[2]).strip()
            p["items"].append({"hora": str(fila[4] or "").strip(),
                               "validacion": str(fila[5] or "").strip()})
            if fila[6]:
                p["frecuencia"] = str(fila[6]).strip()
            if fila[7]:
                p["desde"] = str(fila[7]).strip()
        wb.close()
    except Exception as e:
        print(f"Error leyendo status de {codigo}: {e}")
    return procesos


def armar_filas_status(codigos, eventos_por_usuario, hoy_str):
    hoy = datetime.datetime.strptime(hoy_str, "%d/%m/%Y").date()
    filas = []
    for codigo in codigos:
        eventos = eventos_por_usuario.get(codigo, [])
        for nombre, p in leer_procesos_status(codigo).items():
            n_rec = sum(1 for e in eventos
                        if e.get("fecha") == hoy_str and e.get("proceso") == nombre
                        and e.get("tipo") == "RECORDATORIO ENVIADO")

            completo = False
            if "/" in p["avance"]:
                a = p["avance"].split("/")[0].strip()
                b = p["avance"].split("/")[-1].strip()
                completo = (a == b and b not in ("", "0"))
            observado = any(i["validacion"].upper() == "OBSERVADO" for i in p["items"])
            horas = [i["hora"] for i in p["items"] if _parse_hora(i["hora"])]

            if observado:
                status = "Observado"
            elif completo:
                status = "Enviado"
            elif n_rec > 0:
                status = "Esperando Envío"
            else:
                status = "Pendiente"

            hora = "-"
            if horas and status in ("Enviado", "Observado"):
                hora = _parse_hora(max(horas, key=_parse_hora)).strftime("%H:%M")

            frec = frecuencia_es(p["frecuencia"])
            recordatorios = str(n_rec)
            if frec == "Mensual" and status == "Pendiente" and p["desde"]:
                try:
                    if datetime.datetime.strptime(p["desde"], "%d/%m/%Y").date() > hoy:
                        recordatorios = f"Se enviarán a partir del {p['desde']}"
                except ValueError:
                    pass

            filas.append({"frecuencia": frec, "reporte": nombre, "status": status,
                          "hora": hora, "recordatorios": recordatorios,
                          "responsable": nombre_corto(codigo)})
    return filas


