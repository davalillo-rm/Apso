def inicializar_excel():
    if os.path.exists(EXCEL_FILE): return
    wb = Workbook()
    
    ws1 = wb.active
    ws1.title = "Procesos"
    ws1.append(["Nombre Proceso", "Frecuencia", "Valor_Tiempo", "Activa"])
    ws1.column_dimensions["A"].width, ws1.column_dimensions["B"].width, ws1.column_dimensions["C"].width = 30, 20, 35
    
    ws2 = wb.create_sheet("Items_Esperados")
    # --- NUEVA ESTRUCTURA DE 8 COLUMNAS ---
    ws2.append(["Proceso_Padre", "Nombre_Item", "Remitente", "Remitente_Alterno", "Asunto", "Validar_Solicitud", "Forzado_Fecha", "Ignorados"])
    for col in ["A", "B", "C", "D", "E"]: ws2.column_dimensions[col].width = 35
    
    wb.save(EXCEL_FILE)

def leer_items_de_proceso(nombre_proceso):
    if not os.path.exists(EXCEL_FILE): return []
    wb = openpyxl.load_workbook(EXCEL_FILE)
    if "Items_Esperados" not in wb.sheetnames: return []
    ws = wb["Items_Esperados"]
    items = []
    for row in ws.iter_rows(min_row=2, values_only=True):
        if row[0] == nombre_proceso:
            items.append({
                "nombre": row[1],
                "remitente": row[2] if row[2] else "",
                "remitente_alterno": row[3] if len(row) > 3 and row[3] else "",
                "asunto": row[4] if len(row) > 4 and row[4] else "",
                "validar_sol": str(row[5]).lower() == "true" if len(row) > 5 else False,
                "forzado_fecha": row[6] if len(row) > 6 and row[6] else ""
            })
    return items

def guardar_item(nombre_proceso, nombre_item, remitente, remitente_alt, asunto, validar_sol, forzado=""):
    wb = openpyxl.load_workbook(EXCEL_FILE)
    ws = wb["Items_Esperados"]
    ws.append([nombre_proceso, nombre_item, remitente, remitente_alt, asunto, str(validar_sol), forzado, ""])
    wb.save(EXCEL_FILE)

def forzar_item_excel(proceso, nombre_item, fecha_str):
    wb = openpyxl.load_workbook(EXCEL_FILE)
    ws = wb["Items_Esperados"]
    for row in ws.iter_rows(min_row=2):
        if row[0].value == proceso and row[1].value == nombre_item:
            row[6].value = fecha_str # Columna G (Forzado_Fecha)
            break
    wb.save(EXCEL_FILE)












