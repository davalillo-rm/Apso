Sub CargarReporteSQL()
    Dim conn As Object
    Dim cmd As Object
    Dim ws As Worksheet
    Dim lastRow As Long
    Dim i As Long
    
    ' Variables para SQL
    Dim sqlColumns As String
    Dim sqlValues As String
    Dim sqlDelete As String
    Dim fechaProceso As String
    Dim limiteDesc As String
    Dim limiteGrupo As String
    Dim valorUso As String
    Dim columnaDestino As String
    
    Set ws = ThisWorkbook.Sheets("Recopilado")
    lastRow = 40 ' Ajustado a tu bloque de datos
    
    ' 1. Conexión Real extraída de tu macro antigua
    Set conn = CreateObject("ADODB.Connection")
    conn.ConnectionString = "Provider=sqloledb;Server=pepgviprlds9672.PER.BNS\SQL1,275;Database=SBP_RGTRABAJO;Trusted_Connection=yes;"
    
    On Error GoTo ErrorHandler
    conn.Open
    Set cmd = CreateObject("ADODB.Command")
    Set cmd.ActiveConnection = conn
    
    ' 2. Capturar la fecha de proceso
    fechaProceso = Format(ws.Cells(2, "A").Value, "YYYY-MM-DD")
    
    ' 3. ESCUDO: Eliminar registros de la misma fecha para evitar duplicados
    sqlDelete = "DELETE FROM dbo.limit_Report WHERE Fecha = '" & fechaProceso & "'"
    cmd.CommandText = sqlDelete
    cmd.Execute
    
    ' Inicializamos el INSERT
    sqlColumns = "[Fecha]"
    sqlValues = "'" & fechaProceso & "'"
    
    ' 4. Recorrer y Mapear la hoja Recopilado
    For i = 2 To lastRow
        limiteGrupo = Trim(ws.Cells(i, "D").Value)
        limiteDesc = Trim(ws.Cells(i, "E").Value)
        
        valorUso = Replace(CStr(ws.Cells(i, "G").Value), ",", ".")
        If valorUso = "" Or Not IsNumeric(valorUso) Then valorUso = "0"
        
        columnaDestino = MapearColumnaSQL(limiteGrupo, limiteDesc)
        
        If columnaDestino <> "" Then
            sqlColumns = sqlColumns & ", [" & columnaDestino & "]"
            sqlValues = sqlValues & ", " & valorUso
        End If
    Next i
    
    ' 5. Inyectar el Delta_FX si es que lo manejas en la hoja (Opcional, lo vi en tu código viejo)
    ' Si lo tienes en alguna celda, actívalo. Si no, ignora esta parte.
    ' sqlColumns = sqlColumns & ", [Delta_FX]"
    ' sqlValues = sqlValues & ", 0" 
    
    ' 6. Ejecutar el INSERT final
    Dim query As String
    query = "INSERT INTO dbo.limit_Report (" & sqlColumns & ") VALUES (" & sqlValues & ");"
    
    cmd.CommandText = query
    cmd.Execute
    
    MsgBox "Datos subidos correctamente a SQL con fecha " & Format(ws.Cells(2, "A").Value, "dd-mm-yyyy"), vbInformation, "Carga Exitosa"
    
    conn.Close
    Set conn = Nothing
    Exit Sub

ErrorHandler:
    MsgBox "Error en SQL Server: " & Err.Description, vbCritical, "Error"
    If conn.State = 1 Then conn.Close
    Set conn = Nothing
End Sub

' === DICCIONARIO ACTUALIZADO CON TUS NOMBRES REALES ===
Function MapearColumnaSQL(grupo As String, desc As String) As String
    Select Case desc
        ' Portafolio
        Case "Overall Portfolio": MapearColumnaSQL = "Overall_Portfolio_Limit"
        Case "Central Bank Securities Limit": MapearColumnaSQL = "Central_Bank_CDs"
        Case "Short Positions Limit": MapearColumnaSQL = "Short_Positions"
        Case "USD Treasury Bonds Limit": MapearColumnaSQL = "USD_Treasury_Bonds"
        Case "USD-Denominated LATAM Bonds Limit": MapearColumnaSQL = "USD_Sovereign_LATAM_Bonds"
        Case "USD-Denominated Peruvian Bonds Limit": MapearColumnaSQL = "USD_Sovereign_Peruvian_Bonds"
        Case "Corporate Local Bonds - Intermediation per leg per day": MapearColumnaSQL = "Corporate_Local_Bonds_Intermediation_per_leg_per_day"
        Case "Inflation-Linked Peruvian Bonds": MapearColumnaSQL = "Inflation_Linked_Peruvian_Bonds"
        Case "PEN Denominated Mi Vivienda Bonds Limit": MapearColumnaSQL = "PEN_Mivivienda_Corporate_Bonds_Limit"
        
        ' Fixing Risk
        Case "Fixing Risk Limit": MapearColumnaSQL = "Fixing_Risk_Limit"
        
        ' Spot Overnight NTP
        Case "All Currencies Combined": MapearColumnaSQL = "Peru_GBM_Overnight_NTP_All_Currencies_Combined"
        Case "CAD, EUR, JPY Limit": MapearColumnaSQL = "Peru_GBM_Overnight_NTP_CAD_EUR_JPY_Limit"
        Case "GBP, AUD, CHF, DKK, NZD Limit": MapearColumnaSQL = "Peru_GBM_Overnight_NTP_GBP_AUD_CHF_DKK_NZD_Limit"
        Case "USD Limit": MapearColumnaSQL = "Peru_GBM_Overnight_NTP_USD_Limit"
        
        ' Stress Test y VaR
        Case "Stress Test EWI": MapearColumnaSQL = "Peru_GBM_Overnight_Total_StressTest_EWI"
        Case "Stress Test Limit": MapearColumnaSQL = "Peru_GBM_Overnight_Total_StressTest_Limit"
        Case "Total VaR EWI": MapearColumnaSQL = "Peru_GBM_Overnight_Total_VaR_EWI"
        Case "Total VaR Limit": MapearColumnaSQL = "Peru_GBM_Overnight_Total_VaR_Limit"
        
        ' Curvas (Los nombres "raros" arreglados)
        Case "Parallel"
            If grupo = "PEN" Then MapearColumnaSQL = "Interest_Rate_Sensitivity_Limit_PEN_Parallel"
            If grupo = "USD" Then MapearColumnaSQL = "Interest_Rate_Sensitivity_Limit_USD_Parallel"
            If grupo = "Basis" Then MapearColumnaSQL = "Basis_Risk_Limits_USD_PEN_Parallel"
            
        Case "0 to 3 months"
            If grupo = "Basis" Then MapearColumnaSQL = "Basis_Risk_Limits_USD_PEN_0_3"
        Case "3 to 6 months"
            If grupo = "Basis" Then MapearColumnaSQL = "Basis_Risk_Limits_USD_PEN_3_6"
        Case "6 to 12 months"
            If grupo = "Basis" Then MapearColumnaSQL = "Basis_Risk_Limits_USD_PEN_6_1"
        Case "1 to 2 years"
            If grupo = "Basis" Then MapearColumnaSQL = "Basis_Risk_Limits_USD_PEN_1_2"
        Case "2 to 5 years"
            If grupo = "Basis" Then MapearColumnaSQL = "Basis_Risk_Limits_USD_PEN_2_10"
        Case "5 to 10 years"
            If grupo = "Basis" Then MapearColumnaSQL = "Basis_Risk_Limits_USD_PEN_5_10"
        Case "10 to 12.5 years"
            If grupo = "Basis" Then MapearColumnaSQL = "Basis_Risk_Limits_USD_PEN_10_12"

        Case "0 years to 1 years"
            If grupo = "USD" Then MapearColumnaSQL = "Interest_Rate_Sensitivity_Limit_USD_0_1"
        Case "1 years to 5 years"
            If grupo = "PEN" Then MapearColumnaSQL = "Interest_Rate_Sensitivity_Limit_PEN_1_5"
            If grupo = "USD" Then MapearColumnaSQL = "Interest_Rate_Sensitivity_Limit_USD_1_5"
        Case "5 years to 10 years"
            If grupo = "PEN" Then MapearColumnaSQL = "Interest_Rate_Sensitivity_Limit_PEN_5_10"
            If grupo = "USD" Then MapearColumnaSQL = "Interest_Rate_Sensitivity_Limit_USD_5_10"
        Case "10 years to 20 years"
            If grupo = "PEN" Then MapearColumnaSQL = "Interest_Rate_Sensitivity_Limit_PEN_10_20"
            If grupo = "USD" Then MapearColumnaSQL = "Interest_Rate_Sensitivity_Limit_USD_10_20"
        Case "20 years to 30 years"
            If grupo = "PEN" Then MapearColumnaSQL = "Interest_Rate_Sensitivity_Limit_PEN_20_30"
            If grupo = "USD" Then MapearColumnaSQL = "Interest_Rate_Sensitivity_Limit_USD_20_30"

        Case Else: MapearColumnaSQL = ""
    End Select
End Function
