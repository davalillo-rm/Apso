def leer_procesos():
    if not os.path.exists(EXCEL_FILE):
        return []
    
    wb = openpyxl.load_workbook(EXCEL_FILE)
    ws = wb["Procesos"]
    procesos = []
    
    # Empezamos en la fila 2 para saltar el encabezado
    for row in ws.iter_rows(min_row=2, values_only=True):
        if row[0]: # Si hay nombre del proceso
            procesos.append({
                "nombre": row[0],
                "frecuencia": row[1],
                "valor_tiempo": row[2],
                "solicitud": row[3] if len(row) > 3 else "" # <--- Captura la Columna D
            })
    return procesos



