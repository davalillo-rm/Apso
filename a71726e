SELECT 
    [Fecha de envio],
    [Plazo],
    [CURVA SOFR],
    [PEN PASIVO],
    [PEN ACTIVO],
    [USD PASIVO],
    [USD ACTIVO]
FROM [RMERCADO].[Informacion_Historica_TTs]
WHERE 
    (TRY_CAST([Plazo] AS INT) IS NULL AND [Plazo] IS NOT NULL AND LTRIM(RTRIM([Plazo])) <> '') OR
    (TRY_CAST([CURVA SOFR] AS FLOAT) IS NULL AND [CURVA SOFR] IS NOT NULL AND LTRIM(RTRIM([CURVA SOFR])) <> '') OR
    (TRY_CAST([PEN PASIVO] AS FLOAT) IS NULL AND [PEN PASIVO] IS NOT NULL AND LTRIM(RTRIM([PEN PASIVO])) <> '') OR
    (TRY_CAST([PEN ACTIVO] AS FLOAT) IS NULL AND [PEN ACTIVO] IS NOT NULL AND LTRIM(RTRIM([PEN ACTIVO])) <> '') OR
    (TRY_CAST([USD PASIVO] AS FLOAT) IS NULL AND [USD PASIVO] IS NOT NULL AND LTRIM(RTRIM([USD PASIVO])) <> '') OR
    (TRY_CAST([USD ACTIVO] AS FLOAT) IS NULL AND [USD ACTIVO] IS NOT NULL AND LTRIM(RTRIM([USD ACTIVO])) <> '');
