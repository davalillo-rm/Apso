def eliminar_proceso_excel(nombre_proceso):
    """Elimina el proceso y todos sus ítems del Excel."""
    if not os.path.exists(EXCEL_FILE): return
    wb = openpyxl.load_workbook(EXCEL_FILE)

    # 1. Eliminar de la hoja Procesos
    if "Procesos" in wb.sheetnames:
        ws_p = wb["Procesos"]
        for row in range(ws_p.max_row, 1, -1):
            if ws_p.cell(row=row, column=1).value == nombre_proceso:
                ws_p.delete_rows(row)

    # 2. Eliminar de la hoja Items_Esperados (para que no queden ítems fantasmas)
    if "Items_Esperados" in wb.sheetnames:
        ws_i = wb["Items_Esperados"]
        for row in range(ws_i.max_row, 1, -1):
            if ws_i.cell(row=row, column=1).value == nombre_proceso:
                ws_i.delete_rows(row)

    wb.save(EXCEL_FILE)




