SELECT 
    [Fecha de envio],
    [Plazo 2],
    [Plazo_2],
    TRY_CAST([Plazo] AS INT) AS [Plazo],
    TRY_CAST([CURVA SOFR] AS FLOAT) AS [CURVA SOFR],
    TRY_CAST([PEN PASIVO] AS FLOAT) AS [PEN PASIVO],
    TRY_CAST([PEN ACTIVO] AS FLOAT) AS [PEN ACTIVO],
    TRY_CAST([USD PASIVO] AS FLOAT) AS [USD PASIVO],
    TRY_CAST([USD ACTIVO] AS FLOAT) AS [USD ACTIVO]
FROM [RMERCADO].[Informacion_Historica_TTs];
