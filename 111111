DECLARE @FEC INT = 20260725;

WITH HIST_ULTIMO AS (
    SELECT CUENTA, NOMBRE
    FROM (
        SELECT CUENTA, NOMBRE, FECHA,
               ROW_NUMBER() OVER (PARTITION BY CUENTA ORDER BY FECHA DESC) AS RN
        FROM SBP_RGTRABAJO.dbo.SBP_HISTORICO_DEPOSITANTES
    ) x
    WHERE RN = 1
),

-- <<< CAMBIO 1: lista centralizada de cuentas a reclasificar
RECLAS_CTS AS (
    SELECT CTA FROM (VALUES (322089985), (8051365), (1348003)) AS X(CTA)
),

FORZADAS AS (
    SELECT CTA, MON FROM (VALUES
        (322089985, 'USD'),
        (8051365,   'USD'),
        (1348003,   'USD')
    ) AS X(CTA, MON)
),

VISTA AS (
    SELECT CONVERT(date, CONVERT(char(8), VND10FEC), 112) AS FECHA,
           VND10CTA AS CUENTA,
           CASE WHEN VND10MDA = 0 THEN 'PEN' ELSE 'USD' END AS MONEDA,
           SUM(VND10SDOO) AS VISTA,
           SUM(VND10SDOO * VND10TASA) / NULLIF(SUM(VND10SDOO),0) AS TASA_VISTA
    FROM [SBP_RGHISTORICA].[dbo].[BLPRNJBT_LVND10]
    WHERE VND10FEC = @FEC AND VND10ENT = 1 AND VND10MDA IN (0,1)
      AND LEFT(VND10RUB,4) IN ('2111','2121','2311','2321')
    GROUP BY CONVERT(date, CONVERT(char(8), VND10FEC), 112), VND10CTA,
             CASE WHEN VND10MDA = 0 THEN 'PEN' ELSE 'USD' END
),

AHORRO AS (
    SELECT CONVERT(date, CONVERT(char(8), VND10FEC), 112) AS FECHA,
           VND10CTA AS CUENTA,
           CASE WHEN VND10MDA = 0 THEN 'PEN' ELSE 'USD' END AS MONEDA,
           SUM(VND10SDOO) AS AHORRO,
           SUM(VND10SDOO * VND10TASA) / NULLIF(SUM(VND10SDOO),0) AS TASA_AHORRO
    FROM [SBP_RGHISTORICA].[dbo].[BLPRNJBT_LVND10]
    WHERE VND10FEC = @FEC AND VND10ENT = 1 AND VND10MDA IN (0,1)
      AND LEFT(VND10RUB,4) IN ('2112','2122','2312','2322')
    GROUP BY CONVERT(date, CONVERT(char(8), VND10FEC), 112), VND10CTA,
             CASE WHEN VND10MDA = 0 THEN 'PEN' ELSE 'USD' END
),

PLAZO AS (
    SELECT CONVERT(date, CONVERT(char(8), VND10FEC), 112) AS FECHA,
           VND10CTA AS CUENTA,
           CASE WHEN VND10MDA = 0 THEN 'PEN' ELSE 'USD' END AS MONEDA,
           SUM(VND10SDOO) AS PLAZO,
           SUM(VND10SDOO * VND10TASA) / NULLIF(SUM(VND10SDOO),0) AS TASA_PLAZO
    FROM [SBP_RGHISTORICA].[dbo].[BLPRNJBT_LVND10]
    WHERE VND10FEC = @FEC AND VND10ENT = 1 AND VND10MDA IN (0,1)
      AND LEFT(VND10RUB,4) IN ('2113','2123','2313','2323')
      -- <<< CAMBIO 2: excluye CTS salvo para las cuentas reclasificadas
      AND (LEFT(VND10RUB,6) NOT IN ('211305','212305')
           OR VND10CTA IN (SELECT CTA FROM RECLAS_CTS))
    GROUP BY CONVERT(date, CONVERT(char(8), VND10FEC), 112), VND10CTA,
             CASE WHEN VND10MDA = 0 THEN 'PEN' ELSE 'USD' END
),

CTS AS (
    SELECT CONVERT(date, CONVERT(char(8), VND10FEC), 112) AS FECHA,
           VND10CTA AS CUENTA,
           CASE WHEN VND10MDA = 0 THEN 'PEN' ELSE 'USD' END AS MONEDA,
           SUM(VND10SDOO) AS CTS
    FROM [SBP_RGHISTORICA].[dbo].[BLPRNJBT_LVND10]
    WHERE VND10FEC = @FEC AND VND10ENT = 1 AND VND10MDA IN (0,1)
      AND LEFT(VND10RUB,6) IN ('211305','212305')
      -- <<< CAMBIO 3: estas cuentas ya no reportan CTS
      AND VND10CTA NOT IN (SELECT CTA FROM RECLAS_CTS)
    GROUP BY CONVERT(date, CONVERT(char(8), VND10FEC), 112), VND10CTA,
             CASE WHEN VND10MDA = 0 THEN 'PEN' ELSE 'USD' END
),

UNION_DATA AS (
    SELECT
        COALESCE(V.FECHA,  A.FECHA,  P.FECHA,  C.FECHA)  AS FECHA,
        COALESCE(V.CUENTA, A.CUENTA, P.CUENTA, C.CUENTA) AS CUENTA,
        COALESCE(V.MONEDA, A.MONEDA, P.MONEDA, C.MONEDA) AS MONEDA,
        ISNULL(C.CTS,0)         AS CTS,
        ISNULL(V.VISTA,0)       AS VISTA,
        ISNULL(V.TASA_VISTA,0)  AS TASA_VISTA,
        ISNULL(A.AHORRO,0)      AS AHORRO,
        ISNULL(A.TASA_AHORRO,0) AS TASA_AHORRO,
        ISNULL(P.PLAZO,0)       AS PLAZO,
        ISNULL(P.TASA_PLAZO,0)  AS TASA_PLAZO,
        (ISNULL(V.VISTA,0)+ISNULL(A.AHORRO,0)+ISNULL(P.PLAZO,0)+ISNULL(C.CTS,0)) AS TOTAL
    FROM VISTA V
    FULL OUTER JOIN AHORRO A
        ON V.FECHA=A.FECHA AND V.CUENTA=A.CUENTA AND V.MONEDA=A.MONEDA
    FULL OUTER JOIN PLAZO P
        ON COALESCE(V.FECHA,A.FECHA)=P.FECHA
       AND COALESCE(V.CUENTA,A.CUENTA)=P.CUENTA
       AND COALESCE(V.MONEDA,A.MONEDA)=P.MONEDA
    FULL OUTER JOIN CTS C
        ON COALESCE(V.FECHA,A.FECHA,P.FECHA)=C.FECHA
       AND COALESCE(V.CUENTA,A.CUENTA,P.CUENTA)=C.CUENTA
       AND COALESCE(V.MONEDA,A.MONEDA,P.MONEDA)=C.MONEDA
),

RANKEADO AS (
    SELECT U.*,
           ROW_NUMBER() OVER (PARTITION BY U.MONEDA ORDER BY U.TOTAL DESC) AS RANKING
    FROM UNION_DATA U
),

UNIVERSO AS (
    SELECT CUENTA, MONEDA FROM RANKEADO WHERE RANKING <= 120
    UNION
    SELECT CTA, MON FROM FORZADAS
)

INSERT INTO SBP_RGTRABAJO.dbo.SBP_HISTORICO_DEPOSITANTES
    (FECHA, MONEDA, CUENTA, NOMBRE, CTS, VISTA, TASA_VISTA, AHORRO, TASA_AHORRO, PLAZO, TASA_PLAZO, TOTAL)
SELECT
    CONVERT(date, CONVERT(char(8), @FEC), 112),
    UN.MONEDA,
    UN.CUENTA,
    HU.NOMBRE,
    ISNULL(R.CTS,0),
    ISNULL(R.VISTA,0),
    ISNULL(R.TASA_VISTA,0),
    ISNULL(R.AHORRO,0),
    ISNULL(R.TASA_AHORRO,0),
    ISNULL(R.PLAZO,0),
    ISNULL(R.TASA_PLAZO,0),
    ISNULL(R.TOTAL,0)
FROM UNIVERSO UN
LEFT JOIN RANKEADO R
    ON R.CUENTA = UN.CUENTA AND R.MONEDA = UN.MONEDA
LEFT JOIN HIST_ULTIMO HU
    ON HU.CUENTA = UN.CUENTA
WHERE NOT EXISTS (
    SELECT 1
    FROM SBP_RGTRABAJO.dbo.SBP_HISTORICO_DEPOSITANTES T
    WHERE T.FECHA  = CONVERT(date, CONVERT(char(8), @FEC), 112)
      AND T.CUENTA = UN.CUENTA
      AND T.MONEDA = UN.MONEDA
);









