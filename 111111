def buscar_contactos_outlook(query: str) -> list:
    if not _cache_listo:
        return [{"nombre": "⏳ Loading contacts...", "email": ""}]
    if not _cache_gal:
        return []
    q = query.lower()
    return [c for c in _cache_gal 
            if q in c["nombre"].lower() or q in c["email"].lower()][:6]


