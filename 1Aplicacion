def cargar_items_con_ignorados():
    """
    Lee UNA SOLA VEZ todo el Excel de reglas y arma un diccionario:
    { "NombreProceso": [ {item1 con su lista de ignorados ya incluida}, {item2...} ] }
    Reemplaza las llamadas repetidas a leer_items_de_proceso() y
    leer_ignorados_excel() que abrían el archivo por cada item.
    """
    inicializar_excel()
    resultado = {}
    if not os.path.exists(EXCEL_FILE):
        return resultado
    wb = openpyxl.load_workbook(EXCEL_FILE)
    if "Items_Esperados" not in wb.sheetnames:
        return resultado
    ws = wb["Items_Esperados"]
    ignorados_col = 5  # misma columna que usaba leer_ignorados_excel

    for raw in ws.iter_rows(min_row=2, values_only=True):
        row = _normalizar_fila(raw, max(8, ignorados_col))
        if not row[0]:
            continue
        proceso_padre = row[0]
        val_ignorados = row[ignorados_col - 1] or ""
        item = {
            "nombre": row[1],
            "remitente": row[2] if row[2] else "",
            "remitente_alterno": row[3] if row[3] else "",
            "asunto": row[4] if row[4] else "",
            "validar_sol": str(row[5]).lower() == "true" if row[5] else False,
            "forzado_fecha": row[6] if row[6] else "",
            "ignorados": [x for x in str(val_ignorados).split("|") if x],
        }
        resultado.setdefault(proceso_padre, []).append(item)

    return resultado