Total_Vencimientos_Matriz = 
VAR _SegmentoActual = SELECTEDVALUE(Estructura_Vencimientos[Segmento])
VAR _MedidaActual = SELECTEDVALUE(Estructura_Vencimientos[Medida])
VAR _MonedaActual = SELECTEDVALUE(Estructura_Vencimientos[Moneda])

VAR _ValorCreditos = 
    CALCULATE(
        [MedidaSeleccionada_CRE],
        KEEPFILTERS( TREATAS( {_MedidaActual}, DIM_TablaMedidas[Medida] ) ),
        KEEPFILTERS( TREATAS( {_MonedaActual}, DIM_MonedaFiltro[Moneda] ) )
    )

VAR _ValorDepositos = 
    CALCULATE(
        [MedidaSeleccionada_DEP],
        KEEPFILTERS( TREATAS( {_MedidaActual}, DIM_TablaMedidas[Medida] ) ),
        KEEPFILTERS( TREATAS( {_MonedaActual}, DIM_MonedaFiltro[Moneda] ) )
    )

RETURN
    SWITCH(
        _SegmentoActual,
        "Créditos", _ValorCreditos,
        "Depósitos", _ValorDepositos
    )
