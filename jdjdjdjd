Sub CargarDatosSQL()
    Dim conn As Object
    Dim rs As Object
    Dim strConn As String
    Dim ws As Worksheet
    Dim i As Long
    
    ' Definir la hoja activa
    Set ws = ActiveSheet
    
    ' Crear los objetos de conexión
    Set conn = CreateObject("ADODB.Connection")
    Set rs = CreateObject("ADODB.Recordset")
    
    ' ========================================================================
    ' CONFIGURACIÓN DE CONEXIÓN
    ' ========================================================================
    strConn = "Provider=SQLOLEDB;Data Source=TU_SERVIDOR;Initial Catalog=SBP_RGTRABAJO;Integrated Security=SSPI;"
    
    ' Abrir conexión
    On Error GoTo ErrorHandler
    conn.Open strConn
    
    ' Abrir el Recordset
    rs.Open "SELECT * FROM dbo.RF2 WHERE 1=0", conn, 1, 3
    
    ' Empezar a leer desde la fila 2
    i = 2
    
    ' Bucle hasta que la columna A (Hora) esté vacía
    Do While ws.Cells(i, 1).Value <> ""
        rs.AddNew
        
        ' 1. Formatear la HORA (Columna A)
        If IsDate(ws.Cells(i, 1).Value) Then
            rs.Fields("Hora").Value = Format(ws.Cells(i, 1).Value, "hh:mm:ss")
        Else
            rs.Fields("Hora").Value = ws.Cells(i, 1).Text
        End If
        
        rs.Fields("Tit").Value = ws.Cells(i, 2).Value
        rs.Fields("Emis").Value = ws.Cells(i, 3).Value
        rs.Fields("M").Value = ws.Cells(i, 4).Value
        
        ' 2. Formatear las FECHAS (Columnas E y F) al formato universal YYYY-MM-DD
        If IsDate(ws.Cells(i, 5).Value) Then
            rs.Fields("Emision").Value = Format(ws.Cells(i, 5).Value, "yyyy-mm-dd")
        End If
        
        If IsDate(ws.Cells(i, 6).Value) Then
            rs.Fields("Vence").Value = Format(ws.Cells(i, 6).Value, "yyyy-mm-dd")
        End If
        
        rs.Fields("FV").Value = ws.Cells(i, 7).Value
        rs.Fields("Pl").Value = ws.Cells(i, 8).Value
        rs.Fields("Porc_T").Value = ws.Cells(i, 9).Value
        rs.Fields("Porc_Pre").Value = ws.Cells(i, 10).Value
        rs.Fields("Mo").Value = ws.Cells(i, 11).Value
        rs.Fields("Columna_L").Value = ws.Cells(i, 12).Value
        
        rs.Update
        
        i = i + 1
    Loop
    
    ' Cerrar conexiones
    rs.Close
    conn.Close
    
    ' Limpiar memoria
    Set rs = Nothing
    Set conn = Nothing
    
    MsgBox "Se han cargado " & (i - 2) & " registros exitosamente.", vbInformation, "Proceso Terminado"
    Exit Sub

ErrorHandler:
    MsgBox "Ha ocurrido un error en la fila " & i & ":" & vbCrLf & Err.Description, vbCritical, "Error"
    If Not rs Is Nothing Then
        If rs.State = 1 Then rs.Close
    End If
    If Not conn Is Nothing Then
        If conn.State = 1 Then conn.Close
    End If
End Sub
