def enviar_correo_alerta(self, destinatario: str):
        if not self.ultimo_resultado or "procesos" not in self.ultimo_resultado:
            print("Aún no hay datos sincronizados para enviar alerta.")
            return

        procesos = self.ultimo_resultado["procesos"]
        
        try:
            outlook = win32com.client.Dispatch("Outlook.Application")
            correo = outlook.CreateItem(0)
            correo.To = destinatario
            correo.Subject = "Recordatorio: Estado de Reportes y Conformidades"

            # 1. Cabecera del correo
            html = """
            <html><body style="font-family: 'Segoe UI', Arial, sans-serif; color: #262626; line-height: 1.6;">
            <h2 style="color: #ED0006; border-bottom: 2px solid #ED0006; padding-bottom: 5px;">
                Aviso Automático: Monitor de Reportes
            </h2>
            <p>Se comunica que...</p>
            """

            # 2. Analizar cada proceso
            for p in procesos:
                # Si el proceso está incompleto
                if p["cumplidos"] < p["total"]:
                    html += f"<h3 style='color: #ED0006; margin-top: 20px; margin-bottom: 5px;'>{p['nombre']}: Proceso Incompleto</h3>"
                    html += "<ol style='margin-top: 5px;'>"
                    for f in p["faltantes"]:
                        if f["falta_solicitar"]:
                            html += f"<li>Te falta <b>solicitar</b> a <i>{f['remitente']}</i> el reporte <b>{f['nombre_regla']}</b>.</li>"
                        else:
                            html += f"<li>Te falta <b>{f['nombre_regla']}</b> por parte de <i>{f['remitente']}</i>.</li>"
                    html += "</ol>"

                # Si el proceso está completado
                elif p["cumplidos"] == p["total"] and p["total"] > 0:
                    html += f"<h3 style='color: #008000; margin-top: 20px; margin-bottom: 5px;'>{p['nombre']}: Proceso Completado</h3>"
                    html += "<p style='margin-top: 5px;'>Ya fueron recibidos todos los correos que esperabas recibir relacionados a este reporte. Accede a ellos en tu bandeja.</p>"

            # 3. Firma del correo
            html += """
            <br><p style="font-size: 11px; color: #555555; border-top: 1px solid #ccc; padding-top: 10px;">
            Atentamente,<br><b>Área de Riesgos de Mercado</b><br>Scotiabank Perú<br>
            <i>*Este es un mensaje generado automáticamente por el Monitor de Reportes.*</i>
            </p></body></html>
            """

            correo.HTMLBody = html
            correo.Send()
            print("Súper Correo de Alerta enviado exitosamente.")

        except Exception as e:
            print(f"Error al enviar correo de alerta: {e}")
