Sub CargarDatosSQL()
    Dim conn As Object, rs As Object, ws As Worksheet
    Dim strConn As String, i As Long, fechaProceso As Variant
    
    Set ws = ActiveSheet
    fechaProceso = ws.Range("Q40").Value
    
    If Not IsDate(fechaProceso) Then
        MsgBox "Por favor, pon una fecha válida en Q40 antes de cargar.", vbCritical
        Exit Sub
    End If

    Set conn = CreateObject("ADODB.Connection")
    Set rs = CreateObject("ADODB.Recordset")
    
    strConn = "Provider=SQLOLEDB;Data Source=TU_SERVIDOR;Initial Catalog=SBP_RGTRABAJO;Integrated Security=SSPI;"
    
    On Error GoTo ErrorHandler
    conn.Open strConn
    rs.Open "SELECT * FROM dbo.RF2 WHERE 1=0", conn, 1, 3
    
    i = 2
    Do While ws.Cells(i, 1).Value <> ""
        rs.AddNew
        ' Datos de las columnas A a L
        rs.Fields("Hora").Value = Format(ws.Cells(i, 1).Value, "hh:mm:ss")
        rs.Fields("Tit").Value = ws.Cells(i, 2).Value
        rs.Fields("Emis").Value = ws.Cells(i, 3).Value
        rs.Fields("M").Value = ws.Cells(i, 4).Value
        rs.Fields("Emision").Value = Format(ws.Cells(i, 5).Value, "yyyy-mm-dd")
        rs.Fields("Vence").Value = Format(ws.Cells(i, 6).Value, "yyyy-mm-dd")
        rs.Fields("FV").Value = ws.Cells(i, 7).Value
        rs.Fields("Pl").Value = ws.Cells(i, 8).Value
        rs.Fields("Porc_T").Value = ws.Cells(i, 9).Value
        rs.Fields("Porc_Pre").Value = ws.Cells(i, 10).Value
        rs.Fields("Mo").Value = ws.Cells(i, 11).Value
        rs.Fields("Columna_L").Value = ws.Cells(i, 12).Value
        
        ' GUARDAR LA FECHA DE Q40 EN LA NUEVA COLUMNA
        rs.Fields("Fecha_Carga").Value = Format(fechaProceso, "yyyy-mm-dd")
        
        rs.Update
        i = i + 1
    Loop
    
    MsgBox "Cargados " & (i - 2) & " registros para la fecha de proceso: " & fechaProceso
    
    rs.Close: conn.Close
    Exit Sub
ErrorHandler:
    MsgBox "Error en fila " & i & ": " & Err.Description, vbCritical
End Sub
