                # Buscamos correos desde el Lunes de esta semana
                fecha_limite = hoy - datetime.timedelta(days=dias_desde_lunes) 
                
                # Matemática financiera simple: El límite es el Viernes (día 4)
                # Si hoy es Jueves (3) -> 4 - 3 = 1 día restante
                # Si hoy es Sábado (5) -> 4 - 5 = -1 (Venció ayer)
                dias_restantes = 4 - dias_desde_lunes 
                
