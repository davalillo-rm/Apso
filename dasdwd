                if sem_actual in semanas_activas:
                    evaluar_proceso = True
                    # Toca esta semana: Busca desde el lunes y vence el viernes
                    fecha_limite = hoy - datetime.timedelta(days=dias_desde_lunes)
                    dias_restantes = 4 - dias_desde_lunes 
                else:
                    # Esta semana del mes no toca pedir este reporte
                    evaluar_proceso = False

