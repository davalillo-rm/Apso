def guardar_snapshot_historico(codigo: str, procesos: list):
    """Guarda una foto del estado actual en el historico del usuario."""
    ruta = os.path.join(RUTA_BASE, f"{codigo}_historico.xlsx")
    
    ahora = datetime.datetime.now()
    fecha_str = ahora.strftime("%d/%m/%Y")
    hora_str  = ahora.strftime("%H:%M")
    
    # Cargar o crear el archivo
    if os.path.exists(ruta):
        wb = openpyxl.load_workbook(ruta)
    else:
        wb = openpyxl.Workbook()
        wb.remove(wb.active)
    
    # ── Hoja Snapshots ──
    if "Snapshots" not in wb.sheetnames:
        ws = wb.create_sheet("Snapshots")
        ws.append(["Fecha", "Hora", "Proceso", "Estado", "Avance", "Completados", "Total"])
    else:
        ws = wb["Snapshots"]
    
    for p in procesos:
        ws.append([
            fecha_str,
            hora_str,
            p.get("proceso", ""),
            p.get("estado", ""),
            p.get("avance", ""),
            # Extraer numerador de avance "2/3"
            int(p.get("avance","0/1").split("/")[0]) if "/" in p.get("avance","") else 0,
            int(p.get("avance","0/1").split("/")[1]) if "/" in p.get("avance","") else 0,
        ])
    
    # ── Hoja Eventos ──
    if "Eventos" not in wb.sheetnames:
        we = wb.create_sheet("Eventos")
        we.append(["Fecha", "Hora", "Proceso", "Item", "Tipo", "Remitente"])
    
    wb.save(ruta)


