def _mostrar_historico(self, codigo: str):
    """Muestra panel histórico reemplazando el área de detalle."""
    for w in self.area_detalle.winfo_children():
        w.destroy()
    
    nombre = nombre_display(codigo)
    datos  = leer_historico_usuario(codigo)
    snapshots = datos.get("snapshots", [])
    eventos   = datos.get("eventos",   [])
    
    # ── Header ──
    header = ctk.CTkFrame(self.area_detalle, fg_color=CARD2, height=52, corner_radius=0)
    header.pack(fill="x")
    header.pack_propagate(False)
    
    ctk.CTkButton(
        header, text="← Back",
        width=80, height=28,
        fg_color="transparent",
        hover_color=CARD,
        text_color=SUBTEXTO,
        font=("Trebuchet MS", 11),
        command=lambda: self._seleccionar_usuario(codigo)
    ).pack(side="left", padx=10, pady=10)
    
    ctk.CTkLabel(
        header,
        text=f"📅  Historical Record — {nombre}",
        font=("Georgia", 15, "bold"),
        text_color=TEXTO
    ).pack(side="left", padx=10)
    
    # ── Filtro de mes ──
    meses_disponibles = sorted(set(
        s["fecha"][:7] for s in snapshots if s.get("fecha")
    ), reverse=True)
    
    filtro_frame = ctk.CTkFrame(self.area_detalle, fg_color="transparent")
    filtro_frame.pack(fill="x", padx=18, pady=(10, 0))
    
    ctk.CTkLabel(
        filtro_frame, text="Filter by month:",
        font=("Trebuchet MS", 11), text_color=SUBTEXTO
    ).pack(side="left")
    
    mes_var = ctk.StringVar(value=meses_disponibles[0] if meses_disponibles else "")
    
    combo_mes = ctk.CTkOptionMenu(
        filtro_frame,
        values=meses_disponibles if meses_disponibles else ["No data"],
        variable=mes_var,
        width=160,
        command=lambda m: _refrescar(m)
    )
    combo_mes.pack(side="left", padx=10)
    
    # ── Área scrollable ──
    scroll = ctk.CTkScrollableFrame(
        self.area_detalle,
        fg_color="transparent",
        scrollbar_button_color=BORDE
    )
    scroll.pack(fill="both", expand=True, padx=18, pady=10)
    
    def _refrescar(mes_filtro: str):
        for w in scroll.winfo_children():
            w.destroy()
        
        # Filtrar por mes (formato DD/MM/YYYY → primeros 7 chars son MM/YYYY... 
        # ajustar según formato)
        snaps_mes = [s for s in snapshots if s.get("fecha","")[:7] == mes_filtro]
        eventos_mes = [e for e in eventos   if e.get("fecha","")[:7] == mes_filtro]
        
        if not snaps_mes and not eventos_mes:
            ctk.CTkLabel(
                scroll,
                text="No records found for this month.",
                font=("Trebuchet MS", 13),
                text_color=SUBTEXTO
            ).pack(pady=40)
            return
        
        # ── Sección Snapshots ──
        ctk.CTkLabel(
            scroll,
            text="📊  Status Snapshots",
            font=("Georgia", 13, "bold"),
            text_color=TEXTO
        ).pack(anchor="w", pady=(0, 6))
        
        # Encabezado tabla snapshots
        self._fila_tabla(
            scroll,
            ["DATE", "TIME", "PROCESS", "STATUS", "PROGRESS"],
            es_header=True
        )
        
        # Agrupar snapshots por fecha+hora (un guardado = múltiples procesos)
        from itertools import groupby
        snaps_sorted = sorted(snaps_mes, key=lambda x: (x["fecha"], x["hora"]))
        
        for i, snap in enumerate(snaps_sorted):
            color_estado = (VERDE if "COMPLET" in snap["estado"].upper()
                           else AMARILLO if "PROCESO" in snap["estado"].upper()
                           else SUBTEXTO)
            
            fila = ctk.CTkFrame(
                scroll,
                fg_color=CARD2 if i % 2 == 0 else CARD,
                corner_radius=4, height=30
            )
            fila.pack(fill="x", pady=1)
            fila.pack_propagate(False)
            
            for texto, ancho in zip(
                [snap["fecha"], snap["hora"], snap["proceso"],
                 snap["estado"], snap["avance"]],
                [100, 70, 180, 120, 80]
            ):
                t_color = color_estado if texto == snap["estado"] else TEXTO
                ctk.CTkLabel(
                    fila, text=texto,
                    font=("Trebuchet MS", 10),
                    text_color=t_color,
                    width=ancho, anchor="w",
                    wraplength=ancho - 10
                ).pack(side="left", padx=6, pady=4)
        
        # ── Sección Eventos ──
        if eventos_mes:
            ctk.CTkLabel(
                scroll,
                text="📬  Email Events",
                font=("Georgia", 13, "bold"),
                text_color=TEXTO
            ).pack(anchor="w", pady=(20, 6))
            
            self._fila_tabla(
                scroll,
                ["DATE", "TIME", "PROCESS", "ITEM", "TYPE", "SENDER"],
                es_header=True
            )
            
            for i, ev in enumerate(sorted(eventos_mes,
                                          key=lambda x: (x["fecha"], x["hora"]))):
                color_tipo = (VERDE   if "RECIBIDO" in ev["tipo"].upper()
                             else AZUL if "SOLICITUD" in ev["tipo"].upper()
                             else SUBTEXTO)
                
                fila = ctk.CTkFrame(
                    scroll,
                    fg_color=CARD2 if i % 2 == 0 else CARD,
                    corner_radius=4, height=30
                )
                fila.pack(fill="x", pady=1)
                fila.pack_propagate(False)
                
                for texto, ancho in zip(
                    [ev["fecha"], ev["hora"], ev["proceso"],
                     ev["item"], ev["tipo"], ev["remitente"]],
                    [100, 80, 150, 150, 130, 200]
                ):
                    t_color = color_tipo if texto == ev["tipo"] else TEXTO
                    ctk.CTkLabel(
                        fila, text=texto,
                        font=("Trebuchet MS", 10),
                        text_color=t_color,
                        width=ancho, anchor="w",
                        wraplength=ancho - 10
                    ).pack(side="left", padx=6, pady=4)
    
    # Cargar mes actual
    if meses_disponibles:
        _refrescar(meses_disponibles[0])
    else:
        ctk.CTkLabel(
            scroll,
            text="No historical data yet.\nData will appear after the first sync.",
            font=("Trebuchet MS", 13),
            text_color=SUBTEXTO,
            justify="center"
        ).pack(pady=60)
