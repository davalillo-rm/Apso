        ws.append(["Fecha", "Hora", "Proceso", "Estado", "Avance", "Completados", "Total"])
    
    we.append([fecha_str, hora_str, proceso, item, tipo, remitente])
    wb.save(ruta)


def leer_historico_usuario(codigo: str) -> dict:
    """Lee el historico y retorna snapshots y eventos."""
    ruta = os.path.join(RUTA_BASE, f"{codigo}_historico.xlsx")
    if not os.path.exists(ruta):
        return {"snapshots": [], "eventos": []}
    
    try:
        wb = openpyxl.load_workbook(ruta)
        snapshots = []
        eventos   = []
        
        if "Snapshots" in wb.sheetnames:
            ws = wb["Snapshots"]
            for row in ws.iter_rows(min_row=2, values_only=True):
                row = list(row) + [None] * 10
                if row[0]:
                    snapshots.append({
                        "fecha":       str(row[0]).strip(),
                        "hora":        str(row[1]).strip(),
                        "proceso":     str(row[2]).strip(),
                        "estado":      str(row[3]).strip(),
                        "avance":      str(row[4]).strip(),
                        "completados": row[5] or 0,
                        "total":       row[6] or 0,
                    })
        
        if "Eventos" in wb.sheetnames:
            we = wb["Eventos"]
            for row in we.iter_rows(min_row=2, values_only=True):
                row = list(row) + [None] * 10
                if row[0]:
                    eventos.append({
                        "fecha":     str(row[0]).strip(),
                        "hora":      str(row[1]).strip(),
                        "proceso":   str(row[2]).strip(),
                        "item":      str(row[3]).strip(),
                        "tipo":      str(row[4]).strip(),
                        "remitente": str(row[5]).strip(),
                    })
        
        return {"snapshots": snapshots, "eventos": eventos}
    
    except Exception as e:
        return {"snapshots": [], "eventos": [], "error": str(e)}



