def leer_eventos_hoy(proceso: str, fecha: str) -> list:
    """Retorna lista de tipos de eventos registrados hoy para un proceso."""
    try:
        usuario = getpass.getuser()
        ruta = os.path.join(RUTA_COMPARTIDA, f"{usuario}_historico.xlsx")
        if not os.path.exists(ruta):
            return []
        wb = openpyxl.load_workbook(ruta)
        if "Eventos" not in wb.sheetnames:
            return []
        we = wb["Eventos"]
        tipos = []
        for row in we.iter_rows(min_row=2, values_only=True):
            if row[0] == fecha and row[2] == proceso:
                tipos.append(str(row[4]).strip())
        return tipos
    except:
        return []


