# --- NUEVAS VARIABLES PARA CHECKBOXES ---
        var_s1 = ctk.StringVar(value="")
        var_s2 = ctk.StringVar(value="")
        var_s3 = ctk.StringVar(value="")
        var_s4 = ctk.StringVar(value="")

        def cambiar_frecuencia(seleccion):
            # Limpiamos el contenedor
            for widget in frame_dinamico.winfo_children():
                widget.destroy()

            if seleccion == "Mensual (Elegir Semanas)":
                ctk.CTkLabel(frame_dinamico, text="Selecciona en qué semanas del mes se activará:", 
                             text_color=SCOTIA_SUBTEXT, font=("Trebuchet MS", 11)).pack(anchor="w", pady=(0, 5))
                
                # Creamos un frame horizontal para que los checkboxes se vean ordenados
                chk_frame = ctk.CTkFrame(frame_dinamico, fg_color="transparent")
                chk_frame.pack(fill="x")
                
                ctk.CTkCheckBox(chk_frame, text="Semana 1", variable=var_s1, onvalue="S1", offvalue="", 
                                font=("Trebuchet MS", 11), checkbox_width=18, checkbox_height=18).pack(side="left", padx=(0, 10))
                ctk.CTkCheckBox(chk_frame, text="Semana 2", variable=var_s2, onvalue="S2", offvalue="", 
                                font=("Trebuchet MS", 11), checkbox_width=18, checkbox_height=18).pack(side="left", padx=10)
                ctk.CTkCheckBox(chk_frame, text="Semana 3", variable=var_s3, onvalue="S3", offvalue="", 
                                font=("Trebuchet MS", 11), checkbox_width=18, checkbox_height=18).pack(side="left", padx=10)
                ctk.CTkCheckBox(chk_frame, text="Semana 4", variable=var_s4, onvalue="S4", offvalue="", 
                                font=("Trebuchet MS", 11), checkbox_width=18, checkbox_height=18).pack(side="left", padx=10)
            
            elif seleccion == "Diario":
                ctk.CTkLabel(frame_dinamico, text="⚡ El reporte se exigirá todos los días laborables.", 
                             text_color=SCOTIA_SUBTEXT, font=("Trebuchet MS", 11)).pack(anchor="w")
                
            elif seleccion == "Semanal":
                ctk.CTkLabel(frame_dinamico, text="📅 El reporte se exigirá 1 vez por semana.", 
                             text_color=SCOTIA_SUBTEXT, font=("Trebuchet MS", 11)).pack(anchor="w")

        # --- EL NUEVO MENÚ DESPLEGABLE ---
        combo_frecuencia = ctk.CTkOptionMenu(v, values=["Diario", "Semanal", "Mensual (Elegir Semanas)"], 
                                             width=400, command=cambiar_frecuencia)
        combo_frecuencia.pack(padx=24, pady=(0, 15))
        
        # Contenedor dinámico
        frame_dinamico = ctk.CTkFrame(v, fg_color="transparent")
        frame_dinamico.pack(padx=24, fill="x", pady=(0, 15))
        
        # Forzamos la carga inicial
        cambiar_frecuencia("Diario")













