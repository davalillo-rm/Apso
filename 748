def nombre_display(codigo: str) -> str:
    """Devuelve el nombre real si existe en el diccionario, si no el código."""
    return DIRECTORIO_USUARIOS.get(codigo, codigo)


def iniciales(nombre: str) -> str:
    """Genera iniciales para el avatar."""
    partes = nombre.strip().split()
    if len(partes) >= 2:
        return (partes[0][0] + partes[-1][0]).upper()
    return nombre[:2].upper()


def detectar_usuarios() -> list[str]:
    """Escanea la carpeta fija y retorna lista de códigos detectados."""
    usuarios = []
    if not os.path.exists(RUTA_BASE):
        return usuarios
    for archivo in os.listdir(RUTA_BASE):
        if archivo.endswith("_status.xlsx"):
            codigo = archivo.replace("_status.xlsx", "")
            usuarios.append(codigo)
    return sorted(usuarios)


def leer_status_usuario(codigo: str) -> dict:
    """Lee el archivo Excel de status de un usuario y retorna sus datos."""
    ruta = os.path.join(RUTA_BASE, f"{codigo}_status.xlsx")
    if not os.path.exists(ruta):
        return {"error": f"Archivo no encontrado:\n{ruta}", "procesos": []}

    try:
        wb = openpyxl.load_workbook(ruta)
        ws = wb.active
        procesos = []
        for row in ws.iter_rows(min_row=2, values_only=True):
            row = list(row) + [None] * 10  # normalizar
            proceso    = str(row[0]).strip() if row[0] else ""
            estado     = str(row[1]).strip() if row[1] else ""
            avance     = str(row[2]).strip() if row[2] else ""
            item       = str(row[3]).strip() if row[3] else ""
            hora       = str(row[4]).strip() if row[4] else "PENDIENTE"
            validacion = str(row[5]).strip() if row[5] else "PENDIENTE"
            if proceso:
                procesos.append({
                    "proceso":    proceso,
                    "estado":     estado,
                    "avance":     avance,
                    "item":       item,
                    "hora":       hora,
                    "validacion": validacion,
                })
        hora_mod = datetime.datetime.fromtimestamp(
            os.path.getmtime(ruta)
        ).strftime("%d/%m/%Y %H:%M")
        return {"procesos": procesos, "ultima_actualizacion": hora_mod, "error": None}
    except Exception as e:
        return {"error": str(e), "procesos": []}


