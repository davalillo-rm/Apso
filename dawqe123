def abrir_config_alerta(self):
        v = ctk.CTkToplevel(self)
        v.title("Alertas")
        v.geometry("440x320")
        v.attributes("-topmost", True)
        v.configure(fg_color=SCOTIA_SURFACE)
        
        ctk.CTkLabel(v, text="Automatizar Recordatorios", font=("Georgia", 15, "bold"), text_color=SCOTIA_TEXT).pack(pady=20)
        
        ctk.CTkLabel(v, text="Correo destino de la alerta:", text_color=SCOTIA_SUBTEXT, font=("Trebuchet MS", 11)).pack(anchor="w", padx=45)
        e_dest = ctk.CTkEntry(v, width=350, placeholder_text="ejemplo@scotiabank.com.pe")
        e_dest.pack(pady=5)
        
        ctk.CTkLabel(v, text="Cada cuántas horas revisar y avisar:", text_color=SCOTIA_SUBTEXT, font=("Trebuchet MS", 11)).pack(anchor="w", padx=45, pady=(10,0))
        c_h = ctk.CTkOptionMenu(v, values=["1 hora", "2 horas", "4 horas", "8 horas"], width=350)
        c_h.pack(pady=5)
        
        def activar():
            dest = e_dest.get().strip()
            if not dest:
                messagebox.showwarning("Destinatario vacío", "Por favor, ingresa el correo al que se enviará la alerta.", parent=v)
                return
            if "@scotiabank.com.pe" not in dest.lower():
                messagebox.showwarning("Dominio no permitido", "Solo puedes programar alertas hacia correos @scotiabank.com.pe", parent=v)
                return
            
            self.automatizacion_activa = True
            h = int(c_h.get().split()[0])
            
            self.btn_alerta.configure(text=f"Alertas Activas ({h}h) - Clic para detener", fg_color="#1B3A1B", command=self.desactivar_automatizacion)
            v.destroy()
            self.ciclo_alerta(dest, h * 3600000) # Se convierte a milisegundos

        ctk.CTkButton(v, text="Activar Automatización", fg_color=SCOTIA_YELLOW, text_color=SCOTIA_BLACK, font=("Trebuchet MS", 12, "bold"), width=200, command=activar).pack(pady=25)
