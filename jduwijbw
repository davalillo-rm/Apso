Matriz_Unificada = 
VAR _FactorActual = SELECTEDVALUE(Estructura_RCL[Factor])

-- Asegúrate de que esta es la columna que arrastraste a "Columnas" en tu matriz
VAR _MonedaActual = SELECTEDVALUE(EscenarioMoneda[Moneda]) 

VAR _ValorSeleccionado = 
    SWITCH(
        _FactorActual,
        "Impacto RCL", [Impacto_RCL_Consolidado],
        "Deri. Compra", [Impacto_RCL_Derivados_C], -- ¡La medida correcta!
        "Deri. Venta", [Impacto_RCL_Derivados_V]
    )

RETURN
    IF(
        _MonedaActual = "CONS",
        IF(
            _FactorActual = "Impacto RCL", 
            0.00, 
            COALESCE(_ValorSeleccionado, 0.00)
        ),
        _ValorSeleccionado 
    )
