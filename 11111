
        def buscar_contactos_outlook(query: str) -> list:
    try:
        outlook = win32com.client.Dispatch("Outlook.Application")
        ns = outlook.GetNamespace("MAPI")
        gal = ns.AddressLists["Global Address List"]
        entries = gal.AddressEntries
        
        resultados = []
        count = min(entries.Count, 1000)
        
        for i in range(1, count + 1):
            try:
                entry = entries.Item(i)
                
                # Filtrar: solo usuarios (tipo 0), ignorar grupos/listas
                if entry.AddressEntryUserType != 0:
                    continue
                
                nombre = entry.Name or ""
                if query.lower() not in nombre.lower() and query.lower() not in (entry.Address or "").lower():
                    continue
                
                eu = entry.GetExchangeUser()
                if eu is None:
                    continue
                    
                email = eu.PrimarySmtpAddress or ""
                if not email:
                    continue
                    
                resultados.append({
                    "nombre": nombre,
                    "email": email
                })
                
                if len(resultados) >= 6:
                    break
                    
            except Exception:
                continue  # Silencioso, sin print
        
        return resultados
        
    except Exception as e:
        print(f"Outlook error: {e}")
        return []












