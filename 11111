                anchor="w",
                height=30,
                font=("Trebuchet MS", 11),
                command=seleccionar
            ).pack(fill="x", padx=2, pady=0)

    def on_keyrelease(event):
        texto = entry_widget.get().strip()

        if len(texto) < 2:
            cerrar()
            return

        def buscar():
            contactos = buscar_contactos_outlook(texto)
            if contactos:
                entry_widget.after(0, lambda: mostrar_dropdown(contactos))
            else:
