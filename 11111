def leer_eventos_hoy(proceso: str, fecha: str) -> list:
    """Retorna lista de tipos de eventos registrados hoy para un proceso."""
    try:
        usuario = getpass.getuser()
        ruta = os.path.join(RUTA_COMPARTIDA, f"{usuario}_historico.xlsx")
        if not os.path.exists(ruta):
            return []
        wb = openpyxl.load_workbook(ruta)
        if "Eventos" not in wb.sheetnames:
            return []
        we = wb["Eventos"]
        tipos = []
        for row in we.iter_rows(min_row=2, values_only=True):
            if row[0] == fecha and row[2] == proceso:
                tipos.append(str(row[4]).strip())
        return tipos
    except:
        return []


def registrar_evento_historico(proceso: str, item: str,
                                tipo: str, remitente: str):
    """
    Registra un evento puntual en el histórico.
    tipo: 'CORREO RECIBIDO', 'SOLICITUD ENVIADA' o 'REGLA ACTIVADA'
    """
    try:
        usuario = getpass.getuser()
        ruta = os.path.join(RUTA_COMPARTIDA, f"{usuario}_historico.xlsx")

        ahora = datetime.datetime.now()
        fecha_str = ahora.strftime("%d/%m/%Y")
        hora_str  = ahora.strftime("%H:%M:%S")

        if os.path.exists(ruta):
            wb = openpyxl.load_workbook(ruta)
        else:
            wb = openpyxl.Workbook()
            wb.remove(wb.active)

        if "Eventos" not in wb.sheetnames:
            we = wb.create_sheet("Eventos")
            we.append(["Fecha", "Hora", "Proceso",
                       "Item", "Tipo", "Remitente"])
        else:
            we = wb["Eventos"]

        if "Snapshots" not in wb.sheetnames:
            ws = wb.create_sheet("Snapshots")
            ws.append(["Fecha", "Hora", "Proceso",
                       "Estado", "Avance", "Completados", "Total"])

        we.append([fecha_str, hora_str, proceso, item, tipo, remitente])
        wb.save(ruta)
        print(f"Evento registrado: {tipo} | {proceso} | {item}")

    except Exception as e:
        print(f"Error registrando evento: {e}")


def guardar_snapshot_historico(procesos: list):
    """Guarda snapshot del estado actual en el historico."""
    try:
        usuario = getpass.getuser()
        ruta = os.path.join(RUTA_COMPARTIDA, f"{usuario}_historico.xlsx")

        ahora = datetime.datetime.now()
        fecha_str = ahora.strftime("%d/%m/%Y")
        hora_str  = ahora.strftime("%H:%M")

        if os.path.exists(ruta):
            wb = openpyxl.load_workbook(ruta)
        else:
            wb = openpyxl.Workbook()
            wb.remove(wb.active)

        if "Snapshots" not in wb.sheetnames:
            ws = wb.create_sheet("Snapshots")
            ws.append(["Fecha", "Hora", "Proceso",
                       "Estado", "Avance", "Completados", "Total"])
        else:
            ws = wb["Snapshots"]

        if "Eventos" not in wb.sheetnames:
            we = wb.create_sheet("Eventos")
            we.append(["Fecha", "Hora", "Proceso",
                       "Item", "Tipo", "Remitente"])

        for p in procesos:
            total     = p.get("total", 0)
            cumplidos = p.get("cumplidos", 0)
            estado    = "COMPLETO" if cumplidos == total and total > 0 else "EN PROCESO"
            avance    = f"{cumplidos}/{total}"

            ws.append([
                fecha_str,
                hora_str,
                p.get("nombre", ""),
                estado,
                avance,
                cumplidos,
                total,
            ])

        wb.save(ruta)
        print(f"Snapshot guardado: {len(procesos)} procesos")

    except Exception as e:
        print(f"Error guardando snapshot: {e}")
















def _refrescar(mes_legible_sel: str):
    for w in scroll.winfo_children():
        w.destroy()

    mes_codigo = meses_map.get(mes_legible_sel, "")
    eventos_mes = [
        e for e in eventos
        if extraer_mes(e.get("fecha", "")) == mes_codigo
    ]

    if not eventos_mes:
        ctk.CTkLabel(
            scroll,
            text="No records found for this month.",
            font=("Trebuchet MS", 13),
            text_color=SUBTEXTO
        ).pack(pady=40)
        return

    # ── Construir resumen por proceso+item ──
    resumen = {}

    for ev in sorted(eventos_mes, key=lambda x: (x["fecha"], x["hora"])):
        proc  = ev.get("proceso", "")
        item  = ev.get("item", "")
        tipo  = ev.get("tipo", "")
        fecha = ev.get("fecha", "")
        hora  = ev.get("hora", "")

        if proc not in resumen:
            resumen[proc] = {}

        if tipo == "REGLA ACTIVADA":
            if "_activado" not in resumen[proc]:
                resumen[proc]["_activado"] = f"{fecha} {hora[:5]}"
            continue

        if item not in resumen[proc]:
            resumen[proc][item] = {
                "fecha_inicio":    resumen[proc].get("_activado", "—"),
                "fecha_solicitud": "—",
                "fecha_recepcion": "—",
                "estado":          "PENDIENTE"
            }

        if tipo == "SOLICITUD ENVIADA":
            resumen[proc][item]["fecha_solicitud"] = f"{fecha} {hora[:5]}"

        elif tipo == "CORREO RECIBIDO":
            resumen[proc][item]["fecha_recepcion"] = f"{fecha} {hora[:5]}"
            resumen[proc][item]["estado"] = "COMPLETO"

    # ── Dibujar tabla por proceso ──
    for proceso, items in resumen.items():
        ctk.CTkLabel(
            scroll,
            text=f"📁  {proceso}",
            font=("Georgia", 13, "bold"),
            text_color=TEXTO,
            anchor="w"
        ).pack(fill="x", pady=(14, 4), padx=4)

        self._fila_tabla(
            scroll,
            ["ITEM", "ACTIVATED", "REQUEST SENT", "RECEIVED", "STATUS"],
            es_header=True
        )

        for item_nombre, datos_item in items.items():
            if item_nombre == "_activado":
                continue

            estado = datos_item["estado"]
            color_estado = VERDE if estado == "COMPLETO" else AMARILLO

            fila = ctk.CTkFrame(
                scroll,
                fg_color=CARD2,
                corner_radius=4,
                height=32
            )
            fila.pack(fill="x", pady=1)
            fila.pack_propagate(False)

            for texto, ancho in zip([
                item_nombre,
                datos_item["fecha_inicio"],
                datos_item["fecha_solicitud"],
                datos_item["fecha_recepcion"],
                estado
            ], [180, 120, 120, 120, 100]):
                t_color = color_estado if texto == estado else TEXTO
                ctk.CTkLabel(
                    fila,
                    text=texto,
                    font=("Trebuchet MS", 10),
                    text_color=t_color,
                    width=ancho,
                    anchor="w",
                    wraplength=ancho - 10
                ).pack(side="left", padx=6, pady=4)

    # ── Sección eventos cronológicos ──
    ctk.CTkLabel(
        scroll,
        text="📬  Event Timeline",
        font=("Georgia", 13, "bold"),
        text_color=TEXTO
    ).pack(anchor="w", pady=(20, 6))

    self._fila_tabla(
        scroll,
        ["DATE", "TIME", "PROCESS", "ITEM", "TYPE"],
