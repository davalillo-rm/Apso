-- ------------------------------------------------------------
-- 6. VISTA REESCRITA (reemplaza tanto "vista balance" como
--    "vista resumen" usando la misma tabla de origen)
--    Usa CROSS APPLY con TOP 1 para que el match más largo/
--    específico gane sobre el más corto (ej. Nivel_4 le gana a Nivel_3).
-- ------------------------------------------------------------
IF OBJECT_ID('dbo.vw_Balance_Jerarquizado', 'V') IS NOT NULL
    DROP VIEW dbo.vw_Balance_Jerarquizado;
GO

CREATE VIEW dbo.vw_Balance_Jerarquizado AS
SELECT
    b.Fecha,
    b.[Cuenta Moneda] AS Cuenta_Contable,
    b.Descripcion     AS Nombre_Cuenta,

    CASE WHEN b.Moneda = 0 THEN 'PEN'
         WHEN b.Moneda = 91 THEN 'USD (91)'
         WHEN b.Moneda = 92 THEN 'USD_Convertido_PEN 92'
         ELSE 'OTRO' END                       AS Etiqueta_Moneda,

    ((b.[Saldo Final] * -1.0) / 1000000.0)      AS Saldo_Millones,

    n2.Nivel_1_Desc,
    n2.Nivel_2_Desc,
    n2.Nivel_Resumen,

    -- Caso especial 1918/1928 Tesorería vs Trámite (no resuelto por tabla)
    CASE WHEN SUBSTRING(b.[Cuenta Moneda],1,4) IN ('1918','1928') THEN
            CASE WHEN b.[Cuenta Moneda] LIKE '____.07.04.07%'
                 THEN '1918 - OPERACIONES DE TESORERIA'
                 ELSE '1918 - OPERACIONES EN TRAMITE' END
         ELSE
            CASE WHEN b.Moneda = 91
                 THEN STUFF(SUBSTRING(b.[Cuenta Moneda],1,4),3,1,'1') + ' - ' + n3.Nivel_3_Desc_Base
                 ELSE SUBSTRING(b.[Cuenta Moneda],1,4) + ' - ' + n3.Nivel_3_Desc_Base END
    END                                          AS Nivel_3_Desc,

    n4.Nivel_4_Codigo + ' - ' + n4.Nivel_4_Desc_Base AS Nivel_4_Desc,

    COALESCE(n4.Rol_Jerarquia, n3.Rol_Jerarquia, 'Normal') AS Rol_Jerarquia

FROM dbo.RM_Balance_Historico b

-- Nivel 2 / Resumen: match por 2 dígitos
LEFT JOIN dbo.CuentaJerarquia n2
    ON n2.Prefijo = SUBSTRING(b.[Cuenta Moneda],1,2)
    AND n2.LargoMatch = 2

-- Nivel 3: match por 4 dígitos, separado por moneda
LEFT JOIN dbo.CuentaJerarquia n3
    ON n3.Prefijo = SUBSTRING(b.[Cuenta Moneda],1,4)
    AND n3.LargoMatch = 4

-- Nivel 4: match del prefijo MÁS LARGO disponible (7/10/13/16/19)
OUTER APPLY (
    SELECT TOP 1 cj.Nivel_4_Codigo, cj.Nivel_4_Desc_Base, cj.Rol_Jerarquia
    FROM dbo.CuentaJerarquia cj
    WHERE cj.LargoMatch >= 7
      AND LEFT(b.[Cuenta Moneda], cj.LargoMatch) = cj.Prefijo
    ORDER BY cj.LargoMatch DESC
) n4

WHERE b.Moneda IN (0, 91);
