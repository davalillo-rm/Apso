def tabla_deriv(df: pd.DataFrame, buckets):
    bucket_names = [b[0] for b in buckets]
    rows = []
    for b in bucket_names:
        sub = df[df["Bucket"] == b]
        cxc_pen = sub.loc[sub["Residual_PEN"] >= 0, "VM_Larga_PEN"].sum()
        cxp_pen = sub.loc[sub["Residual_PEN"] <  0, "VM_Corta_PEN"].sum()
        rows.append({
            "Banda":   b,
            "CxC PEN": cxc_pen,
            "CxP PEN": cxp_pen,
            "CxC USD": cxc_pen / TC["USD"],
            "CxP USD": cxp_pen / TC["USD"],
        })
    return pd.DataFrame(rows)

# ─────────────────────────────────────────────
# TABLA DERIV DELIVERY
# ─────────────────────────────────────────────
def tabla_deriv_delivery(df: pd.DataFrame, buckets):
    bucket_names = [b[0] for b in buckets]
    monedas = sorted(df["Moneda_Pactada"].unique())
    rows = []

    for mon in monedas:
        sub_mon = df[df["Moneda_Pactada"] == mon]
        tc = TC.get(mon, 1.0)

        larga_row = {"Moneda Pactada": mon, "Mon": f"Larga ({mon})", "Tipo": "Larga"}
        corta_row = {"Moneda Pactada": mon, "Mon": "Corta (PEN)",    "Tipo": "Corta"}

        for b in bucket_names:
            sub = sub_mon[sub_mon["Bucket"] == b]
            # Larga en moneda extranjera original
            larga_row[b] = sub["Cap_REC_orig"].sum() if mon != "PEN" else sub["VM_Larga_PEN"].sum()
            # Corta en PEN
            corta_row[b] = sub["Cap_PAGO_orig"].sum()

        rows.append(larga_row)
        rows.append(corta_row)

    # Totales consolidados
    for label, col in [
        ("PEN Larga", "VM_Larga_PEN"),
        ("PEN Corta", "VM_Corta_PEN"),
    ]:
        tot = {"Moneda Pactada": "TOTAL", "Mon": label, "Tipo": "Total"}
        for b in bucket_names:
            sub = df[df["Bucket"] == b]
            tot[b] = sub[col].sum()
        rows.append(tot)

    for label, col in [
        ("USD Larga", "VM_Larga_PEN"),
        ("USD Corta", "VM_Corta_PEN"),
    ]:
        tot = {"Moneda Pactada": "TOTAL", "Mon": label, "Tipo": "Total"}
        for b in bucket_names:
            sub = df[df["Bucket"] == b]
            tot[b] = sub[col].sum() / TC["USD"]
        rows.append(tot)

    return pd.DataFrame(rows)

