"""
Anexo 16 - Bucketeo Deriv
Lee MTM 20260430.xlsx (Hoja1) y genera Excel con:
  - Pestaña Data   : forwards Delivery con columnas calculadas
  - Pestaña Deriv  : bucketeo CxC/CxP con formulas referenciando Data
"""

import pandas as pd
from datetime import date
import openpyxl
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.utils import get_column_letter

# ─────────────────────────────────────────────
# PARÁMETROS
# ─────────────────────────────────────────────
MTM_PATH    = "MTM 20260430.xlsx"
FECHA_CORTE = date(2026, 4, 30)
TC_USD      = 3.517

BUCKETS = [
    ("7D",   0,    7),
    ("15D",  7,    15),
    ("30D",  15,   30),
    ("2M",   30,   61),
    ("3M",   61,   92),
    ("6M",   92,   184),
    ("12M",  184,  365),
    ("2Y",   365,  731),
    ("3Y",   731,  1096),
    ("4Y",   1096, 1461),
    ("5Y",   1461, 1826),
    ("10Y",  1826, 3653),
    ("20Y",  3653, 7305),
    ("50Y",  7305, 22525),
]

COLS_NEEDED = [
    "Compra_Venta",
    "Forma_Pago",
    "Moneda_Pactada",
    "Nominal_Pactado",
    "VM_Pos_larga",
    "VM_Pos_corta",
    "Fec_vencimiento_oper",
]

# ─────────────────────────────────────────────
# ESTILOS
# ─────────────────────────────────────────────
H_FILL  = PatternFill("solid", start_color="1F4E79")
T_FILL  = PatternFill("solid", start_color="BDD7EE")
A_FILL  = PatternFill("solid", start_color="DEEAF1")
W_FILL  = PatternFill("solid", start_color="FFFFFF")
H_FONT  = Font(bold=True, color="FFFFFF", name="Arial", size=10)
B_FONT  = Font(bold=True, name="Arial", size=10)
N_FONT  = Font(name="Arial", size=10)
G_FONT  = Font(name="Arial", size=10, color="006400")
NUM_FMT = '#,##0;(#,##0);"-"'
DATE_FMT= 'DD/MM/YYYY'
C_ALIGN = Alignment(horizontal="center", vertical="center")
L_ALIGN = Alignment(horizontal="left",   vertical="center")
_side   = Side(style="thin", color="BFBFBF")
BORDER  = Border(left=_side, right=_side, top=_side, bottom=_side)

def hdr(cell, text):
    cell.value = text; cell.font = H_FONT; cell.fill = H_FILL
    cell.alignment = C_ALIGN; cell.border = BORDER

def lbl(cell, text, bold=False, fill=None, green=False):
    cell.value = text
    cell.font = G_FONT if green else (B_FONT if bold else N_FONT)
    cell.alignment = L_ALIGN; cell.border = BORDER
    if fill: cell.fill = fill

def cw(ws, col, w):
    ws.column_dimensions[col].width = w

# ─────────────────────────────────────────────
# LECTURA
# ─────────────────────────────────────────────
def leer_forwards(path):
    df = pd.read_excel(path, sheet_name="Hoja1", header=0)
    df.columns = df.columns.str.strip()
    print(f"Total filas MTM: {len(df)}")
    missing = [c for c in COLS_NEEDED if c not in df.columns]
    if missing:
        print(f"ADVERTENCIA - Columnas no encontradas: {missing}")
    df["_forma"] = df["Forma_Pago"].astype(str).str.strip().str.upper()
    fwd = df[df["_forma"] == "DELIVERY"].copy()
    print(f"Forwards Delivery: {len(fwd)}")
    return fwd

# ─────────────────────────────────────────────
# ESCRIBIR HOJA DATA
# ─────────────────────────────────────────────
def bucket_formula(dias_cell):
    conditions = []
    for nombre, d_ini, d_fin in BUCKETS:
        conditions.append(f'Y({dias_cell}>{d_ini},{dias_cell}<={d_fin}),"{nombre}"')
    return '=SI.CONJUNTO(' + ','.join(conditions) + ',VERDADERO,"Sin Bucket")'

def escribir_data(ws, df: pd.DataFrame, fc: date):
    ws.freeze_panes = "A2"

    headers_orig = COLS_NEEDED
    headers_calc = ["Dias_Vcto", "Bucket", "Residual_PEN"]
    all_headers  = headers_orig + headers_calc

    for j, h in enumerate(all_headers, 1):
        hdr(ws.cell(1, j), h)

    col_dias   = len(headers_orig) + 1
    col_bucket = len(headers_orig) + 2
    col_resid  = len(headers_orig) + 3

    col_fecha   = headers_orig.index("Fec_vencimiento_oper") + 1
    col_vmlarga = headers_orig.index("VM_Pos_larga") + 1
    col_vmcorta = headers_orig.index("VM_Pos_corta") + 1

    col_fecha_l  = get_column_letter(col_fecha)
    col_larga_l  = get_column_letter(col_vmlarga)
    col_corta_l  = get_column_letter(col_vmcorta)
    col_dias_l   = get_column_letter(col_dias)
    col_bucket_l = get_column_letter(col_bucket)
    col_resid_l  = get_column_letter(col_resid)

    aux_col = len(all_headers) + 2
    aux_l   = get_column_letter(aux_col)
    ws.cell(1, aux_col).value = fc
    ws.cell(1, aux_col).number_format = DATE_FMT
    ws.cell(1, aux_col - 1).value = "Fecha Corte:"
    ws.cell(1, aux_col - 1).font = B_FONT

    df_reset = df[headers_orig].reset_index(drop=True)

    for i, row in df_reset.iterrows():
        r    = i + 2
        fill = A_FILL if i % 2 == 0 else W_FILL

        for j, col in enumerate(headers_orig, 1):
            cell = ws.cell(r, j)
            val  = row[col]
            if col == "Fec_vencimiento_oper":
                if pd.notna(val):
                    cell.value = pd.to_datetime(val).date()
                    cell.number_format = DATE_FMT
                else:
                    cell.value = None
            elif col in ["VM_Pos_larga", "VM_Pos_corta", "Nominal_Pactado"]:
                cell.value = float(val) if pd.notna(val) else 0
                cell.number_format = NUM_FMT
            else:
                cell.value = str(val) if pd.notna(val) else ""
            cell.font = N_FONT; cell.fill = fill
            cell.alignment = C_ALIGN; cell.border = BORDER

        # Dias_Vcto
        dc = ws.cell(r, col_dias)
        dc.value = f"=SI({col_fecha_l}{r}=\"\",\"\",{col_fecha_l}{r}-${aux_l}$1)"
        dc.number_format = "0"
        dc.font = G_FONT; dc.fill = fill
        dc.alignment = C_ALIGN; dc.border = BORDER

        # Bucket
        bc = ws.cell(r, col_bucket)
        bc.value = bucket_formula(f"{col_dias_l}{r}")
        bc.font = G_FONT; bc.fill = fill
        bc.alignment = C_ALIGN; bc.border = BORDER

        # Residual
        rc = ws.cell(r, col_resid)
        rc.value = f"={col_larga_l}{r}-{col_corta_l}{r}"
        rc.number_format = NUM_FMT
        rc.font = G_FONT; rc.fill = fill
        rc.alignment = C_ALIGN; rc.border = BORDER

    widths = [15, 12, 12, 15, 15, 15, 18, 10, 10, 15]
    for j, w in enumerate(widths, 1):
        cw(ws, get_column_letter(j), w)

    print(f"  Hoja Data: {len(df_reset)} filas escritas")
    return col_bucket_l, col_resid_l, len(df_reset) + 1

# ─────────────────────────────────────────────
# ESCRIBIR HOJA DERIV
# Formato: filas = CxC PEN / CxP PEN / CxC USD / CxP USD
#          columnas = 7D, 15D, ... 50Y, Total
# ─────────────────────────────────────────────
def escribir_deriv(ws, col_bucket_l, col_resid_l, last_row, fc: date):
    ws.freeze_panes = "B3"
    data_ref = "Data"
    n_buckets = len(BUCKETS)

    # Título
    last_col_letter = get_column_letter(n_buckets + 2)
    ws.merge_cells(f"A1:{last_col_letter}1")
    c = ws["A1"]
    c.value = f"Anexo 16 – Deriv | CxC y CxP Forwards | Corte: {fc}"
    c.font = Font(bold=True, name="Arial", size=12, color="1F4E79")
    c.alignment = C_ALIGN

    # Encabezado fila 2: col A vacía, luego buckets, luego Total
    hdr(ws.cell(2, 1), "")
    for j, (nombre, _, _) in enumerate(BUCKETS, 2):
        hdr(ws.cell(2, j), nombre)
    hdr(ws.cell(2, n_buckets + 2), "Total")

    # Filas de datos
    filas = [
        ("CxC PEN", ">=0", False),   # residual positivo
        ("CxP PEN", "<0",  False),   # residual negativo abs
        ("CxC USD", ">=0", True),    # dividir por TC_USD
        ("CxP USD", "<0",  True),
    ]

    for fi, (label, signo, es_usd) in enumerate(filas):
        r    = fi + 3
        fill = A_FILL if fi % 2 == 0 else W_FILL

        lbl(ws.cell(r, 1), label, bold=True, fill=fill)

        for j, (nombre, _, _) in enumerate(BUCKETS, 2):
            cell = ws.cell(r, j)
            cell.fill = fill
            cell.alignment = C_ALIGN
            cell.border = BORDER
            cell.number_format = NUM_FMT
            cell.font = G_FONT

            if signo == ">=0":
                formula = (
                    f"=SUMAPRODUCTO("
                    f"('{data_ref}'!${col_bucket_l}$2:${col_bucket_l}${last_row}=\"{nombre}\")*"
                    f"('{data_ref}'!${col_resid_l}$2:${col_resid_l}${last_row}>=0)*"
                    f"'{data_ref}'!${col_resid_l}$2:${col_resid_l}${last_row})"
                )
            else:
                formula = (
                    f"=SUMAPRODUCTO("
                    f"('{data_ref}'!${col_bucket_l}$2:${col_bucket_l}${last_row}=\"{nombre}\")*"
                    f"('{data_ref}'!${col_resid_l}$2:${col_resid_l}${last_row}<0)*"
                    f"ABS('{data_ref}'!${col_resid_l}$2:${col_resid_l}${last_row}))"
                )

            if es_usd:
                formula = formula.replace("=", f"=", 1)
                formula = f"=({formula[1:]])/{TC_USD}"

            cell.value = formula

        # Total
        tc = ws.cell(r, n_buckets + 2)
        first_col = get_column_letter(2)
        last_col  = get_column_letter(n_buckets + 1)
        tc.value = f"=SUMA({first_col}{r}:{last_col}{r})"
        tc.number_format = NUM_FMT
        tc.font = B_FONT; tc.fill = T_FILL
        tc.alignment = C_ALIGN; tc.border = BORDER

    # Anchos
    cw(ws, "A", 12)
    for j in range(2, n_buckets + 3):
        cw(ws, get_column_letter(j), 14)

# ─────────────────────────────────────────────
# MAIN
# ─────────────────────────────────────────────
def main():
    print("=" * 50)
    print("Anexo 16 v3 - Data + Deriv con fórmulas Excel")
    print("=" * 50)

    print(f"\nLeyendo {MTM_PATH}...")
    df_fwd = leer_forwards(MTM_PATH)

    print("\nGenerando Excel...")
    wb = openpyxl.Workbook()
    ws_data  = wb.active
    ws_data.title = "Data"
    ws_deriv = wb.create_sheet("Deriv")

    col_bucket_l, col_resid_l, last_row = escribir_data(ws_data, df_fwd, FECHA_CORTE)
    escribir_deriv(ws_deriv, col_bucket_l, col_resid_l, last_row, FECHA_CORTE)

    out = f"Anexo16_v3_{FECHA_CORTE.strftime('%Y%m%d')}.xlsx"
    wb.save(out)
    print(f"\n✅ Archivo generado: {out}")

if __name__ == "__main__":
    main()








