    def tipo_producto(row):
        deal = str(row.get("Deal", "")).upper()
        currency = str(row.get("Currency", "")).upper()

        if deal.endswith("FXSPT"):
            return "CASH"
        if deal.startswith("CD"):
            return "CD"
        if deal.startswith("KONDORPERU.CCS"):
            return "CCS"
        if "KONDORPERU.FX" in deal:
            return "Forward"
        if "KONDORPERU.IRS" in deal:
            return "IRS_USD" if currency == "USD" else "IRS_PEN"
        if "KONDORPERU.SP" in deal:
            return "Spot"
        if deal.startswith("PERUGB"):
            return "SOBERANOS"
        if deal.startswith("PERU") and not deal.startswith("PERUGB"):
            return "Global"
        return "OTRO"

    df["Tipo de Producto"] = df.apply(tipo_producto, axis=1)

