from datetime import date, timedelta

def ajustar_a_laborable(fecha):
    while fecha.weekday() >= 5:  # sábado o domingo
        fecha -= timedelta(days=1)
    return fecha

def restar_dias_laborables(fecha, n):
    resultado = fecha
    cont = 0
    while cont < n:
        resultado -= timedelta(days=1)
        if resultado.weekday() < 5:
            cont += 1
    return resultado

def formatear_fecha_ddmmyy(fecha):
