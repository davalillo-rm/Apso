def escribir_deriv(ws, col_bucket_l, col_resid_l, last_row, fc: date):
    ws.freeze_panes = "B3"

    # Título
    ws.merge_cells("A1:E1")
    c = ws["A1"]
    c.value = f"Anexo 16 – Deriv | CxC y CxP Forwards | Corte: {fc}"
    c.font = Font(bold=True, name="Arial", size=12, color="1F4E79")
    c.alignment = C_ALIGN

    # Encabezados
    for j, h in enumerate(["Banda", "CxC PEN", "CxP PEN", "CxC USD", "CxP USD"], 1):
        hdr(ws.cell(2, j), h)

    # Nombre de hoja Data para referencias cruzadas
    data_ref = "Data"

    for i, (nombre, d_ini, d_fin) in enumerate(BUCKETS):
        r = i + 3
        fill = A_FILL if i % 2 == 0 else W_FILL

        # Banda
        lbl(ws.cell(r, 1), nombre, fill=fill)

        # CxC PEN = SUMAR.SI.CONJUNTO donde bucket=nombre Y residual>=0, suma residual
        cxc_formula = (
            f"=SUMPRODUCT(("
            f"'{data_ref}'!${col_bucket_l}$2:${col_bucket_l}${last_row}=\"{nombre}\")*"
            f"('{data_ref}'!${col_resid_l}$2:${col_resid_l}${last_row}>=0)*"
            f"'{data_ref}'!${col_resid_l}$2:${col_resid_l}${last_row})"
        )

        # CxP PEN = SUMPRODUCT donde bucket=nombre Y residual<0, suma ABS(residual)
        cxp_formula = (
            f"=SUMPRODUCT(("
            f"'{data_ref}'!${col_bucket_l}$2:${col_bucket_l}${last_row}=\"{nombre}\")*"
            f"('{data_ref}'!${col_resid_l}$2:${col_resid_l}${last_row}<0)*"
            f"ABS('{data_ref}'!${col_resid_l}$2:${col_resid_l}${last_row}))"
        )

        c_cxc = ws.cell(r, 2)
        c_cxc.value = cxc_formula
        c_cxc.number_format = NUM_FMT
        c_cxc.font = G_FONT; c_cxc.fill = fill
        c_cxc.alignment = C_ALIGN; c_cxc.border = BORDER

        c_cxp = ws.cell(r, 3)
        c_cxp.value = cxp_formula
        c_cxp.number_format = NUM_FMT
        c_cxp.font = G_FONT; c_cxp.fill = fill
        c_cxp.alignment = C_ALIGN; c_cxp.border = BORDER

        # CxC USD
        c_cxc_usd = ws.cell(r, 4)
        c_cxc_usd.value = f"=B{r}/{TC_USD}"
        c_cxc_usd.number_format = NUM_FMT
        c_cxc_usd.font = G_FONT; c_cxc_usd.fill = fill
        c_cxc_usd.alignment = C_ALIGN; c_cxc_usd.border = BORDER

        # CxP USD
        c_cxp_usd = ws.cell(r, 5)
        c_cxp_usd.value = f"=C{r}/{TC_USD}"
        c_cxp_usd.number_format = NUM_FMT
        c_cxp_usd.font = G_FONT; c_cxp_usd.fill = fill
        c_cxp_usd.alignment = C_ALIGN; c_cxp_usd.border = BORDER

    # Totales
    tr = len(BUCKETS) + 3
    lbl(ws.cell(tr, 1), "TOTAL", bold=True, fill=T_FILL)
    for j in range(2, 6):
        cl = get_column_letter(j)
        c  = ws.cell(tr, j)
        c.value = f"=SUM({cl}3:{cl}{tr-1})"
        c.number_format = NUM_FMT
        c.font = B_FONT; c.fill = T_FILL
        c.alignment = C_ALIGN; c.border = BORDER

    for col, w in [("A",10),("B",20),("C",20),("D",20),("E",20)]:
        cw(ws, col, w)

