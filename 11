"""
Anexo 16 - Bucketeo Deriv y Deriv Delivery
Input:  Anexo8_YYYYMMDD.xlsx (Hoja1)
Output: Anexo16_Bucketeo_YYYYMMDD.xlsx con 2 hojas:
        - Deriv          (CxC y CxP en PEN por banda temporal)
        - Deriv_Delivery (flujos Larga/Corta por moneda pactada y banda)
"""

import pandas as pd
import numpy as np
from datetime import date, timedelta
from dateutil.relativedelta import relativedelta
import openpyxl
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.utils import get_column_letter

# ─────────────────────────────────────────────
# PARÁMETROS — modificar antes de ejecutar
# ─────────────────────────────────────────────
ANEXO8_PATH = "Anexo8_2026.04.30.xlsx"
FECHA_CORTE = date(2026, 4, 30)

TC = {
    "USD": 3.517,
    "EUR": 4.1250,
    "JPY": 0.0225,
    "CNY": 0.5151,
    "CAD": 2.58413,
    "PEN": 1.0,
}

# ─────────────────────────────────────────────
# BANDAS TEMPORALES
# ─────────────────────────────────────────────
def get_buckets(fc: date):
    return [
        ("7D",   fc,                            fc + timedelta(days=7)),
        ("15D",  fc + timedelta(days=7),        fc + timedelta(days=15)),
        ("30D",  fc + timedelta(days=15),       fc + timedelta(days=30)),
        ("2M",   fc + timedelta(days=30),       fc + relativedelta(months=2)),
        ("3M",   fc + relativedelta(months=2),  fc + relativedelta(months=3)),
        ("6M",   fc + relativedelta(months=3),  fc + relativedelta(months=6)),
        ("12M",  fc + relativedelta(months=6),  fc + relativedelta(months=12)),
        ("2Y",   fc + relativedelta(months=12), fc + relativedelta(years=2)),
        ("3Y",   fc + relativedelta(years=2),   fc + relativedelta(years=3)),
        ("4Y",   fc + relativedelta(years=3),   fc + relativedelta(years=4)),
        ("5Y",   fc + relativedelta(years=4),   fc + relativedelta(years=5)),
        ("10Y",  fc + relativedelta(years=5),   fc + relativedelta(years=10)),
        ("20Y",  fc + relativedelta(years=10),  fc + relativedelta(years=20)),
        ("50Y",  fc + relativedelta(years=20),  fc + relativedelta(years=50)),
    ]

def parse_fecha(valor):
    """Convierte cualquier formato de fecha a date."""
    if pd.isna(valor):
        return None
    if hasattr(valor, 'date'):
        return valor.date()
    if isinstance(valor, date):
        return valor
    if isinstance(valor, str):
        for fmt in ("%d/%m/%Y", "%Y-%m-%d", "%m/%d/%Y", "%d-%m-%Y"):
            try:
                return pd.to_datetime(valor, format=fmt).date()
            except:
                continue
    try:
        return pd.to_datetime(valor).date()
    except:
        return None

def asignar_bucket(fecha_vcto, buckets):
    fv = parse_fecha(fecha_vcto)
    if fv is None:
        return None
    for nombre, ini, fin in buckets:
        if ini < fv <= fin:
            return nombre
    return None

# ─────────────────────────────────────────────
# LECTURA Y FILTRO DEL ANEXO 8
# ─────────────────────────────────────────────
def leer_forwards(path):
    df = pd.read_excel(path, sheet_name="Hoja1", header=0)
    df.columns = df.columns.str.strip()

    print(f"  Total filas Anexo 8: {len(df)}")
    print(f"  Columnas: {list(df.columns)}")

    # Filtrar solo Delivery
    col_forma = next((c for c in df.columns if "Forma" in c and "Pago" in c), None)
    if col_forma is None:
        raise ValueError("No se encontró columna Forma_Pago en Anexo 8")

    df["_forma"] = df[col_forma].astype(str).str.strip().str.upper()
    forwards = df[df["_forma"] == "DELIVERY"].copy()
    print(f"  Forwards (Delivery): {len(forwards)}")
    return forwards

# ─────────────────────────────────────────────
# MAPEO DE COLUMNAS FLEXIBLE
# ─────────────────────────────────────────────
def get_col(df, candidatos):
    """Devuelve el primer nombre de columna que exista en df."""
    for c in candidatos:
        if c in df.columns:
            return c
    # Búsqueda parcial
    for c in candidatos:
        matches = [col for col in df.columns if c.lower() in col.lower()]
        if matches:
            return matches[0]
    return None

# ─────────────────────────────────────────────
# PROCESAR FORWARDS
# ─────────────────────────────────────────────
def procesar_forwards(df: pd.DataFrame, buckets):
    # Mapear columnas
    col_compra_venta  = get_col(df, ["Compra_Venta", "Compra_Vent"])
    col_moneda_pac    = get_col(df, ["Moneda_Pactada", "Moneda_Pac"])
    col_nominal       = get_col(df, ["Nominal_Pactado", "Nominal_Pac"])
    col_mon_rec       = get_col(df, ["Mon_Recibida_oper", "Mon_Recibida"])
    col_mon_ent       = get_col(df, ["Mon_Entregada_oper", "Mon_Entregada"])
    col_fecha_vcto    = get_col(df, ["Fec_vencimiento_oper", "Fecha_Vcto", "Fec_vencimie"])
    col_tc_pactado    = get_col(df, ["TC_Spot_Pactado", "TC_Spot_Pac"])
    col_vm_larga      = get_col(df, ["VM_Pos_larga", "VM_Pos_Larga"])
    col_vm_corta      = get_col(df, ["VM_Pos_corta", "VM_Pos_Corta"])

    print(f"\n  Columnas mapeadas:")
    print(f"    Compra/Venta : {col_compra_venta}")
    print(f"    Moneda Pac   : {col_moneda_pac}")
    print(f"    Nominal      : {col_nominal}")
    print(f"    Mon Recibida : {col_mon_rec}")
    print(f"    Mon Entregada: {col_mon_ent}")
    print(f"    Fecha Vcto   : {col_fecha_vcto}")
    print(f"    TC Pactado   : {col_tc_pactado}")
    print(f"    VM Larga     : {col_vm_larga}")
    print(f"    VM Corta     : {col_vm_corta}")

    registros = []
    sin_bucket = 0

    for _, row in df.iterrows():
        fecha_vcto = row.get(col_fecha_vcto) if col_fecha_vcto else None
        bucket     = asignar_bucket(fecha_vcto, buckets)

        if bucket is None:
            sin_bucket += 1
            continue

        compra_venta  = str(row.get(col_compra_venta, "")).strip() if col_compra_venta else ""
        moneda_pac    = str(row.get(col_moneda_pac,   "")).strip().upper() if col_moneda_pac else "USD"
        mon_rec       = str(row.get(col_mon_rec,      "")).strip().upper() if col_mon_rec else ""
        mon_ent       = str(row.get(col_mon_ent,      "")).strip().upper() if col_mon_ent else ""
        nominal       = pd.to_numeric(row.get(col_nominal),    errors='coerce') or 0
        tc_pactado    = pd.to_numeric(row.get(col_tc_pactado), errors='coerce') or TC.get(moneda_pac, 1.0)

        # VM en PEN desde Anexo 8 (ya vienen calculados)
        vm_larga_pen  = pd.to_numeric(row.get(col_vm_larga), errors='coerce') if col_vm_larga else 0
        vm_corta_pen  = pd.to_numeric(row.get(col_vm_corta), errors='coerce') if col_vm_corta else 0
        vm_larga_pen  = vm_larga_pen if pd.notna(vm_larga_pen) else 0
        vm_corta_pen  = vm_corta_pen if pd.notna(vm_corta_pen) else 0

        # Si no tenemos VM directamente, calculamos desde nominal
        tc_cierre = TC.get(moneda_pac, 1.0)
        if vm_larga_pen == 0 and nominal != 0:
            if "Compra" in compra_venta:
                # Forward compra: recibe USD (moneda extranjera), entrega PEN
                vm_larga_pen = nominal * tc_cierre          # USD → PEN a TC cierre
                vm_corta_pen = nominal * tc_pactado         # PEN a TC pactado
            else:
                # Forward venta: recibe PEN, entrega USD
                vm_larga_pen = nominal * tc_pactado         # PEN a TC pactado
                vm_corta_pen = nominal * tc_cierre          # USD → PEN a TC cierre

        residual = vm_larga_pen - vm_corta_pen

        # Montos en moneda original para Deriv Delivery
        if "Compra" in compra_venta:
            cap_rec_orig  = nominal                    # recibe moneda extranjera
            cap_pago_orig = nominal * tc_pactado       # entrega PEN
            mon_rec_final = moneda_pac
            mon_ent_final = "PEN"
        else:
            cap_rec_orig  = nominal * tc_pactado       # recibe PEN
            cap_pago_orig = nominal                    # entrega moneda extranjera
            mon_rec_final = "PEN"
            mon_ent_final = moneda_pac

        registros.append({
            "Compra_Venta":   compra_venta,
            "Moneda_Pactada": moneda_pac,
            "Mon_REC":        mon_rec if mon_rec else mon_rec_final,
            "Mon_PAGO":       mon_ent if mon_ent else mon_ent_final,
            "Nominal":        nominal,
            "TC_Pactado":     tc_pactado,
            "TC_Cierre":      tc_cierre,
            "Cap_REC_orig":   cap_rec_orig,
            "Cap_PAGO_orig":  cap_pago_orig,
            "VM_Larga_PEN":   vm_larga_pen,
            "VM_Corta_PEN":   vm_corta_pen,
            "Residual_PEN":   residual,
            "Fecha_Vcto":     parse_fecha(fecha_vcto),
            "Bucket":         bucket,
        })

    print(f"  Registros con bucket: {len(registros)}")
    print(f"  Registros sin bucket: {sin_bucket}")
    return pd.DataFrame(registros)

