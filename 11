def clasificar_tipo_producto(df: pd.DataFrame) -> pd.DataFrame:
    def tipo_producto(row):
        deal = str(row.get("Deal", "")).upper()
        currency = str(row.get("Currency", "")).upper()

        if deal.endswith("FXSPT"):
            return "CASH"
        if deal.startswith("CD"):
            return "CD"
        if deal.startswith("KONDORPERU.CCS"):
            return "CCS"
        if "KONDORPERU.FX" in deal:
            return "Forward"
        if "KONDORPERU.IRS" in deal:
            return "IRS_USD" if currency == "USD" else "IRS_PEN"
        if "KONDORPERU.SP" in deal:
            return "Spot"
        if deal.startswith("PERUGB"):
            return "SOBERANOS"
        if deal.startswith("PERU") and not deal.startswith("PERUGB"):
            return "Global"
        return "OTRO"

    df["Tipo de Producto"] = df.apply(tipo_producto, axis=1)

    # --- Revisión especial de Forwards con alguna pata en moneda distinta de USD/PEN ---
    es_forward = df["Tipo de Producto"] == "Forward"
    if es_forward.any():
        forwards = df.loc[es_forward].copy()
        forwards["Deal_base"] = forwards["Deal"].astype(str).str.upper().str.replace(
            r"_(PAY|REC)$", "", regex=True
        )
        forwards["Currency"] = forwards["Currency"].astype(str).str.upper()

        # True = alguna pata del deal no es USD ni PEN
        monedas_por_deal = forwards.groupby("Deal_base")["Currency"].apply(
            lambda monedas: not monedas.isin(["USD", "PEN"]).all()
        )

        deals_otra_moneda = monedas_por_deal[monedas_por_deal].index

        deal_base_full = df["Deal"].astype(str).str.upper().str.replace(
            r"_(PAY|REC)$", "", regex=True
        )
        mask_otra_moneda = es_forward & deal_base_full.isin(deals_otra_moneda)

        df.loc[mask_otra_moneda, "Tipo de Producto"] = "Forward Otra Moneda"

    cols = df.columns.tolist()
    cols.insert(1, cols.pop(cols.index("Tipo de Producto")))
    df = df[cols]

    return df


def cuarta_fecha_menor_total(path_csv):
    df = pd.read_csv(path_csv)
    patron_fecha = re.compile(r"\d{2}/\d{2}/\d{4}")
    columnas_fechas = [col for col in df.columns if patron_fecha.fullmatch(str(col))]

    if len(columnas_fechas) < 4:
        raise ValueError("No hay al menos 4 columnas de fechas")

    df[columnas_fechas] = df[columnas_fechas].apply(pd.to_numeric, errors="coerce")

    totales = df[columnas_fechas].sum()

    totales_ordenados = totales.sort_values()

    cuarta_fecha = totales_ordenados.index[3]

    return cuarta_fecha


