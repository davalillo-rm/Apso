import numpy as np, pandas as pd
from datetime import date, datetime, timedelta

rng = np.random.default_rng(42)
ini, fin = date(2026, 9, 1), date(2026, 11, 13)
feriados = {date(2026, 10, 8)}

def hab(d):
    return d.weekday() < 5 and d not in feriados

def sig_hab(d):
    while not hab(d):
        d += timedelta(1)
    return d

dias_h = [ini + timedelta(i) for i in range((fin - ini).days + 1)]
dias_h = [d for d in dias_h if hab(d)]

# proceso, area, frecuencia, tipo, hora deadline, maker, checker, inicio
P = [
    ("Reporte 6C", "Trading", "Diario", "Regulatorio", "11:00", "Rafaela", "J. Rodríguez", ini),
    ("Reporte 6", "Trading", "Diario", "Regulatorio", "11:00", "Rafaela", "J. Rodríguez", ini),
